				"type": "string",
				"title": "API key",
				"secret": true
			},
			"synthetic.limit": {
				"type": "integer",
				"title": "Limit",
				"default": 10
			},
			"synthetic.prompt": {
				"type": "string",
				"title": "Prompt",
				"format": "textarea"
			},
			"synthetic.color": {
				"type": "string",
				"title": "Color"
			},
			"synthetic.login": {
				"type": "oauth2",
				"title": "Sign in"
			},
			"synthetic.upload": {
				"type": "upload",
