				"type": "string",
				"title": "Password",
				"secret": true
			},
			"synthetic.token": {
				"type": "string",
				"title": "Token",
				"secret": true
			},
			"synthetic.retries": {
				"type": "integer",
				"title": "Retries",
				"default": 3
			},
			"synthetic.verbose": {
				"type": "boolean",
				"title": "Verbose",
				"default": false,
				"enum": [
					[
						true,
						"On"
					],
					[
						false,
						"Off"
					]
				]
			},
			"synthetic.logLevel": {
				"type": "string",
				"title": "Log level",
				"default": "info"
			}
		},
		"properties": [
			"synthetic.apikey",
			{
				"base": "synthetic.limit",
				"default": 25
			},
			"synthetic.prompt",
			"synthetic.color",
