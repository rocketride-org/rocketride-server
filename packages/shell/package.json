{
	"name": "shell",
	"version": "1.2.0",
	"private": true,
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./src/*": "./src/*",
		"./themes/rocketride-default.css": "./src/themes/rocketride-default.css"
	},
	"description": "RocketRide Shell \u2014 Module Federation host with dynamic app loading",
	"license": "MIT",
	"scripts": {
		"start": "pnpm rsbuild dev --env-mode development",
		"build": "pnpm rsbuild build --env-mode development",
		"build:prod": "pnpm rsbuild build --env-mode production"
	},
	"browserslist": [
		"chrome >= 81",
		"edge >= 83",
		"firefox >= 76",
		"safari >= 13"
	],
	"dependencies": {
		"@fontsource-variable/figtree": "^5.2.10",
		"@module-federation/runtime": "^2.5.1",
		"@stripe/react-stripe-js": "^3.1.0",
		"@stripe/stripe-js": "^5.5.0",
		"@types/react": "~18.3.31",
		"@types/react-dom": "~18.3.7",
		"@types/tabulator-tables": "~6.2.0",
		"allotment": "^1.20.5",
		"chart.js": "^4.4.0",
		"lucide-react": "^0.577.0",
		"react": "^18.2.0",
		"react-chartjs-2": "^5.2.0",
		"react-dom": "^18.2.0",
		"react-markdown": "^10.1.0",
		"react-syntax-highlighter": "^15.6.6",
		"rehype-raw": "^7.0.0",
		"rehype-sanitize": "^6.0.0",
		"remark-gfm": "^4.0.1",
		"rocketride": "workspace:*",
		"shaders": "2.5.109",
		"tabulator-tables": "~6.5.2"
	},
	"engines": {
		"node": ">=20.11.0"
	},
	"devDependencies": {
		"@module-federation/rsbuild-plugin": "^2.5.1",
		"@rsbuild/core": "~2.0.11",
		"@rsbuild/plugin-basic-ssl": "^1.2.3",
		"@rsbuild/plugin-react": "~2.0.1",
		"@rsbuild/plugin-type-check": "~1.3.5",
		"@types/node": "^20.19.41",
		"dts-bundle-generator": "^9.5.1",
		"esbuild": "^0.28.1",
		"tsx": "~4.23.1",
		"@types/react-syntax-highlighter": "^15.5.13"
	}
}
