{
	"name": "rocketride-chat-widget",
	"version": "1.3.0",
	"author": "RocketRide, Inc.",
	"license": "MIT",
	"description": "Embeddable, brandable chat widget for RocketRide pipelines — a framework-free web component plus a script-tag launcher bubble",
	"type": "commonjs",
	"main": "./dist/rocketride-chat.mjs",
	"module": "./dist/rocketride-chat.mjs",
	"types": "./dist/types/index.d.ts",
	"unpkg": "./dist/rocketride-chat.js",
	"jsdelivr": "./dist/rocketride-chat.js",
	"sideEffects": true,
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/rocketride-chat.mjs",
			"default": "./dist/rocketride-chat.mjs"
		},
		"./rocketride-chat.js": "./dist/rocketride-chat.js"
	},
	"files": [
		"dist/**/*",
		"README.md"
	],
	"scripts": {
		"build": "node esbuild.js --production && tsc -p tsconfig.types.json",
		"build:dev": "node esbuild.js && tsc -p tsconfig.types.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "jest",
		"test:coverage": "jest --coverage",
		"clean": "rimraf dist coverage"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/rocketride-org/rocketride-server.git",
		"directory": "packages/chat-widget"
	},
	"homepage": "https://rocketride.ai/",
	"bugs": {
		"url": "https://github.com/rocketride-org/rocketride-server/issues/"
	},
	"keywords": [
		"rocketride",
		"chat",
		"widget",
		"web-component",
		"embed",
		"chatbot"
	],
	"devDependencies": {
		"@jest/globals": "^30.4.1",
		"@types/jest": "^30.0.0",
		"@types/node": "^20.19.41",
		"esbuild": "^0.28.1",
		"jest": "^29.0.0",
		"jest-environment-jsdom": "^29.7.0",
		"jest-jasmine2": "^30.4.2",
		"rimraf": "^5.0.5",
		"rocketride": "workspace:*",
		"ts-jest": "^29.4.10",
		"typescript": "^5.0.0"
	}
}
