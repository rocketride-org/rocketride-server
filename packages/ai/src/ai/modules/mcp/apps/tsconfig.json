{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"lib": ["ES2022", "DOM"],
		"types": ["node", "vite/client"],
		"baseUrl": ".",
		"paths": {
			"shell": ["./src/trace-viewer/shell-shim.ts"],
