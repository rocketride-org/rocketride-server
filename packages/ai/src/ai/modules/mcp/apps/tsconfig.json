{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"resolveJsonModule": true,
		"lib": ["ES2022", "DOM"],
		"types": ["node", "vite/client"],
		"baseUrl": ".",
		"paths": {
			"shell": ["./src/shared/shell-shim.ts"],
			"shell/src/*": ["../../../../../../../apps/shared/node_modules/shell/src/*"],
			"rocketride": ["../../../../../../../packages/client-typescript/src/client/types/index.ts"],
			"@app-shared/*": ["../../../../../../../apps/shared/src/*"],
			"shared/*": ["../../../../../../../apps/shared/src/*"]
		}
	},
	"include": ["src", "resolve.ts", "vite.config.ts", "vitest.config.ts"]
}
