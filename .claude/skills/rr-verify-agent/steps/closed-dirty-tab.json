[
	{ "do": "engine", "args": ["write", "apps/verify-notes/package.json", "fixtures/package.json"], "label": "seed-manifest" },
	{ "do": "engine", "args": ["write", "apps/verify-notes/src/App.tsx", "fixtures/App.tsx"], "label": "seed" },
	{ "do": "open" },
	{ "do": "openFile", "path": "apps/verify-notes/src/App.tsx" },
	{ "do": "click", "css": ".monaco-editor .view-lines" },
	{ "do": "press", "key": "Control+End" },
	{ "do": "type", "value": "\n// RRVERIFY user edit, not saved" },
	{ "do": "shot", "label": "user-typed-unsaved" },
	{ "do": "click", "css": "div[draggable=\"true\"]:has(> span:text-is(\"App.tsx\")) > button", "label": "close-tab" },
	{ "do": "wait", "ms": 1000 },
	{ "do": "shot", "label": "tab-closed" },
	{ "do": "newSession" },
	{ "do": "send", "text": "Change the heading in apps/verify-notes/src/App.tsx to say \"Hello from the agent\". Keep everything else as it is.", "label": "turn1" },
	{ "do": "waitTurn", "answer": "Save mine first", "label": "turn1" },
	{ "do": "engine", "args": ["cat", "apps/verify-notes/src/App.tsx"], "label": "stored-after-turn" },
	{ "do": "openFile", "path": "apps/verify-notes/src/App.tsx" },
	{ "do": "wait", "ms": 2000 },
	{ "do": "shot", "label": "reopened" },
	{ "do": "click", "css": ".monaco-editor .view-lines" },
	{ "do": "press", "key": "Control+s" },
	{ "do": "wait", "ms": 2000 },
	{ "do": "shot", "label": "after-ctrl-s" },
	{ "do": "expectEngine", "args": ["cat", "apps/verify-notes/src/App.tsx"], "contains": "Hello from the agent", "label": "agent-edit-kept" },
	{ "do": "expectEngine", "args": ["cat", "apps/verify-notes/src/App.tsx"], "contains": "RRVERIFY user edit", "label": "user-edit-kept" }
]
