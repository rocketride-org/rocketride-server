{
  "components": [
    {
      "id": "discord_1",
      "provider": "discord",
      "name": "Discord Bot",
      "config": {
        "hideForm": true,
        "mode": "Source",
        "type": "discord",
        "parameters": {
          "botToken": "${ROCKETRIDE_DISCORD_DISCORD_BOT_TOKEN}",
          "guildIds": [
            "${ROCKETRIDE_DISCORD_GUILD_ID}"
          ],
          "channelIds": [
            "${ROCKETRIDE_DISCORD_SUPPORT_CHANNEL_ID}"
          ],
          "replyMode": "reply",
          "threadName": "{content}",
          "threadNameMaxLength": 90,
          "threadAutoArchiveMinutes": 1440,
          "requireMentionChannelIds": [],
          "allowedMentionRoleIds": [
            "${ROCKETRIDE_DISCORD_TEAM_ROLE_ID}"
          ],
          "allowedBotIds": [],
          "emitNoReply": true,
          "emitOutbound": true,
          "showTyping": true
        }
      },
      "ui": {
        "position": {
          "x": 20,
          "y": 200
        },
        "measured": {
          "width": 150,
          "height": 66
        },
        "nodeType": "default",
        "formDataValid": true
      }
    },
    {
      "id": "prompt_1",
      "provider": "prompt",
      "name": "Prompt",
      "config": {
        "instructions": [
          "You are a helpful assistant answering questions in a Discord channel.",
          "Answer briefly, in two or three sentences where you can. Do not invent facts you are unsure of."
        ],
        "parameters": {}
      },
      "input": [
        {
          "lane": "text",
          "from": "discord_1"
        }
      ],
      "ui": {
        "position": {
          "x": 240,
          "y": 200
        },
        "measured": {
          "width": 150,
          "height": 66
        },
        "nodeType": "default",
        "formDataValid": true
      }
    },
    {
      "id": "llm_openai_1",
      "provider": "llm_openai",
      "name": "OpenAI",
      "config": {
        "profile": "openai-5-2",
        "openai-5-2": {
          "apikey": "${ROCKETRIDE_OPENAI_KEY}"
        },
        "parameters": {}
      },
      "input": [
        {
          "lane": "questions",
          "from": "prompt_1"
        }
      ],
      "ui": {
        "position": {
          "x": 460,
          "y": 200
        },
        "measured": {
          "width": 150,
          "height": 66
        },
        "nodeType": "default",
        "formDataValid": true
      }
    },
    {
      "id": "response_answers_1",
      "provider": "response_answers",
      "name": "Return Answers",
      "config": {
        "laneName": "answers"
      },
      "input": [
        {
          "lane": "answers",
          "from": "llm_openai_1"
        }
      ],
      "ui": {
        "position": {
          "x": 680,
          "y": 200
        },
        "measured": {
          "width": 150,
          "height": 66
        },
        "nodeType": "default",
        "formDataValid": true
      }
    }
  ],
  "project_id": "8da4cdef-86de-40e5-9755-bfa8e13d9503",
  "viewport": {
    "x": 0,
    "y": 0,
    "zoom": 1
  },
  "version": 1
}