{
	//
	// Hack Judge account node (Blueprint Rev 2, section 03): resolves the
	// platform-provided marketplace identity to the app's tenant + tier.
	// classType "search" mirrors hackjudge_engine's proven lane-processor shape.
	//
	"title": "Hack Judge Account",
	"protocol": "hackjudge_account://",
	"classType": ["search"],
	"capabilities": ["invoke"],
	"register": "filter",
	"node": "python",
	"path": "nodes.hackjudge_account",
	"prefix": "hjaccount",
	"icon": "account.svg",
	"description": [
		"Marketplace identity resolver for Hack Judge: maps the platform session's org + user to the app tenant and tier.",
		"Input (questions): a JSON job {op, ...}. Output (answers): a JSON result {ok, ...}.",
		"Identity comes from the platform (manifest authenticated: true); no passwords or sessions live in the app."
	],
	"lanes": {
		"questions": ["questions", "answers", "text"]
	},
	"preconfig": {
		"default": "default",
		"profiles": {
			"default": {
				"database_url": ""
			}
		}
	},
	"fields": {
		"hackjudge_account.database_url": {
			"type": "string",
			"title": "Database URL",
			"description": "Postgres connection string. Blank falls back to HACKJUDGE_DATABASE_URL only; the node refuses to start without one.",
			"default": "",
			"secure": true,
			"ui": {
				"ui:widget": "ApiKeyWidget"
			}
		}
	},
	"shape": [
		{
			"section": "Pipe",
			"title": "Hack Judge Account",
			"properties": ["hackjudge_account.database_url"]
		}
	]
}
