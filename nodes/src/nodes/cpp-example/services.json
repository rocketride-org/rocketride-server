{
	//
	// Required:
	//		The displayable name of this node
	//
	"title": "C++ Example",
	//
	// Required:
	//		The protocol is the endpoint protocol
	//
	"protocol": "cpp_example://",
	//
	// Required:
	//		The physical type - "cpp" makes this a C++ node. The engine loads
	//		the shared library named by "path" and calls its initializeNode
	//		entry point, which registers the factories this protocol resolves
	//		to. Contrast "python", where the engine registers generic python
	//		factories on the node's behalf.
	//
	"node": "cpp",
	//
	// Required (for "node": "cpp"):
	//		Base name of the node's shared library, without the platform
	//		prefix or extension. Resolved against the node's own directory
	//		under the engine's nodes folder, so this becomes
	//		nodes/cpp-example/cppExample.dll on Windows and
	//		nodes/cpp-example/libcppExample.so elsewhere. Must match the
	//		target name passed to rocketride_add_node in CMakeLists.txt.
	//
	"path": "cppExample",
	//
	// Required:
	//		Class type of the node - what it does
	//
	"classType": ["data"],
	//
	// Required:
	//		Capabilities are flags that change the behavior of the underlying
	//		engine
	//
	"capabilities": [],
	//
	// Required:
	//		The prefix map when added/removed when convertting URLs <=> paths
	//
	"prefix": "CppExample",
	//
	// Optional:
	//		Description to of this driver
	//
	"description": ["A minimal C++ node. It counts the tags of every object that passes ", "through it and reports the total when the object closes, forwarding ", "everything downstream untouched. It exists as the reference for building ", "a node in C++ rather than python - see its doc.md for the anatomy."],
	//
	//
	//	Optional:
	//		As a pipe component, define what this pipe component takes
	//		and what it produces
	//
	"lanes": {
		"tags": ["tags"]
	},
	//
	//	Optional:
	//		Profile section are configuration optoins used by the driver
	//		itself
	//
	"preconfig": {
		"default": "default",
		"profiles": {
			"default": {}
		}
	},
	//
	// Optional:
	//		Local fields definitions - these define fields only for the
	//		current service. You may specify them here, or directly
	//		in the shape
	//
	"fields": {},
	//
	// Required:
	//		Defines the fields (shape) of the service. Either source or target
	//		map be specified, or both, but at least one is required
	//
	"shape": [
		{
			"section": "Pipe",
			"title": "C++ Example",
			"properties": []
		}
	]
}
