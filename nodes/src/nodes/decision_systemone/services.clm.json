{
	"title": "CLM (System One, self-hosted)",
	"protocol": "decision_clm://",
	"classType": [
		"decision"
	],
	"capabilities": [],
	"register": "filter",
	"node": "python",
	"path": "nodes.decision_systemone",
	"prefix": "decision",
	"description": [
		"Asks typed questions (yes/no, pick-one, rubric) about each item using a self-hosted clm-serve, in one call per item. ",
		"clm-serve truncates long states silently, so longer inputs are recorded too_long. ",
		"Answers are recorded on the object (response.decisions) for a Gate node to branch on; documents are forwarded with a decision reference, everything else unchanged."
	],
	"icon": "util-text.svg",
	"documentation": "https://docs.rocketride.org/nodes/decision_systemone",
	"tile": [
		"Model: ${parameters.decision_clm.profile}"
	],
	"lanes": {
		"text": ["text"],
		"documents": ["documents"],
		"table": ["table"],
		"questions": ["questions"],
		"answers": ["answers"]
	},
	"preconfig": {
		"default": "clm-latest",
		"profiles": {
			"clm-latest": {
				"title": "CLM (latest)",
				"model": "clm-latest",
				"serverbase": "http://127.0.0.1:8700",
				"apikey": "",
				"timeout": 60,
				"limits": {
					"max_options": 64,
					"max_levels": 26,
					"max_questions": 64,
					"max_state_tokens": 2000,
					"chars_per_token": 4,
					"object_criteria": false,
					"state_tokens_only": true
				}
			},
			"clm-raw": {
				"title": "CLM (raw)",
				"model": "clm-raw",
				"serverbase": "http://127.0.0.1:8700",
				"apikey": "",
				"timeout": 60,
				"limits": {
					"max_options": 64,
					"max_levels": 26,
					"max_questions": 64,
					"max_state_tokens": 2000,
					"chars_per_token": 4,
					"object_criteria": false,
					"state_tokens_only": true
				}
			},
			"custom": {
				"title": "Custom",
				"model": "",
				"serverbase": "http://127.0.0.1:8700",
				"apikey": "",
				"timeout": 60,
				"limits": {
					"max_options": 64,
					"max_levels": 26,
					"max_questions": 64,
					"max_state_tokens": 2000,
					"chars_per_token": 4,
					"object_criteria": false,
					"state_tokens_only": true
				}
			}
		}
	},
	"fields": {
		"decision.model": {
			"type": "string",
			"title": "Model",
			"description": "Model name as served by the backend"
		},
		"decision.serverbase": {
			"type": "string",
			"title": "Server URL",
			"description": "Base URL; /v1/systemone is appended"
		},
		"decision.name": {
			"type": "string",
			"title": "Name",
			"description": "Question name; the Gate refers to it (lowercase, digits, _)"
		},
		"decision.question": {
			"type": "string",
			"title": "Question",
			"description": "Phrase it so a high value means yes"
		},
		"decision.yes_means": {
			"type": "string",
			"title": "Yes means",
			"optional": true
		},
		"decision.no_means": {
			"type": "string",
			"title": "No means",
			"optional": true
		},
		"decision.threshold": {
			"type": "number",
			"title": "Yes threshold",
			"default": 0.5,
			"minimum": 0.01,
			"maximum": 0.99
		},
		"decision.min_confidence": {
			"type": "number",
			"title": "Minimum confidence",
			"default": 0,
			"minimum": 0,
			"maximum": 1,
			"description": "Below this the answer is 'uncertain'. Confidence is not comparable across backends."
		},
		"decision.options": {
			"type": "string",
			"title": "Options",
			"ui": {
				"ui:widget": "textarea"
			},
			"description": "One per line: value | optional description"
		},
		"decision.levels": {
			"type": "string",
			"title": "Levels",
			"ui": {
				"ui:widget": "textarea"
			},
			"description": "One per line, level 0 first; describe the situation, not a degree"
		},
		"decision.yes_no": {
			"type": "array",
			"title": "Yes/No questions",
			"optional": true,
			"items": {
				"type": "object",
				"properties": [
					"decision.name",
					"decision.question",
					"decision.yes_means",
					"decision.no_means",
					"decision.threshold",
					"decision.min_confidence"
				]
			}
		},
		"decision.pick_one": {
			"type": "array",
			"title": "Pick-one questions",
			"optional": true,
			"items": {
				"type": "object",
				"properties": [
					"decision.name",
					"decision.question",
					"decision.options",
					"decision.min_confidence"
				]
			}
		},
		"decision.rubric": {
			"type": "array",
			"title": "Rubric questions",
			"optional": true,
			"items": {
				"type": "object",
				"properties": [
					"decision.name",
					"decision.question",
					"decision.levels",
					"decision.min_confidence"
				]
			}
		},
		"decision.state_metadata": {
			"type": "string",
			"title": "Metadata to include",
			"optional": true,
			"ui": {
				"ui:widget": "textarea"
			},
			"description": "Metadata keys (one per line) sent alongside the content, e.g. parent"
		},
		"decision.apikey": {
			"type": "string",
			"title": "API Key (only if clm-serve sets CLM_API_KEY)",
			"default": "",
			"secure": true,
			"ui": {
				"ui:widget": "ApiKeyWidget"
			},
			"optional": true
		},
		"decision_clm.clm-latest": {
			"object": "clm-latest",
			"properties": [
				"decision.serverbase"
			]
		},
		"decision_clm.clm-raw": {
			"object": "clm-raw",
			"properties": [
				"decision.serverbase"
			]
		},
		"decision_clm.custom": {
			"object": "custom",
			"properties": [
				"decision.model",
				"decision.serverbase"
			]
		},
		"decision_clm.profile": {
			"title": "Model",
			"type": "string",
			"default": "clm-latest",
			"enum": [
				"*>preconfig.profiles.*.title"
			],
			"conditional": [
				{
					"value": "clm-latest",
					"properties": [
						"decision_clm.clm-latest"
					]
				},
				{
					"value": "clm-raw",
					"properties": [
						"decision_clm.clm-raw"
					]
				},
				{
					"value": "custom",
					"properties": [
						"decision_clm.custom"
					]
				}
			]
		}
	},
	"shape": [
		{
			"section": "Pipe",
			"title": "System One (CLM)",
			"properties": [
				"decision.apikey",
				"decision_clm.profile",
				"decision.yes_no",
				"decision.pick_one",
				"decision.rubric",
				"decision.state_metadata"
			]
		}
	]
}
