{
	"title": "Superagent Security-One (System One)",
	"protocol": "decision_superagent://",
	"classType": [
		"decision"
	],
	"capabilities": [],
	"register": "filter",
	"node": "python",
	"path": "nodes.decision_systemone",
	"prefix": "decision",
	"description": [
		"Asks typed questions about each item using Superagent Security-One, in one call per item. ",
		"Security-One is a security triage model (prompt injection and similar); not a general classifier. ",
		"Answers are recorded on the object (response.decisions) for a Gate node to branch on; documents are forwarded with a decision reference, everything else unchanged."
	],
	"icon": "util-text.svg",
	"documentation": "https://docs.rocketride.org/nodes/decision_systemone",
	"tile": [
		"Model: ${parameters.decision_superagent.profile}"
	],
	"lanes": {
		"text": ["text"],
		"documents": ["documents"],
		"table": ["table"],
		"questions": ["questions"],
		"answers": ["answers"]
	},
	"preconfig": {
		"default": "security-one",
		"profiles": {
			"security-one": {
				"title": "Security-One",
				"model": "security-one",
				"serverbase": "https://api.superagent.sh",
				"apikey": "",
				"limits": {
					"max_options": 16,
					"max_levels": 16,
					"max_questions": 64,
					"max_state_tokens": 60000,
					"chars_per_token": 4,
					"max_body_bytes": 1048576,
					"object_criteria": false
				}
			}
		}
	},
	"fields": {
		"decision.model": {
			"type": "string",
			"title": "Model",
			"description": "Model name as served by the backend"
		},
		"decision.serverbase": {
			"type": "string",
			"title": "Server URL",
			"description": "Base URL; /v1/systemone is appended"
		},
		"decision.name": {
			"type": "string",
			"title": "Name",
			"description": "Question name; the Gate refers to it (lowercase, digits, _)"
		},
		"decision.question": {
			"type": "string",
			"title": "Question",
			"description": "Phrase it so a high value means yes"
		},
		"decision.yes_means": {
			"type": "string",
			"title": "Yes means",
			"optional": true
		},
		"decision.no_means": {
			"type": "string",
			"title": "No means",
			"optional": true
		},
		"decision.threshold": {
			"type": "number",
			"title": "Yes threshold",
			"default": 0.5,
			"minimum": 0.01,
			"maximum": 0.99
		},
		"decision.min_confidence": {
			"type": "number",
			"title": "Minimum confidence",
			"default": 0,
			"minimum": 0,
			"maximum": 1,
			"description": "Below this the answer is 'uncertain'. Confidence is not comparable across backends."
		},
		"decision.options": {
			"type": "string",
			"title": "Options",
			"ui": {
				"ui:widget": "textarea"
			},
			"description": "One per line: value | optional description"
		},
		"decision.levels": {
			"type": "string",
			"title": "Levels",
			"ui": {
				"ui:widget": "textarea"
			},
			"description": "One per line, level 0 first; describe the situation, not a degree"
		},
		"decision.yes_no": {
			"type": "array",
			"title": "Yes/No questions",
			"optional": true,
			"items": {
				"type": "object",
				"properties": [
					"decision.name",
					"decision.question",
					"decision.yes_means",
					"decision.no_means",
					"decision.threshold",
					"decision.min_confidence"
				]
			}
		},
		"decision.pick_one": {
			"type": "array",
			"title": "Pick-one questions",
			"optional": true,
			"items": {
				"type": "object",
				"properties": [
					"decision.name",
					"decision.question",
					"decision.options",
					"decision.min_confidence"
				]
			}
		},
		"decision.rubric": {
			"type": "array",
			"title": "Rubric questions",
			"optional": true,
			"items": {
				"type": "object",
				"properties": [
					"decision.name",
					"decision.question",
					"decision.levels",
					"decision.min_confidence"
				]
			}
		},
		"decision.state_metadata": {
			"type": "string",
			"title": "Metadata to include",
			"optional": true,
			"ui": {
				"ui:widget": "textarea"
			},
			"description": "Metadata keys (one per line) sent alongside the content, e.g. parent"
		},
		"decision.apikey": {
			"type": "string",
			"title": "API Key",
			"default": "",
			"secure": true,
			"ui": {
				"ui:widget": "ApiKeyWidget"
			}
		},
		"decision_superagent.security-one": {
			"object": "security-one",
			"properties": []
		},
		"decision_superagent.profile": {
			"title": "Model",
			"type": "string",
			"default": "security-one",
			"enum": [
				"*>preconfig.profiles.*.title"
			],
			"conditional": [
				{
					"value": "security-one",
					"properties": [
						"decision_superagent.security-one"
					]
				}
			]
		}
	},
	"shape": [
		{
			"section": "Pipe",
			"title": "System One (Superagent Security-One)",
			"properties": [
				"decision.apikey",
				"decision_superagent.profile",
				"decision.yes_no",
				"decision.pick_one",
				"decision.rubric",
				"decision.state_metadata"
			]
		}
	]
}
