{
	"title": "Laya Studio (System One)",
	"protocol": "decision_laya://",
	"classType": [
		"decision"
	],
	"capabilities": [],
	"register": "filter",
	"node": "python",
	"path": "nodes.decision_systemone",
	"prefix": "decision",
	"description": [
		"Asks typed questions (yes/no, pick-one, rubric) about each item using Laya Studio, in one call per item. ",
		"Laya reads only the first 512/1,024 tokens of state, so longer inputs are recorded too_long. ",
		"Answers are recorded on the object (response.decisions) for a Gate node to branch on; documents are forwarded with a decision reference, everything else unchanged."
	],
	"icon": "util-text.svg",
	"documentation": "https://docs.rocketride.org/nodes/decision_systemone",
	"tile": [
		"Model: ${parameters.decision_laya.profile}"
	],
	"lanes": {
		"text": ["text"],
		"documents": ["documents"],
		"table": ["table"],
		"questions": ["questions"],
		"answers": ["answers"],
		"json": ["json"]
	},
	"preconfig": {
		"default": "english",
		"profiles": {
			"english": {
				"title": "English",
				"model": "english",
				"serverbase": "https://api.laya.studio",
				"apikey": "",
				"limits": {
					"max_options": 20,
					"max_levels": 20,
					"max_questions": 32,
					"max_state_tokens": 450,
					"chars_per_token": 4,
					"max_body_bytes": 524288,
					"object_criteria": false,
					"state_tokens_only": true
				}
			},
			"multilingual": {
				"title": "Multilingual",
				"model": "multilingual",
				"serverbase": "https://api.laya.studio",
				"apikey": "",
				"limits": {
					"max_options": 20,
					"max_levels": 20,
					"max_questions": 32,
					"max_state_tokens": 950,
					"chars_per_token": 3,
					"max_body_bytes": 524288,
					"object_criteria": false,
					"state_tokens_only": true
				}
			},
			"typed-decisions": {
				"title": "Typed decisions",
				"model": "typed-decisions",
				"serverbase": "https://api.laya.studio",
				"apikey": "",
				"limits": {
					"max_options": 20,
					"max_levels": 20,
					"max_questions": 32,
					"max_state_tokens": 950,
					"chars_per_token": 3,
					"max_body_bytes": 524288,
					"object_criteria": false,
					"state_tokens_only": true
				}
			}
		}
	},
	"fields": {
		"decision.model": {
			"type": "string",
			"title": "Model",
			"description": "Model name as served by the backend"
		},
		"decision.serverbase": {
			"type": "string",
			"title": "Server URL",
			"description": "Base URL; /v1/systemone is appended"
		},
		"decision.name": {
			"type": "string",
			"title": "Name",
			"description": "Question name; the Gate refers to it (lowercase, digits, _)"
		},
		"decision.question": {
			"type": "string",
			"title": "Question",
			"description": "Phrase it so a high value means yes"
		},
		"decision.yes_means": {
			"type": "string",
			"title": "Yes means",
			"optional": true
		},
		"decision.no_means": {
			"type": "string",
			"title": "No means",
			"optional": true
		},
		"decision.threshold": {
			"type": "number",
			"title": "Yes threshold",
			"default": 0.5,
			"minimum": 0.01,
			"maximum": 0.99
		},
		"decision.min_confidence": {
			"type": "number",
			"title": "Minimum confidence",
			"default": 0,
			"minimum": 0,
			"maximum": 1,
			"description": "Below this the answer is 'uncertain'. Confidence is not comparable across backends."
		},
		"decision.options": {
			"type": "string",
			"title": "Options",
			"ui": {
				"ui:widget": "textarea"
			},
			"description": "One per line: value | optional description"
		},
		"decision.levels": {
			"type": "string",
			"title": "Levels",
			"ui": {
				"ui:widget": "textarea"
			},
			"description": "One per line, level 0 first; describe the situation, not a degree"
		},
		"decision.yes_no": {
			"type": "array",
			"title": "Yes/No questions",
			"optional": true,
			"items": {
				"type": "object",
				"properties": [
					"decision.name",
					"decision.question",
					"decision.yes_means",
					"decision.no_means",
					"decision.threshold",
					"decision.min_confidence"
				]
			}
		},
		"decision.pick_one": {
			"type": "array",
			"title": "Pick-one questions",
			"optional": true,
			"items": {
				"type": "object",
				"properties": [
					"decision.name",
					"decision.question",
					"decision.options",
					"decision.min_confidence"
				]
			}
		},
		"decision.rubric": {
			"type": "array",
			"title": "Rubric questions",
			"optional": true,
			"items": {
				"type": "object",
				"properties": [
					"decision.name",
					"decision.question",
					"decision.levels",
					"decision.min_confidence"
				]
			}
		},
		"decision.state_metadata": {
			"type": "string",
			"title": "Metadata to include",
			"optional": true,
			"ui": {
				"ui:widget": "textarea"
			},
			"description": "Metadata keys (one per line) sent alongside the content, e.g. parent"
		},
		"decision.apikey": {
			"type": "string",
			"title": "API Key",
			"default": "",
			"secure": true,
			"ui": {
				"ui:widget": "ApiKeyWidget"
			}
		},
		"decision_laya.english": {
			"object": "english",
			"properties": []
		},
		"decision_laya.multilingual": {
			"object": "multilingual",
			"properties": []
		},
		"decision_laya.typed-decisions": {
			"object": "typed-decisions",
			"properties": []
		},
		"decision_laya.profile": {
			"title": "Model",
			"type": "string",
			"default": "english",
			"enum": [
				"*>preconfig.profiles.*.title"
			],
			"conditional": [
				{
					"value": "english",
					"properties": [
						"decision_laya.english"
					]
				},
				{
					"value": "multilingual",
					"properties": [
						"decision_laya.multilingual"
					]
				},
				{
					"value": "typed-decisions",
					"properties": [
						"decision_laya.typed-decisions"
					]
				}
			]
		}
	},
	"shape": [
		{
			"section": "Pipe",
			"title": "System One (Laya Studio)",
			"properties": [
				"decision.apikey",
				"decision_laya.profile",
				"decision.yes_no",
				"decision.pick_one",
				"decision.rubric",
				"decision.state_metadata"
			]
		}
	]
}
