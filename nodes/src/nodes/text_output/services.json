{
	//
	// Required:
	//		The displayable name of this node
	//
	"title": "Text Output",
	//
	// Required:
	//     The protocol is the endpoint protocol
	//
	"protocol": "text-output://",
	//
	// Required:
	//		Class type of the node - what it does
	//
	"classType": ["target"],
	//
	// Required:
	//     Capabilities are flags that change the behavior of the underlying
	//     engine
	//
	"capabilities": ["network", "noremote", "nosaas"],
	//
	// Optional:
	//     The node is the actual physical node to instantiate - if
	//     not specified, the protocol will be used
	//
	"node": "python",
	//
	// Optional:
	//     The path is the executable/script code - it is node dependent
	//     and is optional for most node
	//
	"path": "nodes.text_output",
	//
	// Required:
	//     The prefix map when added/removed when convertting URLs <=> paths
	//
	"prefix": "Text Output",
	//
	// Optional:
	//		Description to of this driver
	//
	"description": ["A target component that writes data to the file system. It supports ", "outputting structured or unstructured content to files in a variety ", "of formats such as JSON, CSV, or plain text. Configurable with output ", "paths and naming conventions, the component enables flexible persistence ", "of processed data to networked storage."],
	//
	// Optional:
	//	  The icon is the icon to display in the UI for this node
	//
	"icon": "text-output.svg",
	"documentation": "https://docs.rocketride.org/nodes/text_output",
	//
	//
	//	Optional:
	//		As a pipe component, define what this pipe component takes
	//		and what it produces
	//
	"lanes": {
		"text": []
	},
	//
	// Optional:
	//     Local property definitions. The SMB share settings live in the
	//     "parameters" group, which is where IEndpoint reads them; the
	//     password is a secret the account variable supplies.
	//
	"propertyDefinitions": {
		"text_output.server": {
			"type": "string",
			"title": "Server Name",
			"description": "Host name or IP address of the SMB server hosting the share, e.g. files.example.com or 10.0.0.12."
		},
		"text_output.username": {
			"type": "string",
			"title": "User Name",
			"description": "User name used to authenticate against the SMB share. Leave the user name and password empty to connect with the engine's own credentials.",
			"optional": true
		},
		"text_output.password": {
			"type": "string",
			"title": "Password",
			"description": "Password for the SMB user name above.",
			"secret": true,
			"env": "ROCKETRIDE_TEXT_OUTPUT_PASSWORD",
			"optional": true,
			"maxLength": 127
		}
	},
	//
	// Required:
	//     Defines the properties shown in the pipeline builder side panel, in order
	//
	"properties": [
		"type",
		{
			"name": "parameters",
			"properties": [
				"storePath",
				"text_output.server",
				"text_output.username",
				"text_output.password",
				{
					"base": "anonymize",
					"hidden": false
				}
			]
		},
		"target.mode"
	]
}
