{
	//
	// Required:
	//		The displayable name of this node
	//
	"title": "Atlas Cloud",
	//
	// Required:
	//		The protocol is the endpoint protocol
	//
	"protocol": "llm_atlascloud://",
	//
	// Required:
	//		Class type of the node - what it does
	//
	"classType": ["llm"],
	//
	// Required:
	//		Capabilities are flags that change the behavior of the underlying engine
	//
	"capabilities": ["invoke"],
	//
	// Optional:
	//		Register is either filter, endpoint or ignored if not specified
	//
	"register": "filter",
	//
	// Optional:
	//		The node is the actual physical node to instantiate
	//
	"node": "python",
	//
	// Optional:
	//		Reuses the generic OpenAI-compatible client, this is a branded preset,
	//		not a separate node (no duplicated Python).
	//
	"path": "nodes.llm_openai_api",
	//
	// Required:
	//		The prefix map when added/removed when converting URLs <=> paths
	//
	"prefix": "llm",
	//
	// Optional:
	//		Description of this driver shown in the pipeline builder
	//
	"description": ["Connects to Atlas Cloud's OpenAI-compatible inference API.", "Serves open-weight models (DeepSeek, GLM, Kimi, Qwen, MiniMax) alongside proxied vendor models for reasoning, generation, and tool-calling. This is a branded preset of the generic OpenAI-Compatible API node, so it shares the same implementation; the base URL is pinned to Atlas Cloud."],
	//
	// Optional:
	//		The icon to display in the UI for this node
	//
	"icon": "atlascloud.svg",
	"documentation": "https://docs.rocketride.org/nodes/llm_openai_api",
	//
	// Optional:
	//		Rendering hints to the UI which indicate which config fields to surface
	//		on the node tile
	//
	"tile": ["Model: ${parameters.llm_openai_api.profile}"],
	//
	// Optional:
	//		As a pipe component, define what this pipe component takes and produces
	//
	"lanes": {
		"questions": ["answers"]
	},
	//
	// Optional:
	//		Profile section - configuration options used by the driver itself.
	//		Each preset pins the Atlas Cloud base_url and a model id, and defaults
	//		the API key to the ${ROCKETRIDE_ATLASCLOUD_KEY} env substitution
	//		(no per-node os.environ lookup needed).
	//
	"preconfig": {
		"default": "deepseek-v4-flash",
		"profiles": {
			"deepseek-v4-flash": {
				"title": "DeepSeek V4 Flash",
				"model": "deepseek-ai/deepseek-v4-flash",
				"modelSource": "provider",
				"base_url": "https://api.atlascloud.ai/v1/",
				"modelTotalTokens": 1048576,
				"modelOutputTokens": 4096,
				"apikey": "${ROCKETRIDE_ATLASCLOUD_KEY}",
				"capabilities": {
					"reasoning": true
				}
			},
			"glm-5-3-flash": {
				"title": "GLM-5.3 Flash",
				"model": "zai-org/glm-5.3-flash",
				"modelSource": "provider",
				"base_url": "https://api.atlascloud.ai/v1/",
				"modelTotalTokens": 1048576,
				"modelOutputTokens": 4096,
				"apikey": "${ROCKETRIDE_ATLASCLOUD_KEY}",
				"capabilities": {
					"reasoning": true
				}
			},
			"custom": {
				"model": "",
				"base_url": "https://api.atlascloud.ai/v1/",
				"modelTotalTokens": 131072,
				"apikey": "${ROCKETRIDE_ATLASCLOUD_KEY}"
			}
		}
	},
	//
	// Optional:
	//		Local field definitions - these define fields only for the current
	//		service. Reuse the underlying llm_openai_api config namespace.
	//
	"fields": {
		"model": {
			"type": "string",
			"title": "Model",
			"description": "Atlas Cloud model id (e.g. deepseek-ai/deepseek-v4-flash). Full list: https://api.atlascloud.ai/v1/models"
		},
		"base_url": {
			"type": "string",
			"title": "Base URL",
			"description": "OpenAI-compatible base URL. Defaults to Atlas Cloud."
		},
		"modelTotalTokens": {
			"type": "number",
			"title": "Tokens",
			"description": "Total Tokens"
		},
		"modelOutputTokens": {
			"type": "integer",
			"title": "Output Tokens",
			"description": "Most tokens the model may write in one reply (at least 1,024). Leave it empty to keep the node's default. Reasoning models count their thinking against this limit: set it well above the reply you expect, or they can spend it all thinking and return nothing. It cannot exceed Tokens; a larger value is lowered to it.",
			"minimum": 1024,
			"optional": true
		},
		"openai_api.deepseek-v4-flash": {
			"object": "deepseek-v4-flash",
			"properties": ["llm.cloud.apikey"]
		},
		"openai_api.glm-5-3-flash": {
			"object": "glm-5-3-flash",
			"properties": ["llm.cloud.apikey"]
		},
		"openai_api.custom": {
			"object": "custom",
			"properties": ["model", "base_url", "modelTotalTokens", "modelOutputTokens", "llm.cloud.apikey", "llm.cloud.modelSource"]
		},
		"openai_api.profile": {
			"title": "Model",
			"description": "Atlas Cloud model",
			"type": "string",
			"default": "deepseek-v4-flash",
			"enum": ["*>preconfig.profiles.*.title"],
			"conditional": [
				{
					"value": "deepseek-v4-flash",
					"properties": ["openai_api.deepseek-v4-flash"]
				},
				{
					"value": "glm-5-3-flash",
					"properties": ["openai_api.glm-5-3-flash"]
				},
				{
					"value": "custom",
					"properties": ["openai_api.custom"]
				}
			]
		}
	},
	//
	// Required:
	//		Defines the fields (shape) shown in the pipeline builder side panel
	//
	"shape": [
		{
			"section": "Pipe",
			"title": "Atlas Cloud",
			"properties": ["openai_api.profile"]
		}
	]
}
