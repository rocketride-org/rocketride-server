{
	"title": "OCR",
	"protocol": "ocr://",
	"classType": ["image"],
	"capabilities": ["gpu"],
	"register": "filter",
	"node": "python",
	"path": "nodes.ocr",
	"prefix": "ocr",
	"description": [
		"A component that extracts machine-readable text from images and scanned documents ",
		"using optical character recognition. It enables the transformation of visual content (such ",
		"as PDFs, screenshots, and photos) into structured text for further analysis and processing. ",
		"Supporting various image formats and multilingual text, the component is ideal for digitizing ",
		"printed materials, enabling search, indexing, and downstream natural language tasks."
	],
	"icon": "ocr.svg",
	"documentation": "https://docs.rocketride.org/nodes/ocr",
	"tile": [],
	"lanes": {
		"documents": ["text"],
		"image": ["text", "table"]
	},
	//
	// Optional:
	//		Local property definitions. The profile is the selector: each profile
	//		aliases the engine, script family and table engine with its own
	//		defaults, so a profile is a starting point the user may still adjust.
	//		The DocTR architectures and the TrOCR model are shared and stored flat.
	//
	"propertyDefinitions": {
		"ocr.engine": {
			"type": "string",
			"title": "OCR Engine",
			"description": "Select the OCR engine for text extraction. EasyOCR supports many languages with script families. DocTR is language-agnostic and good for documents. Surya supports multi-language. TrOCR uses transformer models.",
			"default": "easyocr",
			"enum": [
				["easyocr", "EasyOCR (Multi-language)"],
				["doctr", "DocTR (Document-focused)"],
				["surya", "Surya (Multi-language)"],
				["trocr", "TrOCR (Transformer)"]
			]
		},
		"ocr.script_family": {
			"type": "string",
			"title": "Script Family",
			"description": "Select the script family for OCR. This determines which languages are loaded for text recognition. Only applies to EasyOCR engine.",
			"default": "latin",
			"enum": [
				["latin", "Latin (English only)"],
				["latin-extended", "Latin Extended (European languages)"],
				["cyrillic", "Cyrillic (Russian, Ukrainian, etc.)"],
				["arabic", "Arabic/Persian/Urdu"],
				["devanagari", "Devanagari (Hindi, Marathi, Nepali)"],
				["bengali", "Bengali/Assamese"],
				["chinese-simplified", "Chinese (Simplified)"],
				["chinese-traditional", "Chinese (Traditional)"],
				["japanese", "Japanese"],
				["korean", "Korean"],
				["thai", "Thai"],
				["tamil", "Tamil"],
				["telugu", "Telugu"]
			]
		},
		"ocr.table_engine": {
			"type": "string",
			"title": "Table OCR Engine",
			"description": "Select the OCR engine used for table text extraction. DocTR is optimized for document tables. EasyOCR and Surya are general-purpose alternatives.",
			"default": "doctr",
			"enum": [
				["doctr", "DocTR (Document-focused)"],
				["easyocr", "EasyOCR"],
				["surya", "Surya"]
			]
		},
		"ocr.det_arch": {
			"type": "string",
			"title": "Detection Architecture (DocTR)",
			"description": "Choose the architecture used for table text detection. Documentation: https://mindee.github.io/doctr/latest/using_doctr/using_models.html",
			"default": "db_resnet50",
			"enum": [
				"linknet_resnet18",
				"linknet_resnet34",
				"linknet_resnet50",
				"db_resnet50",
				"db_mobilenet_v3_large",
				"fast_tiny",
				"fast_small",
				"fast_base"
			]
		},
		"ocr.reco_arch": {
			"type": "string",
			"title": "Recognition Architecture (DocTR)",
			"description": "Choose the architecture used for table text recognition. Documentation: https://mindee.github.io/doctr/latest/using_doctr/using_models.html",
			"default": "crnn_vgg16_bn",
			"enum": [
				"crnn_vgg16_bn",
				"crnn_mobilenet_v3_small",
				"crnn_mobilenet_v3_large",
				"sar_resnet31",
				"master",
				"vitstr_small",
				"vitstr_base",
				"parseq"
			]
		},
		"ocr.trocr_model": {
			"type": "string",
			"title": "TrOCR model",
			"description": "HuggingFace TrOCR model used when the engine is TrOCR.",
			"default": "microsoft/trocr-base-printed",
			"minLength": 1
		}
	},
	//
	// Required:
	//		Defines the properties shown in the pipeline builder side panel, in order
	//
	"properties": [
		{
			"name": "profile",
			"type": "string",
			"title": "OCR Profile",
			"description": "A combination of engine, script family and table engine tuned for a language or use case; each may be adjusted.",
			"default": "latin",
			"enum": {
				"latin": {
					"title": "Latin (English)",
					"properties": [
						{ "base": "ocr.engine", "default": "easyocr" },
						{ "base": "ocr.script_family", "default": "latin" },
						{ "base": "ocr.table_engine", "default": "doctr" }
					]
				},
				"latin-extended": {
					"title": "Latin Extended (European)",
					"properties": [
						{ "base": "ocr.engine", "default": "easyocr" },
						{ "base": "ocr.script_family", "default": "latin-extended" },
						{ "base": "ocr.table_engine", "default": "doctr" }
					]
				},
				"cyrillic": {
					"title": "Cyrillic (Russian, etc.)",
					"properties": [
						{ "base": "ocr.engine", "default": "easyocr" },
						{ "base": "ocr.script_family", "default": "cyrillic" },
						{ "base": "ocr.table_engine", "default": "doctr" }
					]
				},
				"arabic": {
					"title": "Arabic/Persian/Urdu",
					"properties": [
						{ "base": "ocr.engine", "default": "easyocr" },
						{ "base": "ocr.script_family", "default": "arabic" },
						{ "base": "ocr.table_engine", "default": "doctr" }
					]
				},
				"devanagari": {
					"title": "Devanagari (Hindi, etc.)",
					"properties": [
						{ "base": "ocr.engine", "default": "easyocr" },
						{ "base": "ocr.script_family", "default": "devanagari" },
						{ "base": "ocr.table_engine", "default": "doctr" }
					]
				},
				"chinese-simplified": {
					"title": "Chinese (Simplified)",
					"properties": [
						{ "base": "ocr.engine", "default": "easyocr" },
						{ "base": "ocr.script_family", "default": "chinese-simplified" },
						{ "base": "ocr.table_engine", "default": "doctr" }
					]
				},
				"chinese-traditional": {
					"title": "Chinese (Traditional)",
					"properties": [
						{ "base": "ocr.engine", "default": "easyocr" },
						{ "base": "ocr.script_family", "default": "chinese-traditional" },
						{ "base": "ocr.table_engine", "default": "doctr" }
					]
				},
				"japanese": {
					"title": "Japanese",
					"properties": [
						{ "base": "ocr.engine", "default": "easyocr" },
						{ "base": "ocr.script_family", "default": "japanese" },
						{ "base": "ocr.table_engine", "default": "doctr" }
					]
				},
				"korean": {
					"title": "Korean",
					"properties": [
						{ "base": "ocr.engine", "default": "easyocr" },
						{ "base": "ocr.script_family", "default": "korean" },
						{ "base": "ocr.table_engine", "default": "doctr" }
					]
				},
				"doctr": {
					"title": "DocTR (Language-agnostic)",
					"properties": [
						{ "base": "ocr.engine", "default": "doctr" },
						{ "base": "ocr.script_family", "default": "latin" },
						{ "base": "ocr.table_engine", "default": "doctr" }
					]
				},
				"surya": {
					"title": "Surya (Multi-language)",
					"properties": [
						{ "base": "ocr.engine", "default": "surya" },
						{ "base": "ocr.script_family", "default": "latin" },
						{ "base": "ocr.table_engine", "default": "surya" }
					]
				},
				"trocr": {
					"title": "TrOCR (Transformer)",
					"properties": [
						{ "base": "ocr.engine", "default": "trocr" },
						{ "base": "ocr.script_family", "default": "latin" },
						{ "base": "ocr.table_engine", "default": "doctr" }
					]
				}
			}
		},
		"ocr.det_arch",
		"ocr.reco_arch",
		"ocr.trocr_model"
	],
	//
	// Optional:
	//		Test configuration for automated node testing. "profiles" lists values
	//		of the root selector; the framework writes the selected one at its path.
	//
	"test": {
		"profiles": ["latin"],
		"requiresHardware": {
			"cuda": { "vramGb": 3 },
			"mps": { "ramGb": 6 },
			"cpu": { "ramGb": 6 }
		},
		"outputs": ["text", "table"],
		"timeout": 120,
		"cases": [
			{
				"name": "Extract text from plain text image",
				"image": "images/ocr_test_text.png",
				"expect": {
					"text": { "notEmpty": true, "contains": "quick brown fox" }
				}
			},
			{
				"name": "Extract table from table image",
				"image": "images/ocr_test_table.png",
				"expect": {
					"text": { "notEmpty": true },
					"table": { "notEmpty": true, "contains": "Alice" }
				}
			},
			{
				"name": "Extract text and table from mixed image",
				"image": "images/ocr_test_mixed.png",
				"expect": {
					"text": { "notEmpty": true, "contains": "Sales Report" },
					"table": { "notEmpty": true, "contains": "Widget" }
				}
			}
		]
	},
	"fulltest": [
		{
			"profiles": [
				"latin",
				"latin-extended",
				"cyrillic",
				"arabic",
				"devanagari",
				"chinese-simplified",
				"chinese-traditional",
				"korean"
			],
			"requiresHardware": {
				"cuda": { "vramGb": 3 },
				"mps": { "ramGb": 6 },
				"cpu": { "ramGb": 6 }
			},
			"outputs": ["text", "table"],
			"timeout": 120,
			"cases": [
				{
					"name": "Extract text from plain text image",
					"image": "images/ocr_test_text.png",
					"expect": {
						"text": { "notEmpty": true, "contains": "quick brown fox" }
					}
				},
				{
					"name": "Extract table from table image",
					"image": "images/ocr_test_table.png",
					"expect": {
						"text": { "notEmpty": true },
						"table": { "notEmpty": true, "contains": "Alice" }
					}
				},
				{
					"name": "Extract text and table from mixed image",
					"image": "images/ocr_test_mixed.png",
					"expect": {
						"text": { "notEmpty": true, "contains": "Sales Report" },
						"table": { "notEmpty": true, "contains": "Widget" }
					}
				}
			]
		},
		{
			"profiles": ["japanese"],
			"requiresHardware": {
				"cuda": { "vramGb": 3 },
				"mps": { "ramGb": 6 },
				"cpu": { "ramGb": 6 }
			},
			"outputs": ["text"],
			"timeout": 120,
			"cases": [
				{
					"name": "Extract text from plain text image",
					"image": "images/ocr_test_text.png",
					"expect": {
						"text": { "notEmpty": true, "contains": "quick" }
					}
				}
			]
		},
		{
			"profiles": ["doctr"],
			"requiresHardware": {
				"cuda": { "vramGb": 3 },
				"mps": { "ramGb": 6 },
				"cpu": { "ramGb": 6 }
			},
			"outputs": ["text"],
			"timeout": 180,
			"cases": [
				{
					"name": "Extract text from plain text image",
					"image": "images/ocr_test_text.png",
					"expect": {
						"text": { "notEmpty": true, "contains": "quick brown fox" }
					}
				}
			]
		}
	]
}
