{
	//
	// Required:
	//		The displayable name of this node
	//
	"title": "Exa Search",
	//
	// Required:
	//		The protocol is the endpoint protocol
	//
	"protocol": "search_exa://",
	//
	// Required:
	//		Class type of the node - what it does
	//
	"classType": ["search"],
	//
	// Optional:
	//		Capabilities are flags that change the behavior of the underlying
	//		engine
	//
	"capabilities": ["invoke"],
	//
	// Optional:
	//		Register is either filter, endpoint or ignored if not specified. If the
	//		type is specified, a factory is registered of that given type
	//
	"register": "filter",
	//
	// Optional:
	//		The node is the actual pyhsical node to instantiate - if
	//		not specified, the protocol will be used
	//
	"node": "python",
	//
	// Optional:
	//		The path is the executable/script code - it is node dependent
	//		and is optional for most node
	//
	"path": "nodes.search_exa",
	//
	// Required:
	//		The prefix map when added/removed when convertting URLs <=> paths
	//
	"prefix": "search",
	//
	// Optional:
	//	  The icon is the icon to display in the UI for this node
	//
	"icon": "exa.svg",
	"documentation": "https://docs.rocketride.org/nodes/search_exa",
	//
	// Optional:
	//		Description to of this driver
	//
	"description": ["A direct Exa web search node.", "Accepts user questions and returns Exa's raw search JSON as the answer."],
	//
	// Optional:
	//		Tile text shown in the node card UI
	//
	"tile": ["Type: ${parameters.search_exa.type}", "Results: ${parameters.search_exa.numResults}"],
	//
	//	Optional:
	//		As a pipe component, define what this pipe component takes
	//		and what it produces
	//
	"lanes": {
		"questions": ["answers", "text"]
	},
	//
	// Optional:
	//		Local property definitions. One Exa account, stored flat; the key is
	//		required because the node cannot run without it, and arrives through
	//		the node config (a ${ROCKETRIDE_EXA_APIKEY} reference resolved per call).
	//
	"propertyDefinitions": {
		"search_exa.apikey": {
			"type": "string",
			"title": "API Key",
			"description": "Exa API key",
			"secret": true,
			"env": "ROCKETRIDE_EXA_APIKEY",
			"required": true
		},
		"search_exa.type": {
			"type": "string",
			"title": "Search Type",
			"default": "auto",
			"enum": [
				["auto", "Auto"],
				["keyword", "Keyword"],
				["neural", "Neural"]
			]
		},
		"search_exa.numResults": {
			"type": "integer",
			"title": "Results",
			"default": 5,
			"minimum": 1,
			"maximum": 20
		},
		"search_exa.includeHighlights": {
			"type": "boolean",
			"title": "Include Highlights",
			"default": true
		},
		"search_exa.highlightChars": {
			"type": "integer",
			"title": "Highlight Chars",
			"default": 600,
			"minimum": 100,
			"maximum": 4000
		}
	},
	//
	// Required:
	//		Defines the properties shown in the pipeline builder side panel, in
	//		order. The model and its context size are pinned: the chat base the
	//		search client is built on reads them, and Exa has one search model.
	//
	"properties": [
		"search_exa.apikey",
		"search_exa.type",
		"search_exa.numResults",
		"search_exa.includeHighlights",
		"search_exa.highlightChars",
		{ "name": "model", "type": "constant", "default": "exa-search" },
		{ "name": "modelTotalTokens", "type": "constant", "default": 16384 }
	]
}
