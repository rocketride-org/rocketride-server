	//
	// Optional:
	//		Test configuration for automated node testing. "profiles" lists
	//		values of the "model" selector; the framework writes the selected one
	//		at "model" and the mock credentials at their paths.
	//
	"test": [
		{
			"profiles": ["gpt-5.2", "gpt-5.4", "gpt-5.4-pro", "gpt-5.4-mini", "gpt-5.4-nano"],
			"outputs": ["answers"],
			"cases": [
				{
					"name": "LLM returns mock response",
					"text": "What is 2+2?",
					"expect": {
						"answers": { "contains": "Mock LLM response" }
					}
				}
			]
		},
		{
			"requires": ["ROCKETRIDE_OPENAI_KEY"],
			"avoidMocks": true,
			"profiles": ["gpt-4o-mini"],
			"outputs": ["answers"],
			"cases": [
				{
					"name": "LLM returns real response",
					"text": "What is 5*5? Answer with just the number.",
					"expect": {
						"answers": { "contains": "25" }
					}
				}
			]
		}
	]
