{
	//
	// Required:
	//		The displayable name of this node
	//
	"title": "Deepseek",
	//
	// Required:
	//		The protocol is the endpoint protocol
	//
	"protocol": "llm_deepseek://",
	//
	// Required:
	//		Class type of the node - what it does
	//
	"classType": ["llm"],
	//
	// Required:
	//		Capabilities are flags that change the behavior of the underlying
	//		engine
	//
	"capabilities": ["invoke"],
	//
	// Optional:
	//		Register is either filter, endpoint or ignored if not specified. If the
	//		type is specified, a factory is registered of that given type
	//
	"register": "filter",
	//
	// Optional:
	//		The node is the actual physical node to instantiate - if
	//		not specified, the protocol will be used
	//
	"node": "python",
	//
	// Optional:
	//		The path is the executable/script code - it is node dependent
	//		and is optional for most node
	//
	"path": "nodes.llm_deepseek",
	//
	// Required:
	//		The prefix map when added/removed when converting URLs <=> paths
	//
	"prefix": "llm",
	//
	// Optional:
	//		Description of this driver
	//
	"description": [
		"A component that connects to DeepSeek’s large language models for advanced ",
		"natural language processing. It enables capabilities like text generation, ",
		"summarization, and code understanding. Optimized for technical domains, DeepSeek ",
		"offers strong performance in handling programming-related queries, structured ",
		"data, and domain-specific tasks. The component is suitable for integrating ",
		"intelligent reasoning and content generation into pipelines where accuracy and ",
		"domain adaptation are key."
	],
	//
	// Optional:
	//		The icon is the icon to display in the UI for this node
	//
	"icon": "deepseek.svg",
	"documentation": "https://docs.rocketride.org/nodes/llm_deepseek",
	//
	// Optional:
	//		Rendering hints to the UI which indicate which fields of
	//		the configuration should be used to display information
	//
	"tile": ["Model: ${parameters.llm_deepseek.model}"],
	//
	// Optional:
	//		As a pipe component, define what this pipe component takes
	//		and what it produces
	//
	"lanes": {
		"questions": ["answers"]
	},
	//
	// Optional:
	//		Local property definitions. The model is the selector (one branch per
	//		model, the branch value is the model id); each branch pins its context
	//		window and capabilities as constants, and the leaves every model shares
	//		(credentials, generation settings) sit at the root and are stored flat.
	//		The "custom" branch takes a model id the catalog does not list.
	//
	"propertyDefinitions": {
		"llm_deepseek.apikey": {
			"base": "llm.cloud.apikey",
			"description": "DeepSeek API key (cloud models; local models need none)",
			"env": "ROCKETRIDE_LLM_DEEPSEEK_APIKEY",
			"required": false
		},
		"llm_deepseek.customModel": {
			"type": "string",
			"title": "Model id",
			"description": "Model id exactly as the provider names it",
			"required": true
		},
		"llm_deepseek.custom.modelTotalTokens": {
			"type": "number",
			"title": "Tokens",
			"description": "Total context length of the model in tokens",
			"minimum": 1,
			"default": 128000
		},
		"llm_deepseek.custom.modelOutputTokens": {
			"type": "integer",
			"title": "Output Tokens",
			"description": "Most tokens the model may write in one reply (at least 1,024). Leave it empty to keep the node's default. Reasoning models count their thinking against this limit: set it well above the reply you expect, or they can spend it all thinking and return nothing. It cannot exceed Tokens; a larger value is lowered to it.",
			"minimum": 1024,
			"default": 4096
		},
		"llm_deepseek.custom.serverbase": {
			"type": "string",
			"title": "Server URL",
			"description": "Base URL of the OpenAI-compatible endpoint serving the model",
			"default": "https://api.deepseek.com/v1"
		}
	},
	//
	// Required:
	//		Defines the properties shown in the pipeline builder side panel, in order
	//
	"properties": [
		{
			"name": "model",
			"type": "string",
			"title": "Model",
			"description": "Deepseek LLM model",
			"default": "deepseek-reasoner",
			"enum": {
				"deepseek-reasoner": {
					"title": "Cloud Reasoner",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 4096 },
						{ "name": "serverbase", "type": "constant", "default": "https://api.deepseek.com/v1" }
					]
				},
				"deepseek-chat": {
					"title": "Cloud Chat",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 163840 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 16384 },
						{ "name": "serverbase", "type": "constant", "default": "https://api.deepseek.com/v1" }
					]
				},
				"deepseek-r1:1.5b": {
					"title": "deepseek-r1-1_5b",
