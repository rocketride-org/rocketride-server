{
	//
	// Required:
	//		The displayable name of this node
	//
	"title": "Perplexity",
	//
	// Required:
	//		The protocol is the endpoint protocol
	//
	"protocol": "llm_perplexity://",
	//
	// Required:
	//		Class type of the node - what it does
	//
	"classType": ["llm"],
	//
	// Required:
	//		Capabilities are flags that change the behavior of the underlying
	//		engine
	//
	"capabilities": ["invoke"],
	//
	// Optional:
	//		Register is either filter, endpoint or ignored if not specified. If the
	//		type is specified, a factory is registered of that given type
	//
	"register": "filter",
	//
	// Optional:
	//		The node is the actual physical node to instantiate - if
	//		not specified, the protocol will be used
	//
	"node": "python",
	//
	// Optional:
	//		The path is the executable/script code - it is node dependent
	//		and is optional for most node
	//
	"path": "nodes.llm_perplexity",
	//
	// Required:
	//		The prefix map when added/removed when converting URLs <=> paths
	//
	"prefix": "llm",
	//
	// Optional:
	//		Description of this driver
	//
	"description": [
		"A component that connects to Perplexity AI's Sonar models for advanced natural language ",
		"processing with real-time web search capabilities. It supports tasks such as research, ",
		"question answering, and chat-based interactions with access to current web information. ",
		"Configurable with API keys and multiple model options including reasoning and deep research ",
		"models for comprehensive, fact-based responses."
	],
	//
	// Optional:
	//		The icon is the icon to display in the UI for this node
	//
	"icon": "perplexity.svg",
	"documentation": "https://docs.rocketride.org/nodes/llm_perplexity",
	//
	// Optional:
	//		Rendering hints to the UI which indicate which fields of
	//		the configuration should be used to display information
	//
	"tile": ["Model: ${parameters.llm_perplexity.model}"],
	//
	// Optional:
	//		As a pipe component, define what this pipe component takes
	//		and what it produces
	//
	"lanes": {
		"questions": ["answers"]
	},
	//
	// Optional:
	//		Local property definitions. The model is the selector (one branch per
	//		model, the branch value is the model id); each branch pins its context
	//		window and capabilities as constants, and the leaves every model shares
	//		(credentials, generation settings) sit at the root and are stored flat.
	//		The "custom" branch takes a model id the catalog does not list.
	//
	"propertyDefinitions": {
		"llm_perplexity.apikey": {
			"base": "llm.cloud.apikey",
			"description": "Perplexity API key",
			"env": "ROCKETRIDE_LLM_PERPLEXITY_APIKEY",
			"required": true
		}
	},
	//
	// Required:
	//		Defines the properties shown in the pipeline builder side panel, in order
	//
	"properties": [
		{
			"name": "model",
			"type": "string",
			"title": "Model",
			"description": "Perplexity AI model",
			"default": "sonar",
			"enum": {
				"sonar-pro": {
					"title": "Sonar Pro",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 200000 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 8000 }
					]
				},
				"sonar": {
					"title": "Sonar",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 127072 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 114364 }
					]
				},
				"sonar-reasoning-pro": {
					"title": "Sonar Reasoning Pro",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 115200 },
						{ "name": "reasoning", "type": "constant", "default": true }
					]
				},
				"sonar-reasoning": {
					"title": "Sonar Reasoning",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 4096 }
					]
				},
				"sonar-deep-research": {
					"title": "Sonar Deep Research",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 115200 },
						{ "name": "reasoning", "type": "constant", "default": true }
					]
				},
				"sonar-pro-search": {
					"title": "Perplexity: Sonar Pro Search",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 200000 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 8000 },
						{ "name": "reasoning", "type": "constant", "default": true }
					]
				}
			}
		},
		"llm_perplexity.apikey"
	],
	//
	// Optional:
	//		Test configuration for automated node testing. "profiles" lists
	//		values of the "model" selector; the framework writes the selected one
	//		at "model" and the mock credentials at their paths.
	//
	"test": {
		"profiles": ["sonar"],
		"outputs": ["answers"],
		"cases": [
			{
				"name": "LLM returns mock response",
				"text": "What is 2+2?",
				"expect": {
					"answers": { "contains": "Mock LLM response" }
				}
			}
		]
	}
}
