{
	//
	// Required:
	//		The displayable name of this node
	//
	"title": "Text To Speech (ElevenLabs)",
	//
	// Required:
	//		The protocol is the endpoint protocol
	//
	"protocol": "tts_elevenlabs://",
	//
	// Required:
	//		Class type of the node - what it does
	//
	"classType": ["audio"],
	//
	// Required:
	//		Capabilities are flags that change the behavior of the underlying
	//		engine
	//
	"capabilities": [],
	//
	// Optional:
	//		Register is either filter, endpoint or ignored if not specified. If the
	//		type is specified, a factory is registered of that given type
	//
	"register": "filter",
	//
	// Optional:
	//		The node is the actual physical node to instantiate - if
	//		not specified, the protocol will be used
	//
	"node": "python",
	//
	// Optional:
	//		The path is the executable/script code. Shared with the OpenAI
	//		registration: both cloud TTS vendors run the same engine code in
	//		nodes/cloud_tts and are dispatched by logicalType at runtime.
	//
	"path": "nodes.cloud_tts",
	//
	// Required:
	//		The prefix map when added/removed when converting URLs <=> paths
	//
	"prefix": "tts_elevenlabs",
	//
	// Optional:
	//		Description of this driver
	//
	"description": ["Converts incoming text into speech using the ElevenLabs text-to-speech API.", "Calls the vendor API directly from the engine host over HTTPS and emits MP3 bytes on the audio lane.", "The model and voice lists are maintained manually; the API key is read from the node config, a ${ROCKETRIDE_TTS_ELEVENLABS_APIKEY} reference resolved per call."],
	//
	// Optional:
	//	  The icon to display in the UI for this node
	//
	"icon": "elevenlabs.svg",
	"documentation": "https://docs.rocketride.org/nodes/cloud_tts",
	//
	//	Optional:
	//		As a pipe component, define what this pipe component takes
	//		and what it produces
	//
	"lanes": {
		"text": ["audio"],
		"documents": ["audio"],
		"questions": ["audio"],
		"answers": ["audio"]
	},
	//
	// Optional:
	//		Local property definitions. The model is the selector (one value per
	//		model, maintained manually); the API key and the voice are shared by
	//		every model and stored flat.
	//
	"propertyDefinitions": {
		"tts_elevenlabs.apikey": {
			"base": "llm.cloud.apikey",
			"description": "ElevenLabs API key",
			"env": "ROCKETRIDE_TTS_ELEVENLABS_APIKEY",
			"required": true
		},
		"tts_elevenlabs.voice": {
			"type": "string",
			"title": "Voice",
			"description": "Premade ElevenLabs voice (voice_id).",
			"default": "EXAVITQu4vr4xnSDxMaL",
			"enum": [
				["21m00Tcm4TlvDq8ikWAM", "Rachel"],
				["AZnzlk1XvdvUeBnXmlld", "Domi"],
				["EXAVITQu4vr4xnSDxMaL", "Bella"],
				["ErXwobaYiN019PkySvjV", "Antoni"],
				["MF3mGyEYCl7XYWbV9V6O", "Elli"],
				["TxGEqnHWrfWFTfGW9XjX", "Josh"],
				["VR6AewLTigWG4xSOukaG", "Arnold"],
				["pNInz6obpgDQGcFmaJgB", "Adam"],
				["yoZ06aMxZJJ28mfd3POQ", "Sam"]
			]
		}
	},
	//
	// Required:
	//		Defines the properties shown in the pipeline builder side panel, in order
	//
	"properties": [
		{
			"name": "model",
			"type": "string",
			"title": "Model",
			"description": "ElevenLabs model",
			"default": "eleven_multilingual_v2",
			"enum": {
				"eleven_multilingual_v2": { "title": "Multilingual v2 - High quality, 29 languages" },
				"eleven_turbo_v2_5": { "title": "Turbo v2.5      - Low latency, 32 languages" },
				"eleven_flash_v2_5": { "title": "Flash v2.5      - Lowest latency" },
				"eleven_v3": { "title": "Eleven v3       - Most expressive" }
			}
		},
		"tts_elevenlabs.apikey",
		"tts_elevenlabs.voice"
	],
	//
	// Optional:
	//		Test configuration for automated node testing. "profiles" lists
	//		values of the "model" selector.
	//
	"test": [
		{
			// No audio mock exists, so this runs only when a real key is present
			// (ROCKETRIDE_TTS_ELEVENLABS_KEY) and is skipped in CI otherwise.
			"requires": ["ROCKETRIDE_TTS_ELEVENLABS_KEY"],
			"avoidMocks": true,
			"profiles": ["eleven_multilingual_v2"],
			"outputs": ["audio"],
			"cases": [
				{
					"name": "ElevenLabs returns audio",
					"text": "Hello from RocketRide",
					"expect": {
						"audio": {
							"notEmpty": true
						}
					}
				}
			]
		}
	]
}
