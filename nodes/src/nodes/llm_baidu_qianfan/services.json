{
	//
	// Required:
	//		The displayable name of this node
	//
	"title": "Baidu Qianfan",
	//
	// Required:
	//		The protocol is the endpoint protocol
	//
	"protocol": "llm_baidu_qianfan://",
	//
	// Required:
	//		Class type of the node - what it does
	//
	"classType": ["llm"],
	//
	// Required:
	//		Capabilities are flags that change the behavior of the underlying
	//		engine
	//
	"capabilities": ["invoke"],
	//
	// Optional:
	//		Register is either filter, endpoint or ignored if not specified. If the
	//		type is specified, a factory is registered of that given type
	//
	"register": "filter",
	//
	// Optional:
	//		The node is the actual physical node to instantiate - if
	//		not specified, the protocol will be used
	//
	"node": "python",
	//
	// Optional:
	//		The path is the executable/script code - it is node dependent
	//		and is optional for most node
	//
	"path": "nodes.llm_baidu_qianfan",
	//
	// Required:
	//		The prefix map when added/removed when converting URLs <=> paths
	//
	"prefix": "llm",
	//
	// Optional:
	//		Description of this driver
	//
	"description": [
		"A component that connects to Baidu Qianfan ERNIE large language models through ",
		"Qianfan's OpenAI-compatible chat-completions API. It supports chat-based text generation, ",
		"question answering, summarization, and Chinese-language enterprise AI workflows with configurable ",
		"API keys and base URLs."
	],
	//
	// Optional:
	//		The icon is the icon to display in the UI for this node
	//
	"icon": "baidu-qianfan.svg",
	"documentation": "https://docs.rocketride.org/nodes/llm_baidu_qianfan",
	//
	// Optional:
	//		Rendering hints to the UI which indicate which fields of
	//		the configuration should be used to display information
	//
	"tile": ["Model: ${parameters.llm_baidu_qianfan.model}"],
	//
	// Optional:
	//		As a pipe component, define what this pipe component takes
	//		and what it produces
	//
	"lanes": {
		"questions": ["answers"]
	},
	//
	// Optional:
	//		Local property definitions. The model is the selector (one branch per
	//		model, the branch value is the model id); each branch pins its context
	//		window and capabilities as constants, and the leaves every model shares
	//		(credentials, generation settings) sit at the root and are stored flat.
	//		The "custom" branch takes a model id the catalog does not list.
	//
	"propertyDefinitions": {
		"llm_baidu_qianfan.apikey": {
			"base": "llm.cloud.apikey",
			"description": "Baidu Qianfan API key",
			"env": "ROCKETRIDE_LLM_BAIDU_QIANFAN_APIKEY",
			"required": true
		},
		"llm_baidu_qianfan.serverbase": {
			"base": "llm.local.serverbase",
			"default": "https://qianfan.baidubce.com/v2",
			"title": "Base URL",
			"description": "Qianfan OpenAI-compatible API endpoint.",
			"enum": [
				["https://qianfan.baidubce.com/v2", "China (default)"],
				["https://api.baiduqianfan.ai/v1", "International"]
			]
		},
		"llm_baidu_qianfan.customModel": {
			"type": "string",
			"title": "Model id",
			"description": "Model id exactly as the provider names it",
			"required": true
		},
		"llm_baidu_qianfan.custom.modelTotalTokens": {
			"type": "number",
			"title": "Tokens",
			"description": "Maximum context length in tokens",
			"minimum": 1,
			"default": 32768
		},
		"llm_baidu_qianfan.custom.modelOutputTokens": {
			"type": "integer",
			"title": "Output Tokens",
			"description": "Maximum generated tokens",
			"minimum": 1024,
			"default": 4096
		}
	},
	//
	// Required:
	//		Defines the properties shown in the pipeline builder side panel, in order
	//
	"properties": [
		{
			"name": "model",
			"type": "string",
			"title": "Model",
			"description": "Baidu Qianfan model selection",
			"default": "ernie-4.5-turbo-128k",
			"enum": {
				"ernie-4.5-turbo-128k": {
					"title": "ERNIE 4.5 Turbo 128K",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 4096 }
					]
				},
				"ernie-4.5-turbo-32k": {
					"title": "ERNIE 4.5 Turbo 32K",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 32768 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 4096 }
					]
				},
				"ernie-5.0-thinking-preview": {
					"title": "ERNIE 5.0 Thinking Preview",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 8192 }
					]
				},
				"custom": {
					"title": "Custom model",
					"properties": [
						"llm_baidu_qianfan.customModel",
						"llm_baidu_qianfan.custom.modelTotalTokens",
						"llm_baidu_qianfan.custom.modelOutputTokens"
					]
				}
			}
		},
		"llm_baidu_qianfan.apikey",
		"llm_baidu_qianfan.serverbase"
	],
	//
	// Optional:
	//		Test configuration for automated node testing. "profiles" lists
	//		values of the "model" selector; the framework writes the selected one
	//		at "model" and the mock credentials at their paths.
	//
	"test": {
		"profiles": ["ernie-4.5-turbo-128k"],
		"outputs": ["answers"],
		"cases": [
			{
				"name": "LLM returns mock response",
				"text": "What is 2+2?",
				"expect": {
					"answers": { "contains": "Mock LLM response" }
				}
			}
		]
	}
}
