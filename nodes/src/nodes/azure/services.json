{
	//
	// Required:
	//		The displayable name of this node
	//
	"title": "Azure",
	//
	// Required:
	//		The protocol is the endpoint protocol
	//
	"protocol": "azure://",
	//
	// Required:
	//		The physical type - "cpp" makes this a C++ node. The engine loads
	//		the shared library named by "path" and calls its initializeNode
	//		entry point, which registers the factories this protocol resolves
	//		to.
	//
	"node": "cpp",
	//
	// Required (for "node": "cpp"):
	//		Base name of the node's shared library, without the platform
	//		prefix or extension. Must match the target name passed to
	//		rocketride_add_node in CMakeLists.txt.
	//
	"path": "azure",
	//
	// Required:
	//		Class type of the node - what it does
	//
	"classType": [],
	//
	// Required:
	//		Capabilities are flags that change the behavior of the underlying
	//		engine
	//
	"capabilities": [
		"internal",
		"network"
	],
	//
	// Optional:
	//		Supported actions - if not specified, no actions are supported
	//		engine
	//
	"actions": [
		"export",
		"delete",
		"download"
	],
	//
	// Required:
	//		The prefix map when added/removed when convertting URLs <=> paths
	//
	"prefix": "Microsoft Azure",
	//
	// Optional:
	//		Description to of this driver
	//
	"description": [
		"A source component that reads data from Azure blobs. It enables ",
		"ingestion of files and documents stored in Azure for further processing within ",
		"the pipeline. Configurable with Azure credentials and blob settings, the ",
		"component supports secure and scalable access to cloud-hosted data across ",
		"various formats."
	],
	//
	//	Optional:
	//		Displayed on the user interface
	//
	"icon": "azure-blob.svg",
	//
	// Optional:
	//	  Documentation link for this driver
	//
	"documentation": "https://bit.ly/4hG9ux1",
	//
	//	Optional:
	//		As a pipe component, define what this pipe component takes
	//		and what it produces
	//
	"lanes": {
		"_source": [
			"tags"
		]
	},
	"input": [
		{
			"lane": "_source",
			"output": [
				{
					"lane": "tags",
					"description": "Outputs documents to be processed."
				}
			]
		}
	],
	//
	// Optional:
	//		Local property definitions. The account credentials live in the
	//		"parameters" group, which is where the C++ node reads them; the
	//		account key is a secret the account variable supplies.
	//
	"propertyDefinitions": {
		"azure.accountName": {
			"type": "string",
			"title": "Account name",
			"description": "The Azure storage account name."
		},
		"azure.accountKey": {
			"type": "string",
			"title": "Account key",
			"description": "The Azure storage account key.",
			"secret": true,
			"env": "ROCKETRIDE_AZURE_ACCOUNTKEY"
		},
		"azure.endpointSuffix": {
			"type": "string",
			"title": "Endpoint suffix",
			"description": "Host suffix the account name is prefixed to.",
			"default": "blob.core.windows.net"
		}
	},
	//
	// Required:
	//		Defines the properties shown in the pipeline builder side panel, in order
	//
	"properties": [
		"type",
		"actions",
		"source.mode",
		{
			"name": "parameters",
			"properties": [
				"azure.accountName",
				"azure.accountKey",
				"azure.endpointSuffix"
			]
		},
		{
			"name": "include",
			"type": "array",
			"description": "Example path: container/path/to/your/blobs/*",
			"item": "Pipe.include.path"
		},
		{
			"name": "exclude",
			"type": "array",
			"description": "Example path: container/path/to/your/blobs/*",
			"item": "Pipe.exclude.path"
		}
	]
}
