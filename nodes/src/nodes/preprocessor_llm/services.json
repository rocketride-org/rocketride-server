{
	//
	// Required:
	//		The displayable name of this node
	//
	"title": "LLM",
	//
	// Required:
	//		The protocol is the endpoint protocol
	//
	"protocol": "preprocessor_llm://",
	//
	// Required:
	//		Class type of the node - what it does
	//
	"classType": ["preprocessor"],
	//
	// Required:
	//		Capabilities are flags that change the behavior of the underlying
	//		engine
	//
	"capabilities": [],
	//
	// Optional:
	//		Register is either filter, endpoint or ignored if not specified. If the
	//		type is specified, a factory is registered of that given type
	//
	"register": "filter",
	//
	// Optional:
	//		The node is the actual physical node to instantiate - if
	//		not specified, the protocol will be used
	//
	"node": "python",
	//
	// Optional:
	//		The path is the executable/script code - it is node dependent
	// 		and is optional for most node
	//
	"path": "nodes.preprocessor_llm",
	//
	// Required:
	//		The prefix map when added/removed when convertting URLs <=> paths
	//
	"prefix": "Preprocessor",
	//
	// Optional:
	//		Description to of this driver
	//
	"description": ["A processing component that analyzes document content to extract concise ", "summaries, key points, and named entities and to divide a document for ", "storage into a vector database."],
	//
	// Optional:
	//	  The icon is the icon to display in the UI for this node
	//
	"icon": "preprocessor-llm.svg",
	"documentation": "https://docs.rocketride.org/nodes/preprocessor_llm",
	//
	//
	//
	//  Optional:
	//      Rendering hints to the UI which indicate which fields of
	//      the configuration should be used to display information
	"tile": [],
	//
	// Optional:
	//		Defines the invoke connections that may/must be connected
	// 		which are utilized by this driver
	//
	"invoke": {
		"llm": {
			"description": "LLM to use to process the document",
			"min": 1
		}
	},
	//
	//	Optional:
	//		As a pipe component, define what this pipe component takes
	//		and what it produces
	//
	"lanes": {
		"table": ["documents"],
		"text": ["documents"]
	},
	//
	// Optional:
	//		Local property definitions. One setting, stored flat.
	//
	"propertyDefinitions": {
		"preprocessor_llm.numberOfTokens": {
			"type": "integer",
			"title": "Number of tokens per document chunk",
			"description": "Needs to match your embedding model.",
			"default": 384,
			"minimum": 1
		}
	},
	//
	// Required:
	//		Defines the properties shown in the pipeline builder side panel, in order
	//
	"properties": ["preprocessor_llm.numberOfTokens"]
}
