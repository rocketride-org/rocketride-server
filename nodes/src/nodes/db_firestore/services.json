{
	"title": "Firestore",
	"protocol": "db_firestore://",
	"classType": ["database", "tool"],
	"capabilities": ["noremote", "invoke"],
	"register": "filter",
	"node": "python",
	"path": "nodes.db_firestore",
	"prefix": "firestore",
	"description": ["A processing component that connects to Google Cloud Firestore (Native mode)."],
	"icon": "db_firestore.svg",
	"documentation": "https://docs.rocketride.org/nodes/db_firestore",
	"invoke": {},
	"lanes": {},
	//
	// Optional:
	//		Local property definitions. Authentication reuses the shared GCP
	//		definitions (gcp.authType is a selector: the service-account
	//		branch carries the key upload); everything else is stored flat.
	//
	"propertyDefinitions": {
		"firestore.database": {
			"type": "string",
			"title": "Database ID",
			"default": "(default)",
			"minLength": 1,
			"description": "The Firestore database ID. Usually '(default)'."
		},
		"firestore.collection": {
			"type": "string",
			"title": "Collection",
			"default": "",
			"description": "The Firestore collection to query or insert into."
		}
	},
	//
	// Required:
	//		Defines the properties shown in the pipeline builder side panel, in order
	//
	"properties": [
		"gcp.authType",
		"gcp.projectId",
		"firestore.database",
		"firestore.collection"
	]
}
