{
	"title": "TwelveLabs",
	"protocol": "twelvelabs://",
	"classType": ["video"],
	"capabilities": [],
	"register": "filter",
	"node": "python",
	"path": "nodes.twelvelabs",
	"prefix": "twelvelabs",
	"description": ["Sends a video to TwelveLabs along with instructions and returns the generated text response."],
	"icon": "twelvelabs.svg",
	"documentation": "https://docs.rocketride.org/nodes/twelvelabs",
	"lanes": {
		"video": ["text"]
	},
	//
	// Optional:
	//		Local property definitions. The API key is a required secret the account
	//		variable supplies.
	//
	"propertyDefinitions": {
		"twelvelabs.apikey": {
			"type": "string",
			"title": "API Key",
			"description": "TwelveLabs API key.",
			"secret": true,
			"env": "ROCKETRIDE_TWELVELABS_APIKEY",
			"required": true
		},
		"twelvelabs.instructions": {
			"type": "array",
			"title": "Instructions",
			"description": "Instructions to guide TwelveLabs when analyzing the video.",
			"default": [],
			"items": {
				"type": "string",
				"format": "textarea"
			}
		}
	},
	"properties": ["type", "twelvelabs.apikey", "twelvelabs.instructions"]
}
