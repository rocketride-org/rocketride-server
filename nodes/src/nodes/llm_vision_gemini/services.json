{
	//
	// Required:
	//		The displayable name of this node
	//
	"title": "Gemini Vision",
	//
	// Required:
	//		The protocol is the endpoint protocol
	//
	"protocol": "image_vision_gemini://",
	//
	// Required:
	//		Class type of the node - what it does
	//
	"classType": ["image"],
	//
	// Required:
	//		Capabilities are flags that change the behavior of the underlying
	//		engine
	//
	"capabilities": ["invoke"],
	//
	// Optional:
	//		Register is either filter, endpoint or ignored if not specified. If the
	//		type is specified, a factory is registered of that given type
	//
	"register": "filter",
	//
	// Optional:
	//		The node is the actual physical node to instantiate - if
	//		not specified, the protocol will be used
	//
	"node": "python",
	//
	// Optional:
	//		The path is the executable/script code - it is node dependent
	//		and is optional for most node
	//
	"path": "nodes.llm_vision_gemini",
	//
	// Required:
	//		The prefix map when added/removed when converting URLs <=> paths
	//
	"prefix": "image_vision_gemini",
	//
	// Optional:
	//		Description of this driver
	//
	"description": [
		"A component that connects to Google Gemini's vision-capable models for image analysis, ",
		"OCR, visual understanding, and scene description. Supports Gemini 2.5 and 3.x models ",
		"with multimodal capabilities. Features robust error handling, automatic image processing, ",
		"and flexible prompt configuration for a wide range of vision use cases."
	],
	//
	// Optional:
	//		The icon is the icon to display in the UI for this node
	//
	"icon": "gemini.svg",
	"documentation": "https://docs.rocketride.org/nodes/llm_vision_gemini",
	//
	// Optional:
	//		Rendering hints to the UI which indicate which fields of
	//		the configuration should be used to display information
	//
	"tile": ["Model: ${parameters.llm_vision_gemini.model}"],
	//
	// Optional:
	//		As a pipe component, define what this pipe component takes
	//		and what it produces
	//
	"lanes": {
		"image": ["text"],
		"documents": ["documents"]
	},
	//
	// Optional:
	//		Local property definitions. The model is the selector (one branch per
	//		model, the branch value is the model id); each branch pins its context
	//		window and capabilities as constants, and the leaves every model shares
	//		(credentials, generation settings) sit at the root and are stored flat.
	//		The "custom" branch takes a model id the catalog does not list.
	//
	"propertyDefinitions": {
		"llm_vision_gemini.apikey": {
			"base": "llm.cloud.apikey",
			"description": "Google AI API key (from https://aistudio.google.com/apikey)",
			"env": "ROCKETRIDE_LLM_VISION_GEMINI_APIKEY",
			"required": true
		},
		"llm_vision_gemini.systemPrompt": {
			"type": "string",
			"format": "textarea",
			"title": "System prompt",
			"description": "Instructions that frame how the model describes images.",
			"default": ""
		},
		"llm_vision_gemini.prompt": {
			"type": "string",
			"format": "textarea",
			"title": "Prompt",
			"description": "The question asked about every image.",
			"default": "Describe this image in detail."
		}
	},
	//
	// Required:
	//		Defines the properties shown in the pipeline builder side panel, in order
	//
	"properties": [
		{
			"name": "model",
			"type": "string",
			"title": "Model",
			"description": "Select the Gemini vision model to use",
			"default": "models/gemini-2.5-flash",
			"enum": {
				"models/gemini-2.5-flash": {
					"title": "Gemini 2.5 Flash - Fast Vision (1M tokens)",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 1048576 }
					]
				},
				"models/gemini-2.5-pro": {
					"title": "Gemini 2.5 Pro - High Quality Vision (1M tokens)",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 1048576 }
					]
				},
				"models/gemini-2.5-flash-lite": {
					"title": "Gemini 2.5 Flash Lite - Fastest & Cheapest (1M tokens)",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 1048576 }
					]
				},
				"models/gemini-3.1-pro-preview": {
					"title": "Gemini 3.1 Pro - Latest Vision (1M tokens)",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 1048576 }
					]
				},
				"models/gemini-3.1-flash-image-preview": {
					"title": "Gemini 3.1 Flash Image Preview (131k tokens)",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 131072 }
					]
				}
			}
		},
		"llm_vision_gemini.apikey",
		"llm_vision_gemini.systemPrompt",
		"llm_vision_gemini.prompt"
	]
}
