{
	//
	// Required:
	//		The displayable name of this node
	//
	"title": "Scan Cropper",
	//
	// Required:
	//		The protocol is the endpoint protocol
	//
	"protocol": "scan_cropper://",
	//
	// Required:
	//		Class type of the node - what it does. Also decides the docs-site
	//		category ("image" -> Vision & Image) and the canvas palette group.
	//
	"classType": ["image"],
	//
	// Required:
	//		Capabilities are flags that change the behavior of the underlying
	//		engine. This node is a plain filter: no agent tool, no GPU, no
	//		network, no filesystem of its own.
	//
	"capabilities": [],
	//
	// Optional:
	//		Register is either filter, endpoint or ignored if not specified. If the
	//		type is specified, a factory is registered of that given type
	//
	"register": "filter",
	//
	// Optional:
	//		The node is the actual physical node to instantiate - if
	//		not specified, the protocol will be used
	//
	"node": "python",
	//
	// Optional:
	//		The path is the executable/script code - it is node dependent
	// 		and is optional for most node
	//
	"path": "nodes.scan_cropper",
	//
	// Required:
	//		The prefix map when added/removed when convertting URLs <=> paths
	//
	"prefix": "scan_cropper",
	//
	// Optional:
	//		Description to of this driver
	//
	"description": ["Splits a scan that holds several photos - a photo album page, or a handful of prints laid on the", "platen - into one image per photo. It works out what the background is from the scan itself, so there", "is no white/dark/album mode to choose, straightens each photo, and cuts apart prints mounted edge to", "edge. Detection runs on a downscaled copy and the crops are taken at full resolution."],
	//
	// Optional:
	//	  The icon is the icon to display in the UI for this node
	//
	"icon": "scan_cropper.svg",
	"documentation": "https://docs.rocketride.org",
	//
	// Optional:
	//		Summary line shown on the node's tile on the canvas
	//
	"tile": ["Scan type: ${parameters.scan_cropper.profile}"],
	//
	//
	//	Optional:
	//		As a pipe component, define what this pipe component takes
	//		and what it produces
	//
	"lanes": {
		"image": ["image", "text"]
	},
	//
	// Optional:
	//		Prose for each input lane and the outputs it produces
	//
	"input": [
		{
			"lane": "image",
			"description": "A scanned page holding one or more photographs.",
			"output": [
				{
					"lane": "image",
					"description": "One JPEG per photo found, named <scan>.crop<N>.jpg in page reading order (top row left to right). A scan whose photos could not be found is forwarded unchanged rather than dropped."
				},
				{
					"lane": "text",
					"description": "JSON detection record: {decoded, count, regions[]}, each region carrying cx/cy/w/h/angle, its share of the page, its distance from the nearest standard print ratio, whether it was cropped, and the filename it was emitted under."
				}
			]
		}
	],
	//
	//	Optional:
	//		Profile section are configuration optoins used by the driver
	//		itself.
	//
	//		These describe the SCAN, not the algorithm. The detector works the
	//		background out from the scan itself, so there is deliberately no
	//		white/dark/album mode here - what genuinely differs between these
	//		cases is whether photos touch each other (which decides if the
	//		expensive seam search is worth running), how uniform their sizes
	//		are, and how much grain the page carries. Each profile is merged
	//		underneath the user's own settings, so any single value can still
	//		be overridden in Advanced tuning.
	//
	"preconfig": {
		// Define the values that will be merged into any profile configuration
		// specified, unless the profile is 'absolute'
		"default": "album",
		// Defines profiles used with the "profile": key
		"profiles": {
			"album": {
				"title": "Album page - photos mounted together",
				"maxDepth": 4,
				"texture": 4.0,
				"minRelative": 0.4
			},
			"loose": {
				"title": "Loose prints on the scanner bed",
				// Prints laid down separately never touch, so the seam search
				// - the dominant cost - has nothing to find. Sizes also vary
				// more than on a mounted page, so keep the smaller ones.
				"maxDepth": 0,
				"texture": 4.0,
				"minRelative": 0.2
			},
			"textured": {
				"title": "Textured or patterned page",
				// A grainy or patterned page reads as photo content at the
				// default threshold; raising it puts the page back in the
				// background where it belongs.
				"maxDepth": 4,
				"texture": 9.0,
				"minRelative": 0.4
			},
			"detail": {
				"title": "Maximum detail (slower)",
				// Detection cost scales with the square of detectSize.
				"detectSize": 4500,
				"maxDepth": 6,
				"texture": 4.0,
				"minRelative": 0.4
			}
		}
	},
	//
	// Optional:
	//		Local fields definitions - these define fields only for the
	//		current service. You may specify them here, or directly
	//		in the shape.
	//
	//		NOTE: the "scan_cropper." prefix is UI-schema only. The config dict
	//		the node receives is keyed on the bare name ("detectSize", not
	//		"scan_cropper.detectSize").
	//
	"fields": {
		"scan_cropper.profile": {
			"title": "Scan type",
			"description": "Pick what you actually scanned and nothing else needs setting. There is no white/dark/album background choice because the node works the background out from the scan itself - what these change is whether photos touch each other, how similar their sizes are, and how grainy the page is. Every scan type carries a 'Show advanced settings' switch that opens up its own values for tweaking.",
			"type": "string",
			"default": "album",
			"enum": ["*>preconfig.profiles.*.title"],
			"conditional": [
				{ "value": "album", "properties": ["scan_cropper.album"] },
				{ "value": "loose", "properties": ["scan_cropper.loose"] },
				{ "value": "textured", "properties": ["scan_cropper.textured"] },
				{ "value": "detail", "properties": ["scan_cropper.detail"] }
			]
		},
		"scan_cropper.deskew": {
			"type": "boolean",
			"title": "Straighten photos",
			"description": "Rotates each photo upright as it is cut, so a slightly crooked scan comes out square. Turn this off only if you would rather keep the original pixels untouched - the photo then keeps its tilt and has page-coloured wedges in the corners.",
			"default": true,
			"enum": [
				[true, "Yes"],
				[false, "No"]
			]
		},
		"scan_cropper.quality": {
			"type": "string",
			"title": "JPEG quality",
			"description": "Type 'auto' to match the quality your scanner saved at, or a number from 1 to 100. Leave it on 'auto': saving above the original cannot recover detail the scanner already threw away, it only makes files bigger - a quality-75 scan re-saved at 100 is roughly four times the size and looks the same.",
			"default": "auto"
		},
		//
		// The tunables, revealed by the "Show advanced settings" switch that sits inside
		// whichever Scan type is selected. Each Scan type carries its own switch and its own
		// copy of the list, so opening it shows that Scan type's real values - Textured shows
		// texture 9, not the shared 4. A field is redefined here only where the Scan type
		// differs from the shared default further down; the rest are referenced from it.
		// nodes/test/scan_cropper/test_presets.py fails if an override's default and the
		// preconfig value it mirrors ever disagree.
		//
		"scan_cropper.album.tune": {
			"type": "boolean",
			"title": "Show advanced settings",
			"description": "Reveals every value this scan type uses, filled in with its own numbers, so you can start from it and adjust one thing rather than setting all ten from scratch.",
			"default": false,
			"enum": [
				[true, "Yes"],
				[false, "No"]
			],
			"conditional": [
				{
					"value": true,
					"properties": [
						"scan_cropper.qualityTolerance",
						"scan_cropper.detectSize",
						"scan_cropper.texture",
						"scan_cropper.minArea",
						"scan_cropper.maxArea",
						"scan_cropper.maxAspect",
						"scan_cropper.minRelative",
						"scan_cropper.maxDepth",
						"scan_cropper.skew",
						"scan_cropper.ratioTolerance"
					]
				},
				{
					"value": false,
					"properties": []
				}
			]
		},
		"scan_cropper.album": {
			"object": "album",
			"properties": ["scan_cropper.deskew", "scan_cropper.quality", "scan_cropper.album.tune"]
		},
		"scan_cropper.loose.maxDepth": {
			"type": "integer",
			"title": "Separate touching photos",
			"description": "Photos mounted edge to edge look like one shape and have to be cut apart; this is how many times a shape may be cut. Set to 0 when your photos never touch - it switches off the most expensive part of the search and is by far the biggest speed win. Raise it if a row of several touching photos comes out as one image.",
			"optional": true,
			"default": 0,
			"minimum": 0,
			"maximum": 8
		},
		"scan_cropper.loose.minRelative": {
			"type": "number",
			"title": "Discard small leftovers",
			"description": "Throws away finds much smaller than the biggest photo on the page, on the assumption they are torn-off pieces of one photo rather than photos in their own right. 0.4 means 'drop anything under 40% of the largest'. Lower it, or set 0 to keep everything, when one page genuinely holds photos of very different sizes.",
			"optional": true,
			"default": 0.2,
			"minimum": 0.0,
			"maximum": 1.0
		},
		"scan_cropper.loose.tune": {
			"type": "boolean",
			"title": "Show advanced settings",
			"description": "Reveals every value this scan type uses, filled in with its own numbers, so you can start from it and adjust one thing rather than setting all ten from scratch.",
			"default": false,
			"enum": [
				[true, "Yes"],
				[false, "No"]
			],
			"conditional": [
				{
					"value": true,
					"properties": [
						"scan_cropper.qualityTolerance",
						"scan_cropper.detectSize",
						"scan_cropper.texture",
						"scan_cropper.minArea",
						"scan_cropper.maxArea",
						"scan_cropper.maxAspect",
						"scan_cropper.loose.minRelative",
						"scan_cropper.loose.maxDepth",
						"scan_cropper.skew",
						"scan_cropper.ratioTolerance"
					]
				},
				{
					"value": false,
					"properties": []
				}
			]
		},
		"scan_cropper.loose": {
			"object": "loose",
			"properties": ["scan_cropper.deskew", "scan_cropper.quality", "scan_cropper.loose.tune"]
		},
		"scan_cropper.textured.texture": {
			"type": "number",
			"title": "Page smoothness",
			"description": "How smooth an area has to be before it counts as empty page rather than part of a photo. RAISE this if the page itself is being detected as photos (grainy, patterned or fabric-covered pages). LOWER it if a photo with large flat areas - a plain sky, a studio backdrop - is being cut short or missed.",
			"optional": true,
			"default": 9.0,
			"minimum": 0.5,
			"maximum": 50
		},
		"scan_cropper.textured.tune": {
			"type": "boolean",
			"title": "Show advanced settings",
			"description": "Reveals every value this scan type uses, filled in with its own numbers, so you can start from it and adjust one thing rather than setting all ten from scratch.",
			"default": false,
			"enum": [
				[true, "Yes"],
				[false, "No"]
			],
			"conditional": [
				{
					"value": true,
					"properties": [
						"scan_cropper.qualityTolerance",
						"scan_cropper.detectSize",
						"scan_cropper.textured.texture",
						"scan_cropper.minArea",
						"scan_cropper.maxArea",
						"scan_cropper.maxAspect",
						"scan_cropper.minRelative",
						"scan_cropper.maxDepth",
						"scan_cropper.skew",
						"scan_cropper.ratioTolerance"
					]
				},
				{
					"value": false,
					"properties": []
				}
			]
		},
		"scan_cropper.textured": {
			"object": "textured",
			"properties": ["scan_cropper.deskew", "scan_cropper.quality", "scan_cropper.textured.tune"]
		},
		"scan_cropper.detail.detectSize": {
			"type": "integer",
			"title": "Detection size (px)",
			"description": "How big a copy of the scan the search for photos runs on. Your crops are always cut from the full-resolution original, so this only trades speed against how precisely photo edges are located. It is the main speed control and the cost is quadratic: 3000 to 2000 is about 2.25x faster. Raise it if crop edges land slightly inside or outside the photo.",
			"optional": true,
			"default": 4500,
			"minimum": 800,
			"maximum": 8000
		},
		"scan_cropper.detail.maxDepth": {
			"type": "integer",
			"title": "Separate touching photos",
			"description": "Photos mounted edge to edge look like one shape and have to be cut apart; this is how many times a shape may be cut. Set to 0 when your photos never touch - it switches off the most expensive part of the search and is by far the biggest speed win. Raise it if a row of several touching photos comes out as one image.",
			"optional": true,
			"default": 6,
			"minimum": 0,
			"maximum": 8
		},
		"scan_cropper.detail.tune": {
			"type": "boolean",
			"title": "Show advanced settings",
			"description": "Reveals every value this scan type uses, filled in with its own numbers, so you can start from it and adjust one thing rather than setting all ten from scratch.",
			"default": false,
			"enum": [
				[true, "Yes"],
				[false, "No"]
			],
			"conditional": [
				{
					"value": true,
					"properties": [
						"scan_cropper.qualityTolerance",
						"scan_cropper.detail.detectSize",
						"scan_cropper.texture",
						"scan_cropper.minArea",
						"scan_cropper.maxArea",
						"scan_cropper.maxAspect",
						"scan_cropper.minRelative",
						"scan_cropper.detail.maxDepth",
						"scan_cropper.skew",
						"scan_cropper.ratioTolerance"
					]
				},
				{
					"value": false,
					"properties": []
				}
			]
		},
		"scan_cropper.detail": {
			"object": "detail",
			"properties": ["scan_cropper.deskew", "scan_cropper.quality", "scan_cropper.detail.tune"]
		},
		"scan_cropper.qualityTolerance": {
			"type": "number",
			"title": "File size vs quality (dB)",
			"description": "Only used when JPEG quality is 'auto'. How much final quality to give up in exchange for smaller files. 0.2 keeps files large and near-perfect, 1.0 makes them roughly half the size with a difference you would struggle to see. Measured on a 33-page album: 657 MB at 0.2, 463 MB at 0.5, 330 MB at 1.0.",
			"optional": true,
			"default": 0.5,
			"minimum": 0.2,
			"maximum": 1.5
		},
		"scan_cropper.detectSize": {
			"type": "integer",
			"title": "Detection size (px)",
			"description": "How big a copy of the scan the search for photos runs on. Your crops are always cut from the full-resolution original, so this only trades speed against how precisely photo edges are located. It is the main speed control and the cost is quadratic: 3000 to 2000 is about 2.25x faster. Raise it if crop edges land slightly inside or outside the photo.",
			"optional": true,
			"default": 3000,
			"minimum": 800,
			"maximum": 8000
		},
		"scan_cropper.texture": {
			"type": "number",
			"title": "Page smoothness",
			"description": "How smooth an area has to be before it counts as empty page rather than part of a photo. RAISE this if the page itself is being detected as photos (grainy, patterned or fabric-covered pages). LOWER it if a photo with large flat areas - a plain sky, a studio backdrop - is being cut short or missed.",
			"optional": true,
			"default": 4.0,
			"minimum": 0.5,
			"maximum": 50
		},
		"scan_cropper.minArea": {
			"type": "number",
			"title": "Smallest photo to keep",
			"description": "Ignore anything smaller than this share of the whole scan. 0.005 means half a percent of the page. Lower it if small photos or stamps are being missed; raise it if specks and dust are coming out as tiny crops.",
			"optional": true,
			"default": 0.005,
			"minimum": 0.0001,
			"maximum": 0.5
		},
		"scan_cropper.maxArea": {
			"type": "number",
			"title": "Largest photo to keep",
			"description": "Ignore anything larger than this share of the whole scan. Kept below 1.0 so that failing to find the photos returns nothing rather than handing you the entire page as one giant 'photo'. You rarely need to change this.",
			"optional": true,
			"default": 0.95,
			"minimum": 0.5,
			"maximum": 1.0
		},
		"scan_cropper.maxAspect": {
			"type": "number",
			"title": "Longest allowed shape",
			"description": "How stretched a rectangle may be before it is rejected as not a photo, measured as long side divided by short side. 5.0 comfortably allows panoramas. Lower it if strips of page edge or scanner lid are being picked up as photos.",
			"optional": true,
			"default": 5.0,
			"minimum": 1.0,
			"maximum": 20
		},
		"scan_cropper.minRelative": {
			"type": "number",
			"title": "Discard small leftovers",
			"description": "Throws away finds much smaller than the biggest photo on the page, on the assumption they are torn-off pieces of one photo rather than photos in their own right. 0.4 means 'drop anything under 40% of the largest'. Lower it, or set 0 to keep everything, when one page genuinely holds photos of very different sizes.",
			"optional": true,
			"default": 0.4,
			"minimum": 0.0,
			"maximum": 1.0
		},
		"scan_cropper.maxDepth": {
			"type": "integer",
			"title": "Separate touching photos",
			"description": "Photos mounted edge to edge look like one shape and have to be cut apart; this is how many times a shape may be cut. Set to 0 when your photos never touch - it switches off the most expensive part of the search and is by far the biggest speed win. Raise it if a row of several touching photos comes out as one image.",
			"optional": true,
			"default": 4,
			"minimum": 0,
			"maximum": 8
		},
		"scan_cropper.skew": {
			"type": "number",
			"title": "Tilt allowance when separating (degrees)",
			"description": "How crooked the join between two touching photos may be and still be found. NOT a speed setting - lowering it narrows the search without saving any time, because the number of angles tried does not drop below five. Raise it only if touching photos on a visibly crooked scan are not being separated.",
			"optional": true,
			"default": 1.5,
			"minimum": 0.1,
			"maximum": 10
		},
		"scan_cropper.ratioTolerance": {
			"type": "number",
			"title": "Print shape tolerance (%)",
			"description": "Used only when deciding whether a shape is two touching photos or one whole photo: how far the pieces may sit from a standard print shape (6x4, 5x7, square and so on). It never rejects a photo on its own, so an unusual shape is still kept. Raise it if photos that should be split are staying joined; lower it if one photo is being cut in half.",
			"optional": true,
			"default": 8.0,
			"minimum": 0.0,
			"maximum": 50
		}
	},
	//
	// Required:
	//		Defines the fields (shape) of the service. Either source or target
	//		map be specified, or both, but at least one is required
	//
	"shape": [
		{
			"section": "Pipe",
			"title": "Scan Cropper",
			"properties": ["scan_cropper.profile"]
		}
	],
	//
	// Optional:
	//		Declarative test. detectSize is lowered to 800 on purpose: the fixture
	//		is 1200x1600, so at the default 3000 it would never be downscaled and
	//		the test would skip the downscale-detect-and-scale-back path, which is
	//		the property the whole design rests on.
	//
	"test": {
		"outputs": ["image", "text"],
		"timeout": 120,
		"config": {
			"album": {
				"detectSize": 800
			}
		},
		"cases": [
			{
				"name": "Split a three-photo album page",
				"image": "images/scan_album_3up.png",
				"expect": {
					"image": {
						"notEmpty": true
					},
					"text": {
						"contains": "\"count\": 3"
					}
				}
			}
		]
	}
}
