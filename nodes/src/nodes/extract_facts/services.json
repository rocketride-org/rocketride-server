{
	//
	// Required:
	//		The displayable name of this node
	//
	"title": "Fact Extractor",
	//
	// Required:
	//		The protocol is the endpoint protocol
	//
	"protocol": "extract_facts://",
	//
	// Required:
	//		Class type of the node - what it does
	//
	"classType": ["text"],
	//
	// Required:
	//		Capabilities are flags that change the behavior of the underlying
	//		engine
	//
	"capabilities": [],
	//
	// Optional:
	//		Register is either filter, endpoint or ignored if not specified. If the
	//		type is specified, a factory is registered of that given type
	//
	"register": "filter",
	//
	// Optional:
	//		The node is the actual physical node to instantiate - if
	//		not specified, the protocol will be used
	//
	"node": "python",
	//
	// Optional:
	//		The path is the executable/script code - it is node dependent
	// 		and is optional for most node
	//
	"path": "nodes.extract_facts",
	//
	// Required:
	//		The prefix map when added/removed when convertting URLs <=> paths
	//
	"prefix": "extract_facts",
	//
	// Optional:
	//		Description to of this driver
	//
	"description": ["The extraction brain. Reads document context together with a table cell by cell, ", "and runs a validator pass that double-checks the extracted values on disagreement, ", "reconciling and tie-breaking before emitting fully-qualified facts. Each fact carries ", "the user-configured target fields plus auto-attached provenance (page, table id, row, ", "column, source text, and a confidence score) so downstream consumers can trace every ", "value back to where it came from."],
	//
	//	Optional:
	//	  The icon is the icon to display in the UI for this node
	//
	"icon": "util-text.svg",
	"documentation": "https://docs.rocketride.org",
	//
	//	Optional:
	//		As a pipe component, define what this pipe component takes
	//		and what it produces. A single 'llm' invoke lane is used; the
	//		validator is a second prompt pass on this same lane.
	//
	"invoke": {
		"llm": {
			"description": "LLM to use for fact extraction and validation",
			"min": 1
		}
	},
	"lanes": {
		"table": ["answers", "documents"],
		"documents": ["answers", "documents"]
	},
	//
	//	Optional:
	//		Profile section are configuration optoins used by the driver
	//		itself
	//
	"preconfig": {
		// Define the values that will be merged into any profile configuration
		// specified, unless the profile is 'absolute'
		"default": "default",
		// Defines profiles used with the "profile": key
		"profiles": {
			"default": {}
		}
	},
	//
	// Optional:
	//		Local fields definitions - these define fields only for the
	//		current service. You may specify them here, or directly
	//		in the shape
	//
	"fields": {
		"facts.column": {
			"type": "string",
			"title": "Field",
			"default": "field",
			"minLength": 2,
			"maxLength": 32,
			"description": "Name of the target fact field"
		},
		"facts.type": {
			"type": "string",
			"title": "Type",
			"default": "text",
			"enum": [
				["text", "Text"],
				["decimal", "Number"],
				["int", "Integer"],
				["date", "Date"],
				["time", "Time"],
				["datetime", "DateTime"],
				["timestamp", "Timestamp"],
				["binary", "Binary"],
				["json", "JSON"],
				["html", "HTML"],
				["url", "URL"],
				["email", "Email"],
				["phone", "Phone"],
				["ipv4", "IPv4"],
				["ipv6", "IPv6"],
				["uuid", "UUID"],
				["guid", "GUID"]
			]
		},
		"facts.defval": {
			"optional": true,
			"type": "string",
			"title": "Default Value",
			"default": ""
		},
		"facts.fields": {
			"type": "array",
			"minItems": 1,
			"maxItems": 32,
			"items": {
				"type": "object",
				"properties": ["facts.column", "facts.type", "facts.defval"]
			}
		},
		"facts.validate": {
			"type": "boolean",
			"title": "Validate",
			"description": "Run a second validator prompt pass that double-checks extracted facts and reconciles on disagreement.",
			"default": true,
			"enum": [
				[true, "Yes"],
				[false, "No"]
			]
		},
		"facts.include_provenance": {
			"type": "boolean",
			"title": "Include Provenance",
			"description": "Auto-attach provenance (page, table id, row, column, source text, confidence) to every emitted fact.",
			"default": true,
			"enum": [
				[true, "Yes"],
				[false, "No"]
			]
		},
		"facts.default": {
			"object": "default",
			"properties": ["facts.fields", "facts.validate", "facts.include_provenance"]
		},
		"facts.profile": {
			"hidden": true,
			"type": "string",
			"default": "default",
			"enum": [["default", "Default"]],
			"conditional": [
				{
					"value": "default",
					"properties": ["facts.default"]
				}
			]
		}
	},
	//
	// Required:
	//		Defines the fields (shape) of the service. Either source or target
	//		map be specified, or both, but at least one is required
	//
	"shape": [
		{
			"section": "Pipe",
			"title": "Fact Extract",
			"properties": ["facts.profile"]
		}
	]
}
