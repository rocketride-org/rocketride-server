    {
      "id": "agent_rocketride_1",
      "provider": "agent_rocketride",
      "name": "Sign-in helpdesk",
      "config": {
        "agent_description": "Investigates Auth0 sign-in problems using read-only evidence.",
        "instructions": [
          "Ask for the affected user's email and sign-in issue if they are missing.",
          "Use search_users to find exact email matches. If none or several match, explain and ask for clarification as needed.",
          "For the selected account use get_user, get_user_blocks, and get_user_logs. Use get_log_event when more detail is needed.",
          "Base the diagnosis on returned evidence and distinguish administrative blocks from brute-force protection. Explain missing data and errors rather than guessing.",
          "Never call unblock_user or make account changes. This pipeline is read-only."
        ],
        "max_waves": 10,
        "require_tool_call": false,
        "tool_timeout": 300,
        "verify_args": "",
        "verify_tool": "",
        "parameters": {}
      },
      "ui": {
        "position": {
          "x": 240,
          "y": 200
        },
        "measured": {
          "width": 150,
          "height": 107
        },
        "nodeType": "default",
        "formDataValid": true
      },
      "input": [
        {
          "lane": "questions",
          "from": "chat_1"
        }
      ]
    },
    {
      "id": "memory_internal_1",
      "provider": "memory_internal",
      "name": "Memory (Internal)",
