{
	//
	// Required:
	//		The displayable name of this node
	//
	"title": "MiniMax",
	//
	// Required:
	//		The protocol is the endpoint protocol
	//
	"protocol": "llm_minimax://",
	//
	// Required:
	//		Class type of the node - what it does
	//
	"classType": ["llm"],
	//
	// Required:
	//		Capabilities are flags that change the behavior of the underlying
	//		engine
	//
	"capabilities": ["invoke"],
	//
	// Optional:
	//		Register is either filter, endpoint or ignored if not specified. If the
	//		type is specified, a factory is registered of that given type
	//
	"register": "filter",
	//
	// Optional:
	//		The node is the actual physical node to instantiate - if
	//		not specified, the protocol will be used
	//
	"node": "python",
	//
	// Optional:
	//		The path is the executable/script code - it is node dependent
	//		and is optional for most node
	//
	"path": "nodes.llm_minimax",
	//
	// Required:
	//		The prefix map when added/removed when converting URLs <=> paths
	//
	"prefix": "llm",
	//
	// Optional:
	//		Description of this driver
	//
	"description": [
		"A component that connects to MiniMax's large language models for advanced ",
		"natural language processing. It enables capabilities like long-context reasoning, ",
		"agentic workflows, multi-step tool use, and high-quality conversational generation. ",
		"MiniMax offers an OpenAI-compatible API with strong performance across reasoning, ",
		"writing, and coding tasks. The component is suitable for integrating MiniMax models ",
		"into pipelines where extended context windows and efficient inference are important."
	],
	//
	// Optional:
	//		The icon is the icon to display in the UI for this node
	//
	"icon": "minimax.svg",
	"documentation": "https://docs.rocketride.org/nodes/llm_minimax",
	//
	// Optional:
	//		Rendering hints to the UI which indicate which fields of
	//		the configuration should be used to display information
	//
	"tile": ["Model: ${parameters.llm_minimax.model}"],
	//
	// Optional:
	//		As a pipe component, define what this pipe component takes
	//		and what it produces
	//
	"lanes": {
		"questions": ["answers"]
	},
	//
	// Optional:
	//		Local property definitions. The model is the selector (one branch per
	//		model, the branch value is the model id); each branch pins its context
	//		window and capabilities as constants, and the leaves every model shares
	//		(credentials, generation settings) sit at the root and are stored flat.
	//		The "custom" branch takes a model id the catalog does not list.
	//
	"propertyDefinitions": {
		"llm_minimax.apikey": {
			"base": "llm.cloud.apikey",
			"description": "MiniMax API key (cloud models; local models need none)",
			"env": "ROCKETRIDE_LLM_MINIMAX_APIKEY",
			"required": false
		},
		"llm_minimax.customModel": {
			"type": "string",
			"title": "Model id",
			"description": "Model id exactly as the provider names it",
			"required": true
		},
		"llm_minimax.custom.modelTotalTokens": { "type": "number", "title": "Tokens", "description": "Total Tokens", "minimum": 1, "default": 200000 },
		"llm_minimax.custom.modelOutputTokens": {
			"type": "integer",
			"title": "Output Tokens",
			"description": "Most tokens the model may write in one reply (at least 1,024). Leave it empty to keep the node's default. Reasoning models count their thinking against this limit: set it well above the reply you expect, or they can spend it all thinking and return nothing. It cannot exceed Tokens; a larger value is lowered to it.",
			"minimum": 1024,
			"default": 65536
		},
		"llm_minimax.custom.serverbase": {
			"type": "string",
			"title": "Server URL",
			"description": "Base URL of the OpenAI-compatible endpoint serving the model",
			"default": "https://api.minimax.io/v1"
		}
	},
	//
	// Required:
	//		Defines the properties shown in the pipeline builder side panel, in order
	//
	"properties": [
		{
			"name": "model",
			"type": "string",
			"title": "Model",
			"description": "MiniMax LLM model",
			"default": "MiniMax-M2",
			"enum": {
				"MiniMax-M2": {
					"title": "MiniMax M2",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 204800 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 65536 },
						{ "name": "reasoning", "type": "constant", "default": true },
						{ "name": "serverbase", "type": "constant", "default": "https://api.minimax.io/v1" }
					]
				},
				"MiniMax-M2.1": {
					"title": "MiniMax M2.1",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 204800 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 65536 },
						{ "name": "reasoning", "type": "constant", "default": true },
						{ "name": "serverbase", "type": "constant", "default": "https://api.minimax.io/v1" }
					]
				},
				"MiniMax-M2.1-highspeed": {
					"title": "MiniMax M2.1 Highspeed",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 204800 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 65536 },
						{ "name": "serverbase", "type": "constant", "default": "https://api.minimax.io/v1" }
					]
				},
				"MiniMax-M2.5": {
					"title": "MiniMax M2.5",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 204800 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 65536 },
						{ "name": "reasoning", "type": "constant", "default": true },
						{ "name": "serverbase", "type": "constant", "default": "https://api.minimax.io/v1" }
					]
				},
				"MiniMax-M2.5-highspeed": {
					"title": "MiniMax M2.5 Highspeed",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 204800 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 65536 },
						{ "name": "serverbase", "type": "constant", "default": "https://api.minimax.io/v1" }
					]
				},
				"MiniMax-M2.7": {
					"title": "MiniMax M2.7",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 204800 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 65536 },
						{ "name": "reasoning", "type": "constant", "default": true },
						{ "name": "serverbase", "type": "constant", "default": "https://api.minimax.io/v1" }
					]
				},
				"MiniMax-M2.7-highspeed": {
					"title": "MiniMax M2.7 Highspeed",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 204800 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 65536 },
						{ "name": "serverbase", "type": "constant", "default": "https://api.minimax.io/v1" }
					]
				},
				"MiniMaxAI/MiniMax-M2": {
					"title": "MiniMax M2 (Local)",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 204800 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 8192 },
						{ "base": "llm.local.serverbase", "default": "http://localhost:8000/v1" }
					]
				},
				"MiniMaxAI/MiniMax-M2.5": {
					"title": "MiniMax M2.5 (Local)",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 204800 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 8192 },
						{ "base": "llm.local.serverbase", "default": "http://localhost:8000/v1" }
					]
				},
				"MiniMaxAI/MiniMax-M2.7": {
					"title": "MiniMax M2.7 (Local)",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 204800 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 8192 },
						{ "base": "llm.local.serverbase", "default": "http://localhost:8000/v1" }
					]
				},
				"MiniMax-M3": {
					"title": "MiniMax M3",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 1000000 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 131072 },
						{ "name": "reasoning", "type": "constant", "default": true },
						{ "name": "serverbase", "type": "constant", "default": "https://api.minimax.io/v1" }
					]
				},
				"minimax-01": {
					"title": "MiniMax: MiniMax-01",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 1000192 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 900172 },
						{ "name": "serverbase", "type": "constant", "default": "https://api.minimax.io/v1" }
					]
				},
				"minimax-m1": {
					"title": "MiniMax: MiniMax M1",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 1000000 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 40000 },
						{ "name": "reasoning", "type": "constant", "default": true },
						{ "name": "serverbase", "type": "constant", "default": "https://api.minimax.io/v1" }
					]
				},
				"minimax-m2-her": {
					"title": "MiniMax: MiniMax M2-her",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 65536 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 2048 },
						{ "name": "serverbase", "type": "constant", "default": "https://api.minimax.io/v1" }
					]
				},
				"minimax-m2.7:free": {
					"title": "MiniMax: MiniMax M2.7 (free) (deprecated)",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 196608 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 176947 },
						{ "name": "reasoning", "type": "constant", "default": true },
						{ "name": "serverbase", "type": "constant", "default": "https://api.minimax.io/v1" }
					]
				},
				"minimax-m3:batch": {
					"title": "MiniMax: MiniMax M3 (batch) (deprecated)",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 524288 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 471859 },
						{ "name": "reasoning", "type": "constant", "default": true },
						{ "name": "serverbase", "type": "constant", "default": "https://api.minimax.io/v1" }
					]
				},
				"minimax-m3:free": {
					"title": "MiniMax: MiniMax M3 (free) (deprecated)",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 1048576 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 943718 },
						{ "name": "reasoning", "type": "constant", "default": true },
						{ "name": "serverbase", "type": "constant", "default": "https://api.minimax.io/v1" }
					]
				},
				"custom": {
					"title": "Custom model",
					"properties": [
						"llm_minimax.customModel",
						"llm_minimax.custom.modelTotalTokens",
						"llm_minimax.custom.modelOutputTokens",
						"llm_minimax.custom.serverbase"
					]
				}
			}
		},
		"llm_minimax.apikey"
	],
	//
	// Optional:
	//		Test configuration for automated node testing. "profiles" lists
	//		values of the "model" selector; the framework writes the selected one
	//		at "model" and the mock credentials at their paths.
	//
	"test": {
		"profiles": ["MiniMax-M2"],
		"outputs": ["answers"],
		"cases": [
			{
				"name": "LLM returns mock response",
				"text": "What is 2+2?",
				"expect": {
					"answers": { "contains": "Mock LLM response" }
				}
			}
		]
	}
}
