{
	//
	// Required:
	//		The displayable name of this node
	//
	"title": "Listener",
	//
	// Required:
	//		The protocol is the endpoint protocol
	//
	"protocol": "listener://",
	//
	// Required:
	//		Class type of the node - what it does
	//
	"classType": ["source"],
	//
	// Required:
	//		Capabilities are flags that change the behavior of the underlying
	//		engine
	//
	"capabilities": ["noinclude"],
	//
	// Optional:
	//		Register is either filter, endpoint or ignored if not specified. If the
	//		type is specified, a factory is registered of that given type
	//
	"register": "endpoint",
	//
	// Optional:
	//		The node is the actual physical node to instantiate - if
	//		not specified, the protocol will be used
	//
	"node": "python",
	//
	// Optional:
	//		The path is the executable/script code - it is node dependent
	//		and is optional for most nodes
	//
	"path": "nodes.listener",
	//
	// Required:
	//		The prefix map when added/removed when converting URLs <=> paths
	//
	"prefix": "Listener",
	//
	// Optional:
	//		Description of this driver
	//
	"description": ["Wakes this pipeline when a message arrives on a source it listens to, and hands each one to the pipeline as a question. ", "The first source is LaserData: the pipeline becomes an agent that works through its LaserData inbox, replies to whoever sent each task, and resumes where it stopped after a restart."],
	//
	// Optional:
	//	  The icon is the icon to display in the UI for this node
	//
	"icon": "listener.svg",
	"documentation": "https://docs.rocketride.org/nodes/listener",
	//
	// Optional:
	//	 The tile is the displayable name of this node
	//
	"tile": ["Agent: ${parameters.listener.agent_id}"],
	//
	//	Optional:
	//		As a pipe component, define what this pipe component takes
	//		and what it produces
	//
	"lanes": {
		"_source": ["questions"]
	},
	//
	//	Optional:
	//		Profile section are configuration options used by the driver itself
	//
	"preconfig": {
		"default": "default",
		"profiles": {
			"default": {}
		}
	},
	//
	// Optional:
	//		Local field definitions - these define fields only for the
	//		current service. The Source dropdown reveals that adapter's fields.
	//
	"fields": {
		"listener.source": {
			"type": "string",
			"title": "Source",
			"description": "What to listen to.",
			"enum": [["laserdata", "LaserData"]],
			"default": "laserdata",
			"conditional": [
				{
					"value": "laserdata",
					"properties": ["listener.connection_string", "listener.agent_id", "listener.stream", "listener.max_attempts"]
				}
			]
		},
		"listener.connection_string": {
			"type": "string",
			"title": "Connection string",
			"description": "LaserData endpoint as <code>user:password@host:port</code>; a <code>*.laserdata.cloud</code> host without a port gets :8090. Falls back to the LASER_CONNECTION_STRING environment variable when blank.",
			"default": "",
			"optional": true,
			"secure": true,
			"ui": {
				"ui:widget": "ApiKeyWidget"
			}
		},
		"listener.agent_id": {
			"type": "string",
			"title": "Agent id",
			"description": "This agent's id: it listens on <code>agent.&lt;id&gt;.inbox</code>. Lowercase letters, digits, - or _. Must match the LaserData tool node's Agent id in the same pipeline.",
			"default": ""
		},
		"listener.stream": {
			"type": "string",
			"optional": true,
			"title": "Stream",
			"description": "LaserData stream the agent topics live in. Must match the LaserData tool node's stream.",
			"default": "rocketride-memory"
		},
		"listener.max_attempts": {
			"type": "integer",
			"optional": true,
			"title": "Max attempts",
			"description": "How many times a task is retried when the pipeline fails on it before it is moved to the dead-letter topic.",
			"default": 3,
			"minimum": 1,
			"maximum": 20
		},
		"Pipe.source.parameters": {
			"section": "parameters",
			"title": "Listener",
			"properties": ["listener.source"]
		}
	},
	//
	// Required:
	//		Defines the fields (shape) of the service.
	//
	"shape": [
		{
			"section": "Pipe",
			"title": "Listener",
			"properties": ["type", "Pipe.source.parameters"]
		}
	]
}
