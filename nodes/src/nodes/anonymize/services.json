{
	//
	// Required:
	//		The displayable name of this node
	//
	"title": "Anonymize",
	//
	// Required:
	//		The protocol is the endpoint protocol
	//
	"protocol": "anonymize_text://",
	//
	// Required:
	//		Class type of the node - what it does
	//
	"classType": ["text"],
	//
	// Required:
	//		Capabilities are flags that change the behavior of the underlying
	//		engine
	//
	"capabilities": ["gpu"],
	//
	// Optional:
	//		Register is either filter, endpoint or ignored if not specified. If the
	//		type is specified, a factory is registered of that given type
	//
	"register": "filter",
	//
	// Optional:
	//		The node is the actual physical node to instantiate - if
	//		not specified, the protocol will be used
	//
	"node": "python",
	//
	// Optional:
	//		The path is the executable/script code - it is node dependent
	// 		and is optional for most node
	//
	"path": "nodes.anonymize",
	//
	// Required:
	//		The prefix map when added/removed when convertting URLs <=> paths
	//
	"prefix": "anonymize_text",
	//
	// Optional:
	//		Description to of this driver
	//
	"description": ["A filter component that ", "identifies and masks sensitive information in text data. It can be configured ", "to detect and redact personally identifiable information (PII), maintaining ", "data privacy while preserving document context.</br>", "</br>", "<b>Note</b>: This component uses AI so 100% accuracy is not guaranteed. It is recommended to review the results."],
	//
	// Optional:
	//	  The icon is the icon to display in the UI for this node
	//
	"icon": "util-text.svg",
	"documentation": "https://docs.rocketride.org/nodes/anonymize",
	//
	//
	//	Optional:
	//		As a pipe component, define what this pipe component takes
	//		and what it produces
	//
	"lanes": {
		"text": ["text"]
	},
	//
	//	Test configuration for automated node testing. "profiles" lists
	//	values of the "profile" selector; the framework writes the selected
	//	one at "profile".
	//
	"test": {
		"profiles": ["glinerSmall"],
		"requiresHardware": { "cuda": { "vramGb": 2 }, "mps": { "ramGb": 4 }, "cpu": { "ramGb": 4 } },
		"cases": [
			{
				"text": "My name is John Smith and my email is john.smith@example.com. Please contact me at 555-123-4567.",
				"expect": {
					"text": {
						"contains": "█"
					}
				}
			}
		]
	},
	//
	//	Full test configuration - tests all available profiles.
	//	Run via: builder nodes:test-full
	//
	"fulltest": [
		{
			"profiles": ["glinerSmall", "glinerMedium", "glinerLarge", "glinerMultiPII", "glinerPIILarge", "glinerMergedLarge", "glinerMulti", "gretelSmall", "gretelLarge", "glinerKo", "glinerIt", "glinerAr", "glinerCommunitySmall", "glinerCommunityMedium", "glinerCommunityLarge", "glinerBiomedSmall", "glinerBiomedLarge"],
			"requiresHardware": { "cuda": { "vramGb": 4 }, "mps": { "ramGb": 8 }, "cpu": { "ramGb": 8 } },
			"cases": [
				{
					"text": "My name is John Smith and my email is john.smith@example.com. Please contact me at 555-123-4567.",
					"expect": {
						"text": {
							"contains": "█"
						}
					}
				}
			]
		}
	],
	//
	// Optional:
	//		Local property definitions. The model profile is the selector:
	//		every shipped profile pins its GLiNER model as a constant, the
	//		"custom" profile takes the model name as a field. anonymizeChar is
	//		the shared definition from services.common.anonymize.json.
	//
	"propertyDefinitions": {
		"anonymize.custom.model": {
			"type": "string",
			"title": "Model name",
			"description": "GLiNER model to use for anonymization (a Hugging Face model id)",
			"minLength": 2,
			"maxLength": 128,
			"required": true
		},
		"anonymize.entityTypes": {
			"type": "array",
			"title": "Entity types to anonymize",
			"description": "PII / entity types to detect and mask. Pre-filled with common types; remove any you don't want, or add your own (the model is zero-shot, so any label works).",
			"item": { "name": "entityType", "type": "string" },
			"default": [
				"person",
				"name",
				"email",
				"phone number",
				"address",
				"social security number",
				"credit card number",
				"date of birth",
				"organization",
				"company",
				"location",
				"ip address",
				"bank account",
				"passport number",
				"driver license"
			]
		},
		"anonymize.redactionStyle": {
			"type": "string",
			"title": "Redaction style",
			"description": "How detected entities are replaced. 'mask' overwrites each entity with the anonymization character (████). 'token' replaces each entity with a labelled tag like [PERSON] or [EMAIL].",
			"default": "mask",
			"enum": [
				["mask", "Mask with the anonymization character"],
				["token", "Replace with a labelled tag"]
			]
		}
	},
	//
	// Required:
	//		Defines the properties shown in the pipeline builder side panel, in order
	//
	"properties": [
		{
			"name": "profile",
			"type": "string",
			"title": "Model",
			"description": "Anonymize model",
			"default": "glinerMergedLarge",
			"enum": {
				"custom": {
					"title": "Custom model",
					"properties": ["anonymize.custom.model"]
				},
				"glinerMergedLarge": {
					"title": "GLiNER Merged Large - Combined model from multiple datasets",
					"properties": [{ "name": "model", "type": "constant", "default": "xomad/gliner-model-merge-large-v1.0" }]
				},
				"glinerMultiPII": {
					"title": "GLiNER Multi PII - Multilingual PII model",
					"properties": [{ "name": "model", "type": "constant", "default": "urchade/gliner_multi_pii-v1" }]
				},
				"glinerPIILarge": {
					"title": "GLiNER PII Large - High-accuracy English PII",
					"properties": [{ "name": "model", "type": "constant", "default": "knowledgator/gliner-pii-large-v1.0" }]
				},
				"glinerSmall": {
					"title": "GLiNER Small - Lightweight general-purpose model",
					"properties": [{ "name": "model", "type": "constant", "default": "urchade/gliner_small-v2.1" }]
				},
				"glinerMedium": {
					"title": "GLiNER Medium - Balanced performance",
					"properties": [{ "name": "model", "type": "constant", "default": "urchade/gliner_medium-v2.1" }]
				},
				"glinerLarge": {
					"title": "GLiNER Large - Best accuracy, more resources",
					"properties": [{ "name": "model", "type": "constant", "default": "urchade/gliner_large-v2.1" }]
				},
				"glinerMulti": {
					"title": "GLiNER Multi - Multilingual support",
					"properties": [{ "name": "model", "type": "constant", "default": "urchade/gliner_multi" }]
				},
				"gretelSmall": {
					"title": "Gretel GLiNER Bi-Small - Business-oriented NER",
					"properties": [{ "name": "model", "type": "constant", "default": "gretelai/gretel-gliner-bi-small-v1.0" }]
				},
				"gretelLarge": {
					"title": "Gretel GLiNER Bi-Large - For large-scale anonymization",
					"properties": [{ "name": "model", "type": "constant", "default": "gretelai/gretel-gliner-bi-large-v1.0" }]
				},
				"glinerKo": {
					"title": "GLiNER Korean - Korean language support",
					"properties": [{ "name": "model", "type": "constant", "default": "taeminlee/gliner_ko" }]
				},
				"glinerIt": {
					"title": "GLiNER Italian - For Italian entity extraction",
					"properties": [{ "name": "model", "type": "constant", "default": "DeepMount00/GLiNER_PII_ITA" }]
				},
				"glinerAr": {
					"title": "GLiNER Arabic - Arabic language support",
					"properties": [{ "name": "model", "type": "constant", "default": "NAMAA-Space/gliner_arabic-v2.1" }]
				},
				"glinerCommunitySmall": {
					"title": "GLiNER Small v2.5 - Community edition",
					"properties": [{ "name": "model", "type": "constant", "default": "gliner-community/gliner_small-v2.5" }]
				},
				"glinerCommunityMedium": {
					"title": "GLiNER Medium v2.5 - Community edition",
					"properties": [{ "name": "model", "type": "constant", "default": "gliner-community/gliner_medium-v2.5" }]
				},
				"glinerCommunityLarge": {
					"title": "GLiNER Large v2.5 - Community edition",
					"properties": [{ "name": "model", "type": "constant", "default": "gliner-community/gliner_large-v2.5" }]
				},
				"glinerBiomedSmall": {
					"title": "GLiNER Biomed Small - Compact biomedical model",
					"properties": [{ "name": "model", "type": "constant", "default": "Ihor/gliner-biomed-small-v1.0" }]
				},
				"glinerBiomedLarge": {
					"title": "GLiNER Biomed Large - High accuracy biomedical model",
					"properties": [{ "name": "model", "type": "constant", "default": "Ihor/gliner-biomed-large-v1.0" }]
				}
			}
		},
		"anonymizeChar",
		"anonymize.entityTypes",
		"anonymize.redactionStyle"
	]
}
