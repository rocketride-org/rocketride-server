{
	"title": "Object Detection",
	"protocol": "detect://",
	"classType": ["image"],
	"capabilities": ["gpu", "experimental"],
	"register": "filter",
	"node": "python",
	"path": "nodes.detect",
	"prefix": "detect",
	"description": ["Per-frame object detection. RF-DETR (Apache-2.0, default) is a fast closed-set detector over 80 COCO classes (person, car, dog, etc.). MM-Grounding-DINO (Apache-2.0/BSD-3) is the open-vocab option: type a prompt to detect anything. ", "Image in, bounding boxes + labels + centroids out. ", "Use as a fast per-frame gate before heavier models. For pixel masks use Segmentation."],
	"icon": "detect.svg",
	"documentation": "https://docs.rocketride.org/nodes/detect",
	"tile": ["Model: ${parameters.detect.profile}", "Prompt: ${parameters.detect.prompt}"],
	"lanes": {
		"image": ["text", "image"]
	},
	"input": [
		{
			"lane": "image",
			"description": "AVI image stream to run detection on.",
			"output": [
				{
					"lane": "image",
					"description": "Annotated image as raw stream - pipe to any node accepting image input."
				},
				{
					"lane": "text",
					"description": "JSON array of detections: [{label, score, box, centroid}]."
				}
			]
		}
	],
	//
	// Optional:
	//		Local property definitions. The model is the selector; each
	//		profile pins its backend engine as a constant. The threshold is
	//		shared by every model (one definition referenced in every
	//		branch, so it hoists beside the selector); the prompt exists
	//		only for the open-vocabulary model and is required there.
	//
	"propertyDefinitions": {
		"detect.threshold": {
			"type": "number",
			"title": "Confidence threshold",
			"description": "Minimum confidence score (0.0-1.0) to include a detection",
			"default": 0.3,
			"minimum": 0.0,
			"maximum": 1.0
		},
		"detect.prompt": {
			"type": "string",
			"format": "textarea",
			"title": "Detection prompt",
			"description": "Example: \"person . car . dog\" (period or comma-separated list) or \"red car\" / \"person in a hat\" (described object). Returns all matching regions. Matches objects and attributes, not spatial relationships, so \"the car on the left\" returns all cars, not just the left one.",
			"required": true,
			"minLength": 1
		}
	},
	//
	// Required:
	//		Defines the properties shown in the pipeline builder side panel, in order
	//
	"properties": [
		{
			"name": "profile",
			"type": "string",
			"title": "Model",
			"default": "rfdetr",
			"enum": {
				"rfdetr": {
					"title": "RF-DETR - Common Objects (COCO, 80 classes, default)",
					"properties": [{ "name": "engine", "type": "constant", "default": "rfdetr" }, "detect.threshold"]
				},
				"mmgdino": {
					"title": "MM-Grounding-DINO - Open-Vocabulary (any prompt)",
					"properties": [
						{ "name": "engine", "type": "constant", "default": "mmgdino" },
						"detect.prompt",
						"detect.threshold"
					]
				}
			}
		}
	],
	//
	//	Test configuration for automated node testing. "profiles" lists
	//	values of the "profile" selector; a group's "config" is the node
	//	config in its stored shape (the prompt lives under "mmgdino").
	//
	"test": {
		"profiles": ["rfdetr"],
		"requiresHardware": { "cuda": { "vramGb": 2 }, "mps": { "ramGb": 4 }, "cpu": { "ramGb": 4 } },
		"outputs": ["text"],
		"timeout": 180,
		"cases": [
			{
				"name": "Detect a person in a portrait",
				"image": "images/einstein.jpg",
				"expect": {
					"text": { "notEmpty": true, "contains": "person" }
				}
			}
		]
	},
	"fulltest": [
		{
			"profiles": ["rfdetr"],
			"requiresHardware": { "cuda": { "vramGb": 2 }, "mps": { "ramGb": 4 }, "cpu": { "ramGb": 4 } },
			"outputs": ["text"],
			"timeout": 180,
			"cases": [
				{
					"name": "RF-DETR detects a person in a portrait",
					"image": "images/einstein.jpg",
					"expect": {
						"text": { "notEmpty": true, "contains": "person" }
					}
				}
			]
		},
		{
			"profiles": ["mmgdino"],
			"requiresHardware": { "cuda": { "vramGb": 3 }, "mps": { "ramGb": 6 }, "cpu": { "ramGb": 6 } },
			"config": { "mmgdino": { "prompt": "person . face" } },
			"outputs": ["text"],
			"timeout": 180,
			"cases": [
				{
					"name": "Grounding-DINO detects its prompt classes",
					"image": "images/einstein.jpg",
					"expect": {
						"text": { "notEmpty": true }
					}
				}
			]
		}
	]
}
