{
	//
	// Required:
	//		The displayable name of this node
	//
	"title": "Discord Bot",
	//
	// Required:
	//		The protocol is the endpoint protocol
	//
	"protocol": "discord://",
	//
	// Required:
	//		Class type of the node - what it does
	//
	"classType": ["source"],
	//
	// Required:
	//		Capabilities are flags that change the behavior of the underlying
	//		engine
	//
	"capabilities": ["noinclude"],
	//
	// Optional:
	//		Register is either filter, endpoint or ignored if not specified. If the
	//		type is specified, a factory is registered of that given type
	//
	"register": "endpoint",
	//
	// Optional:
	//		The node is the actual physical node to instantiate - if
	//		not specified, the protocol will be used
	//
	"node": "python",
	//
	// Optional:
	//		The path is the executable/script code - it is node dependent
	//		and is optional for most nodes
	//
	"path": "nodes.discord",
	//
	// Required:
	//		The prefix map when added/removed when converting URLs <=> paths
	//
	"prefix": "Discord",
	//
	// Optional:
	//		Description of this driver
	//
	"description": [
		"A Discord Bot source node that receives messages from channels and DMs via the Discord Gateway. ",
		"Supports text messages and media attachments (images, audio, video, documents). ",
		"Each message type is routed to the appropriate pipeline lane. ",
		"Pipeline responses are automatically sent back as replies to the originating channel or thread. ",
		"Supports message content intent, attachment downloading, reply threading, and long-message chunking."
	],
	//
	// Optional:
	//		The icon is the icon to display in the UI for this node
	//
	"icon": "discord.svg",
	//
	// Optional:
	//		Link to the documentation page for this node
	//
	"documentation": "https://docs.rocketride.org/nodes/discord",
	//
	// Optional:
	//		The tile text shown on the node in the canvas; it reports whether a
	//		bot token is configured, not whether the bot is connected
	//
	"tile": ["Token: ${parameters.discord.botToken ? 'configured' : 'missing'}"],
	//
	// Optional:
	//		As a pipe component, define what this pipe component takes
	//		and what it produces
	//
	"lanes": {
		"_source": ["text", "image", "audio", "video", "tags"]
	},
	//
	// Optional:
	//		Profile section are configuration options used by the driver itself
	//
	"preconfig": {
		"default": "default",
		"profiles": {
			"default": {}
		}
	},
	//
	// Optional:
	//		Local field definitions - these define fields only for the
	//		current service.
	//
	"fields": {
		"discord.botToken": {
			"type": "string",
			"title": "Bot Token",
			"description": "Discord bot token from the Developer Portal (keep this secret - do not share)",
			"optional": false,
			"secure": true,
			"ui": {
				"ui:widget": "ApiKeyWidget"
			}
		},
		"discord.guildIds": {
			"type": "array",
			"items": {"type": "string"},
			"title": "Server IDs (Guild IDs)",
			"description": "List of Discord server IDs to listen to. Leave empty to listen to all servers the bot is in.",
			"optional": true,
			"default": []
		},
		"discord.channelIds": {
			"type": "array",
			"items": {"type": "string"},
			"title": "Channel IDs",
			"description": "List of channel IDs to listen to. Leave empty to listen to all channels.",
			"optional": true,
			"default": []
		},
		"discord.ignoreBots": {
			"type": "boolean",
			"title": "Ignore Bot Messages",
			"description": "If true (default), messages from other bots are ignored to prevent loops.",
			"default": true
		},
		"discord.requireMention": {
			"type": "boolean",
			"title": "Require @Mention",
			"description": "If true, the bot only responds when explicitly @mentioned. If false, responds to all messages.",
			"default": false
		},
		"discord.replyMode": {
			"type": "string",
			"title": "Reply Mode",
			"description": "How the bot sends answers: 'channel' (post as normal message), 'reply' (reply to the message), or 'thread' (post in a thread).",
			"enum": ["channel", "reply", "thread"],
			"default": "reply"
		},
		"discord.showTyping": {
			"type": "boolean",
			"title": "Show Typing Indicator",
			"description": "If true, show a typing indicator while processing the pipeline.",
			"default": true
		},
		"discord.maxAttachmentBytes": {
			"type": "number",
			"title": "Max Attachment Size (bytes)",
			"description": "Maximum size of attachments to download. Larger files are skipped. Default 25 MB, at most 100 MB.",
			"default": 26214400,
			"minimum": 1,
			"maximum": 104857600
		},
		//
		// Bounds how many messages are processed at once (download, pipeline
		// and reply); each holds its downloaded attachments in memory until
		// the pipeline answers. Further messages wait their turn.
		//
		"discord.maxConcurrentMessages": {
			"type": "number",
			"title": "Max Concurrent Messages",
			"description": "How many messages are processed at once. Further messages wait their turn; none are dropped.",
			"default": 4,
			"minimum": 1,
			"maximum": 32,
			"optional": true
		},
		"discord.sendResponses": {
			"type": "boolean",
			"title": "Send Responses",
			"description": "If true, the bot sends pipeline answers back to Discord. If false, only processes messages.",
			"default": true
		},
		"discord.requireMentionChannelIds": {
			"type": "array",
			"items": {"type": "string"},
			"title": "Require Mention Channel IDs",
			"description": "Channels (or thread parent channels) where a direct bot mention is always required.",
			"optional": true,
			"default": []
		},
		"discord.allowedBotIds": {
			"type": "array",
			"items": {"type": "string"},
			"title": "Allowed Bot IDs",
			"description": "Bot user IDs allowed through when Ignore Bot Messages is enabled.",
			"optional": true,
			"default": []
		},
		"discord.allowedMentionRoleIds": {
			"type": "array",
			"items": {"type": "string"},
			"title": "Allowed Mention Role IDs",
			"description": "Role IDs that outbound pipeline responses may mention.",
			"optional": true,
			"default": []
		},
		"discord.allowedMentionUserIds": {
			"type": "array",
			"items": {"type": "string"},
			"title": "Allowed Mention User IDs",
			"description": "User IDs that outbound pipeline responses may mention.",
			"optional": true,
			"default": []
		},
		"discord.threadName": {
			"type": "string",
			"title": "Thread Name",
			"description": "Name template for response threads. {content} is replaced with the triggering message text.",
			"default": "Pipeline Response",
			"optional": true
		},
		"discord.threadNameMaxLength": {
			"type": "number",
			"title": "Thread Name Max Length",
			"description": "Maximum number of characters in a resolved response thread name. Discord accepts 1 to 100.",
			"default": 90,
			"minimum": 1,
			"maximum": 100,
			"optional": true
		},
		"discord.threadAutoArchiveMinutes": {
			"type": "number",
			"title": "Thread Auto Archive Minutes",
			"description": "Discord auto-archive duration, in minutes, for response threads the node creates. Discord accepts only 60, 1440, 4320 or 10080; 0 (the default) uses the channel's own default.",
			"default": 0,
			"enum": [
				[0, "Channel default"],
				[60, "1 hour"],
				[1440, "24 hours"],
				[4320, "3 days"],
				[10080, "1 week"]
			],
			"optional": true
		},
		"discord.numberChunks": {
			"type": "boolean",
			"title": "Number Reply Chunks",
			"description": "When an answer is too long for one Discord message, end each message with its position, for example (2/3). A reply that fits in one message is never labelled.",
			"default": false,
			"optional": true
		},
		"discord.textAttachmentExtensions": {
			"type": "array",
			"items": {"type": "string"},
			"title": "Text Attachment Extensions",
			"description": "Filename extensions decoded as text (UTF-8, or UTF-16 when the file starts with a UTF-16 byte order mark) and routed through the text lane, for example .pipe, .json, .log, .md, .txt, .csv, .yaml, .yml. Once any extension is listed, text/* files are decoded too. Empty (the default): every attachment is routed as a binary object.",
			"default": [],
			"optional": true
		},
		"discord.textAttachmentMaxChars": {
			"type": "number",
			"title": "Text Attachment Max Characters",
			"description": "Maximum decoded characters folded into the text lane per attachment. 0 means no limit.",
			"default": 12000,
			"minimum": 0,
			"optional": true
		},
		"discord.mergeAttachments": {
			"type": "boolean",
			"title": "Merge attachments into the question",
			"description": "When enabled, text-like files are folded into the message text and the answers the pipeline gives for image, audio, and video attachments are folded in as context before the text pass, so one reply covers everything. When disabled (the default), text and every attachment are asked separately and the first non-empty answer wins.",
			"default": false,
			"optional": true
		},
		"discord.emitReactions": {
			"type": "boolean",
			"title": "Emit Reactions",
			"description": "Emit raw reaction add and remove events into the pipeline.",
			"default": false,
			"optional": true
		},
		"discord.emitNoReply": {
			"type": "boolean",
			"title": "Emit No Reply Events",
			"description": "Emit an event when processing produces no answer or raises an error. The reason is no_answer, send_failed, shutdown, paused, aimed_elsewhere, non_answer, model_error or timeout; any other value is an error message clipped to 200 characters.",
			"default": false,
			"optional": true
		},
		"discord.emitOutbound": {
			"type": "boolean",
			"title": "Emit Outbound Events",
			"description": "Emit an event after posting a pipeline response to Discord.",
			"default": false,
			"optional": true
		},
		"discord.includeMemberMetadata": {
			"type": "boolean",
			"title": "Include Member Metadata",
			"description": "Include display names and role IDs; requires the Discord members intent.",
			"default": false,
			"optional": true
		},
		"discord.backfillLimit": {
			"type": "number",
			"title": "Backfill Limit",
			"description": "Most-recent messages to process per readable channel at startup, at most 100; messages the bot already replied to, made a thread for, or reacted to are skipped. Zero disables backfill, and it never runs while Send Responses is off.",
			"default": 0,
			"minimum": 0,
			"maximum": 100,
			"optional": true
		},
		"discord.threadHistoryLimit": {
			"type": "number",
			"title": "Thread History Limit",
			"description": "Prior thread messages fetched as conversation context for a message in a thread, at most 100. Zero disables it.",
			"default": 0,
			"minimum": 0,
			"maximum": 100,
			"optional": true
		},
		"discord.threadHistoryMaxChars": {
			"type": "number",
			"title": "Thread History Max Characters",
			"description": "Maximum characters of thread transcript passed as context, at most 20000; the oldest lines are dropped first. Zero disables the context, like Thread History Limit.",
			"default": 6000,
			"minimum": 0,
			"maximum": 20000,
			"optional": true
		},
		"discord.escalationPause": {
			"type": "boolean",
			"title": "Pause After Escalation",
			"description": "After an answer containing an escalation marker is posted into a thread, stay quiet in that thread until the bot is mentioned again.",
			"default": false,
			"optional": true
		},
		"discord.escalationMarkers": {
			"type": "array",
			"items": {"type": "string"},
			"title": "Escalation Markers",
			"description": "Text markers that mark an answer as escalated (for example a team role mention). Allowed Mention Role IDs are added automatically.",
			"default": [],
			"optional": true
		},
		"discord.teamMentionAlias": {
			"type": "string",
			"title": "Team Mention Alias",
			"description": "Literal team name the pipeline writes when it hands a question over, for example \"@RocketRide team\". Every occurrence is replaced with a real mention of the first role in Allowed Mention Role IDs, so the team is actually pinged. Any user who gets the model to write it triggers that ping, so a thread or channel gets at most one ping per hour (reset on restart); later answers keep the alias as plain text. Empty leaves answers untouched.",
			"default": "",
			"optional": true
		},
		"discord.ignoreAimedAtOthers": {
			"type": "boolean",
			"title": "Ignore Messages Aimed At Others",
			"description": "Skip messages that mention another user or role, or reply to a message the bot did not write, unless the bot is mentioned.",
			"default": false,
			"optional": true
		},
		"discord.ackEmoji": {
			"type": "string",
			"title": "Acknowledgement Emoji",
			"description": "Emoji added to a message that is skipped as aimed at somebody else. Empty adds no reaction.",
			"default": "",
			"optional": true
		},
		"discord.feedbackReactions": {
			"type": "boolean",
			"title": "Feedback Reactions",
			"description": "Add feedback emojis to the last posted answer chunk so readers can grade it in one click.",
			"default": false,
			"optional": true
		},
		"discord.feedbackEmojis": {
			"type": "array",
			"items": {"type": "string"},
			"title": "Feedback Emojis",
			"description": "Emojis added, in order, to the last posted answer chunk when Feedback Reactions is enabled.",
			"default": ["✅", "❌"],
			"optional": true
		},
		"discord.sanitizeReplies": {
			"type": "boolean",
			"title": "Sanitize Replies",
			"description": "Strip leaked agent reasoning (Thought / Action / Observation / Final Answer) from an answer before posting it, and retry an answer that was only reasoning or empty: the text pass then runs up to 1 + Retries on a non-answer times per message, even for a pipeline that is silent on purpose. Error answers (an engine or provider error, a traceback) are never posted, whether or not this is on.",
			"default": false,
			"optional": true
		},
		"discord.nonAnswerRetries": {
			"type": "number",
			"title": "Retries on a non-answer",
			"description": "While Sanitize Replies is on, re-run the text pass up to this many times when the reply was only agent scratchpad (such as Thought: lines) or empty, so one message runs the pipeline at most 1 + this many times. An error answer is never retried. Zero never retries.",
			"default": 1,
			"minimum": 0,
			"maximum": 3,
			"optional": true
		},
		"discord.pipelineTimeoutSeconds": {
			"type": "number",
			"title": "Pipeline Timeout (seconds)",
			"description": "Give up on a message whose pipeline has not answered after this many seconds and report a no_reply with reason timeout instead of posting. Each pipeline run (the question, each attachment, each retry) gets this long. The limit includes waiting for a free pipeline worker. The run itself is not stopped: it keeps its worker until it finishes in the background, and its late answer is dropped. Zero (default) waits as long as it takes.",
			"default": 0,
			"minimum": 0,
			"optional": true
		},
		"Pipe.source.parameters": {
			"section": "parameters",
			"title": "Discord Bot Configuration",
			"properties": [
				"discord.botToken",
				"discord.guildIds",
				"discord.channelIds",
				"discord.ignoreBots",
				"discord.requireMention",
				"discord.replyMode",
				"discord.showTyping",
				"discord.maxAttachmentBytes",
				"discord.maxConcurrentMessages",
				"discord.sendResponses",
				"discord.requireMentionChannelIds",
				"discord.allowedBotIds",
				"discord.allowedMentionRoleIds",
				"discord.allowedMentionUserIds",
				"discord.threadName",
				"discord.threadNameMaxLength",
				"discord.threadAutoArchiveMinutes",
				"discord.numberChunks",
				"discord.textAttachmentExtensions",
				"discord.textAttachmentMaxChars",
				"discord.mergeAttachments",
				"discord.emitReactions",
				"discord.emitNoReply",
				"discord.emitOutbound",
				"discord.includeMemberMetadata",
				"discord.backfillLimit",
				"discord.threadHistoryLimit",
				"discord.threadHistoryMaxChars",
				"discord.escalationPause",
				"discord.escalationMarkers",
				"discord.teamMentionAlias",
				"discord.ignoreAimedAtOthers",
				"discord.ackEmoji",
				"discord.feedbackReactions",
				"discord.feedbackEmojis",
				"discord.sanitizeReplies",
				"discord.nonAnswerRetries",
				"discord.pipelineTimeoutSeconds"
			]
		}
	},
	//
	// Required:
	//		Defines the fields (shape) of the service.
	//
	"shape": [
		{
			"section": "Pipe",
			"title": "Discord Bot",
			"properties": ["type", "Pipe.source.parameters"]
		}
	]
}
