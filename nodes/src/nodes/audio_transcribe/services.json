{
	//
	// Required:
	//		The displayable name of this node
	//
	"title": "Transcribe",
	//
	// Required:
	//		The protocol is the endpoint protocol
	//
	"protocol": "audio_transcribe://",
	//
	// Required:
	//		Class type of the node - what it does
	//
	"classType": ["audio"],
	//
	// Required:
	//		Capabilities are flags that change the behavior of the underlying
	//		engine
	//
	"capabilities": [],
	//
	// Optional:
	//		Register is either filter, endpoint or ignored if not specified. If the
	//		type is specified, a factory is registered of that given type
	//
	"register": "filter",
	//
	// Optional:
	//		The node is the actual physical node to instantiate - if
	//		not specified, the protocol will be used
	//
	"node": "python",
	//
	// Optional:
	//		The path is the executable/script code - it is node dependent
	// 		and is optional for most node
	//
	"path": "nodes.audio_transcribe",
	//
	// Required:
	//		The prefix map when added/removed when convertting URLs <=> paths
	//
	"prefix": "audio_transcribe",
	//
	//	Optional:
	//		As a pipe component, define what this pipe component takes
	//		and what it produces
	//
	"description": ["The Audio transcribe component recieves audio or video and transcribes into text."],
	//
	// Optional:
	//	  The icon is the icon to display in the UI for this node
	//
	"icon": "audio-transcribe.svg",
	"documentation": "https://docs.rocketride.org/nodes/audio_transcribe",
	//
	//
	//	Optional:
	//		As a pipe component, define what this pipe component takes
	//		and what it produces
	//
	"lanes": {
		"audio": ["text"],
		"video": ["text"]
	},
	//
	// Optional:
	//		Test configuration for automated node testing. "profiles" lists
	//		values of the "model" selector; the framework writes the selected
	//		one at "model".
	//
	"test": {
		"profiles": ["base"],
		"requiresHardware": { "cuda": { "vramGb": 2 }, "mps": { "ramGb": 4 }, "cpu": { "ramGb": 4 } },
		"cases": [
			{
				"video": "video/BBC - Tear down this wall.mp4",
				"expect": {
					"text": {
						"beginsWith": "Where East meets West in the divided",
						// No "Mr": small and tiny write "Mr." where the larger models write
						// "Mr", and the difference says nothing about transcription quality.
						"contains": "Gorbachev, tear down this wall.\n",
						"endsWith": "as many again were arrested.\n\n\n"
					}
				}
			}
		]
	},
	//
	//	Full test configuration - tests all Whisper model sizes.
	//	Run via: builder nodes:test-full
	//
	"fulltest": [
		{
			"profiles": ["tiny", "base", "small", "medium", "large-v3"],
			"requiresHardware": { "cuda": { "vramGb": 5 }, "mps": { "ramGb": 8 }, "cpu": { "ramGb": 8 } },
			"outputs": ["text"],
			"timeout": 300,
			"cases": [
				{
					"video": "video/BBC - Tear down this wall.mp4",
					"expect": {
						"text": {
							// See the note in "test" above — no "Mr", so every model size matches.
						"contains": "Gorbachev, tear down this wall."
						}
					}
				}
			]
		}
	],
	//
	// Optional:
	//		Local property definitions. The Whisper model is the selector (one
	//		value per model size, no per-model settings); every other field is
	//		shared by all models and stored flat. Defaults are what the node
	//		ran with before the fields were declared (#1809, #2067).
	//
	"propertyDefinitions": {
		"transcribe.model": {
			"type": "string",
			"title": "Model",
			"description": "The Whisper model to use for transcription",
			"default": "base",
			"enum": {
				"tiny": { "title": "Tiny - Faster, least accurate" },
				"base": { "title": "Base - Fast, low accuracy" },
				"small": { "title": "Small - Medium, medium accuracy" },
				"medium": { "title": "Medium - Slower, high accuracy" },
				"large-v3": { "title": "Large v3 - Slowest, highest accuracy" }
			}
		},
		"transcribe.language": {
			"type": "string",
			"title": "Language",
			"description": "ISO 639-1 code of the spoken language (e.g. en, ru, de). Must match the audio; a mismatch produces garbled half-translated text",
			"default": "en"
		},
		// Honoured by ai.common.models.Whisper: it is part of the model identity,
		// local and on the model server.
		"transcribe.compute_type": {
			"type": "string",
			"title": "Compute Type",
			"description": "CTranslate2 weight precision. float16 needs a GPU and falls back to int8 on CPU; float32 is the most precise and the slowest",
			"enum": [
				["float16", "Float16 - GPU default, int8 on CPU"],
				["int8", "Int8 - Fastest, smallest"],
				["int8_float16", "Int8/Float16 - Mixed precision, GPU"],
				["float32", "Float32 - Most precise, slowest"]
			],
			"default": "float16"
		},
		// Buffering, passed to Transcribe(). The default is its own constant.
		"transcribe.chunk_duration": {
			"type": "integer",
			"title": "Chunk Duration (s)",
			"description": "Seconds of audio to buffer before sending a chunk to Whisper",
			"default": 60,
			"minimum": 1
		},
		// Decode-time parameters, forwarded per request. Integer where VadOptions
		// declares an int: JSON does not distinguish 5 from 5.0, the schema does.
		"transcribe.beam_size": {
			"type": "integer",
			"title": "Beam Size",
			"description": "Beam size for decoding. 1 is greedy (fastest); higher is slower and usually more accurate",
			"default": 5,
			"minimum": 1
		},
		"transcribe.vad_filter": {
			"type": "boolean",
			"title": "VAD Filter",
			"description": "Use Whisper's built-in Silero VAD to drop non-speech before transcribing",
			"default": true
		},
		"transcribe.vad_threshold": {
			"type": "number",
			"title": "VAD Speech Threshold",
			"description": "Silero speech probability above which audio counts as speech (0-1)",
			"default": 0.5,
			"minimum": 0,
			"maximum": 1
		},
		"transcribe.vad_min_silence_duration_ms": {
			"type": "integer",
			"title": "VAD Minimum Silence (ms)",
			"description": "Silence this long ends a speech chunk",
			"default": 500,
			"minimum": 0
		},
		"transcribe.vad_speech_pad_ms": {
			"type": "integer",
			"title": "VAD Speech Padding (ms)",
			"description": "Padding added to each side of a detected speech chunk",
			"default": 400,
			"minimum": 0
		},
		"transcribe.vad_max_speech_duration_s": {
			"type": "number",
			"title": "VAD Maximum Speech (s)",
			"description": "Split speech chunks longer than this. 0 means no limit",
			"default": 0,
			"minimum": 0
		}
	},
	//
	// Required:
	//		Defines the properties shown in the pipeline builder side panel, in order
	//
	"properties": [
		"transcribe.model",
		"transcribe.language",
		"transcribe.compute_type",
		"transcribe.chunk_duration",
		"transcribe.beam_size",
		"transcribe.vad_filter",
		"transcribe.vad_threshold",
		"transcribe.vad_min_silence_duration_ms",
		"transcribe.vad_speech_pad_ms",
		"transcribe.vad_max_speech_duration_s"
	]
}
