{
	"title": "Tavily",
	"protocol": "tool_tavily://",
	"classType": ["tool"],
	"capabilities": ["invoke", "experimental"],
	"register": "filter",
	"node": "python",
	"path": "nodes.tool_tavily",
	"prefix": "tavily",
	"icon": "tavily.svg",
	"documentation": "https://docs.rocketride.org/nodes/tool_tavily",
	"description": ["Exposes Tavily real-time web search as an agent tool.", "Performs live web searches via the Tavily API and returns structured results with titles, URLs, content snippets, and relevance scores."],
	"tile": [],
	"lanes": {},
	//
	// Optional:
	//		Local property definitions. The API key is a required secret the account
	//		variable supplies.
	//
	"propertyDefinitions": {
		"tool_tavily.apikey": {
			"type": "string",
			"title": "API Key",
			"description": "Tavily API key (from https://tavily.com)",
			"secret": true,
			"env": "ROCKETRIDE_TAVILY_KEY",
			"required": true
		},
		"tool_tavily.maxResults": {
			"type": "integer",
			"title": "Max Results",
			"description": "Maximum number of search results to return (1-20)",
			"default": 5,
			"minimum": 1,
			"maximum": 20
		},
		"tool_tavily.searchDepth": {
			"type": "string",
			"title": "Search Depth",
			"description": "Tavily search depth",
			"default": "advanced",
			"enum": [
				["basic", "Basic"],
				["advanced", "Advanced"]
			]
		},
		"tool_tavily.topic": {
			"type": "string",
			"title": "Topic",
			"description": "Search topic category",
			"default": "general",
			"enum": [
				["general", "General"],
				["news", "News"],
				["finance", "Finance"]
			]
		}
	},
	"properties": ["type", "tool_tavily.apikey", "tool_tavily.maxResults", "tool_tavily.searchDepth", "tool_tavily.topic"],
	"test": {
		"profiles": ["default"],
		"outputs": [],
		"cases": [
			{
				"name": "Tavily smoke test (placeholder key)",
				"text": "test query"
			}
		]
	}
}
