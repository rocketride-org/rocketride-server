{
	"title": "Landing.ai Parse",
	"protocol": "landing_ai_parse://",
	"classType": ["data"],
	"capabilities": [],
	"register": "filter",
	"node": "python",
	"path": "nodes.landing_ai.parse",
	"prefix": "landing_ai_parse",
	"description": [
		"Parses documents with Landing.ai Agentic Document Extraction (ADE), ",
		"extracting clean Markdown text and structured tables from PDFs, images, ",
		"and spreadsheets using the DPT-2 model."
	],
	"icon": "landing_ai.svg",
	"documentation": "https://docs.rocketride.org/nodes/landing_ai/parse",
	"lanes": {
		"tags": ["text", "table"]
	},
	//
	// Optional:
	//		Local property definitions. Every leaf is shared and stored flat; the
	//		API key arrives through the node config (no process-environment fallback).
	//
	"propertyDefinitions": {
		"landing_ai_parse.api_key": {
			"type": "string",
			"title": "API Key",
			"description": "Your Landing.ai ADE API key.",
			"secret": true,
			"env": "ROCKETRIDE_LANDING_AI_APIKEY",
			"required": true
		},
		"landing_ai_parse.model": {
			"type": "string",
			"title": "Model",
			"description": "ADE parse model to use.",
			"default": "dpt-2-latest",
			"enum": [
				["dpt-2-latest", "DPT-2 (latest)"]
			]
		},
		"landing_ai_parse.region": {
			"type": "string",
			"title": "Region",
			"description": "Which Landing.ai deployment to call. Use EU for the eu-west-1 data-residency endpoint.",
			"default": "production",
			"enum": [
				["production", "US (production)"],
				["eu", "EU (eu-west-1)"]
			]
		}
	},
	//
	// Required:
	//		Defines the properties shown in the pipeline builder side panel, in order
	//
	"properties": ["landing_ai_parse.api_key", "landing_ai_parse.model", "landing_ai_parse.region"]
}
