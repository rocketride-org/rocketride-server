{
	//
	// Required: The displayable name of this node
	//
	"title": "HydraDB",
	//
	// Required: The protocol is the endpoint protocol
	//
	"protocol": "db_hydradb://",
	//
	// Required: Class type of the node - a database that is also an agent-callable tool
	//
	"classType": ["graph", "database", "tool"],
	//
	// Required: Capabilities are flags that change engine behavior.
	//   noremote - holds a client + credentials, so it pins to the local worker (per db_neo4j/db_arango)
	//   invoke   - agent-invocable tool node. NOTE: unlike db_neo4j/db_arango there is NO "invoke": {llm}
	//              block below - HydraDB retrieves natively (no NL-to-query translation), so no LLM is consumed.
	//
	"capabilities": ["noremote", "invoke"],
	//
	// Optional: Register a filter factory
	//
	"register": "filter",
	//
	// Optional: The physical node runtime
	//
	"node": "python",
	//
	// Optional: The python module path (must be nodes.<dir_name>)
	//
	"path": "nodes.graph_hydradb",
	//
	// Required: The prefix map used when converting URLs <=> paths (unique across the catalog)
	//
	"prefix": "hydradb",
	//
	// Optional: Description of this driver
	//
	"description": ["A database/tool node for HydraDB, a managed graph + memory store. ", "Exposes agent-callable tools to store text as memories (with automatic knowledge-graph ", "extraction) and recall graph-enriched context by natural-language query. Retrieval is ", "HydraDB's native server-side search - no embeddings or query language required."],
	//
	// Optional: The UI icon (co-located svg)
	//
	"icon": "hydradb.svg",
	"documentation": "https://docs.rocketride.org/nodes/graph_hydradb",
	//
	// Optional: Lanes - this MVP is a pure agent-tool surface, so no data-flow lanes.
	//
	"lanes": {},
	//
	// Optional:
	//		Local property definitions. Every field is stored flat; the API
	//		key and database are required, the key a secret an account
	//		variable can supply.
	//
	"propertyDefinitions": {
		"hydradb.api_key": {
			"type": "string",
			"title": "API Key",
			"description": "HydraDB API key.",
			"secret": true,
			"env": "ROCKETRIDE_GRAPH_HYDRADB_APIKEY",
			"required": true
		},
		"hydradb.database": {
			"type": "string",
			"title": "Database",
			"description": "HydraDB database - the space that stores your context. Create one in the HydraDB dashboard.",
			"required": true
		},
		"hydradb.collection": {
			"type": "string",
			"title": "Collection",
			"default": "default",
			"minLength": 1,
			"description": "Collection scope within the database (per-user/workspace partition for memories)."
		},
		"hydradb.max_results": {
			"type": "integer",
			"title": "Max results",
			"default": 10,
			"minimum": 1,
			"maximum": 100,
			"description": "Default maximum number of results returned by recall_memory."
		}
	},
	//
	// Required:
	//		Defines the properties shown in the pipeline builder side panel, in order
	//
	"properties": ["hydradb.api_key", "hydradb.database", "hydradb.collection", "hydradb.max_results"]
}
