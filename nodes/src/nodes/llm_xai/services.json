{
	//
	// Required:
	//		The displayable name of this node
	//
	"title": "xAI",
	//
	// Required:
	//		The protocol is the endpoint protocol
	//
	"protocol": "llm_xai://",
	//
	// Required:
	//		Class type of the node - what it does
	//
	"classType": ["llm"],
	//
	// Required:
	//		Capabilities are flags that change the behavior of the underlying
	//		engine
	//
	"capabilities": ["invoke"],
	//
	// Optional:
	//		Register is either filter, endpoint or ignored if not specified. If the
	//		type is specified, a factory is registered of that given type
	//
	"register": "filter",
	//
	// Optional:
	//		The node is the actual physical node to instantiate - if
	//		not specified, the protocol will be used
	//
	"node": "python",
	//
	// Optional:
	//		The path is the executable/script code - it is node dependent
	//		and is optional for most node
	//
	"path": "nodes.llm_xai",
	//
	// Required:
	//		The prefix map when added/removed when converting URLs <=> paths
	//
	"prefix": "llm",
	//
	// Optional:
	//		Description of this driver
	//
	"description": [
		"A component that integrates with xAI's Grok language models for intelligent text generation ",
		"and analysis. Designed for advanced natural language understanding, it supports a wide range ",
		"of use cases including question answering, summarization, and conversational AI. With a focus ",
		"on reasoning and accuracy, this component provides access to cutting-edge capabilities from xAI, ",
		"enabling rich, context-aware responses for enterprise and technical applications. Configuration ",
		"options allow flexible deployment within secure and performance-optimized pipelines."
	],
	//
	// Optional:
	//		The icon is the icon to display in the UI for this node
	//
	"icon": "xai.svg",
	"documentation": "https://docs.rocketride.org/nodes/llm_xai",
	//
	// Optional:
	//		Rendering hints to the UI which indicate which fields of
	//		the configuration should be used to display information
	//
	"tile": ["Model: ${parameters.llm_xai.model}"],
	//
	// Optional:
	//		As a pipe component, define what this pipe component takes
	//		and what it produces
	//
	"lanes": {
		"questions": ["answers"]
	},
	//
	// Optional:
	//		Local property definitions. The model is the selector (one branch per
	//		model, the branch value is the model id); each branch pins its context
	//		window and capabilities as constants, and the leaves every model shares
	//		(credentials, generation settings) sit at the root and are stored flat.
	//		The "custom" branch takes a model id the catalog does not list.
	//
	"propertyDefinitions": {
		"llm_xai.apikey": {
			"base": "llm.cloud.apikey",
			"description": "xAI API key",
			"env": "ROCKETRIDE_LLM_XAI_APIKEY",
			"required": true
		},
		"llm_xai.customModel": {
			"type": "string",
			"title": "Model id",
			"description": "Model id exactly as the provider names it",
			"required": true
		},
		"llm_xai.custom.modelTotalTokens": { "type": "number", "title": "Tokens", "description": "Total Tokens", "minimum": 1, "default": 131072 },
		"llm_xai.custom.modelOutputTokens": {
			"type": "integer",
			"title": "Output Tokens",
			"description": "Most tokens the model may write in one reply (at least 1,024). Leave it empty to keep the node's default. Reasoning models count their thinking against this limit: set it well above the reply you expect, or they can spend it all thinking and return nothing. It cannot exceed Tokens; a larger value is lowered to it.",
			"minimum": 1024,
			"default": 131072
		}
	},
	//
	// Required:
	//		Defines the properties shown in the pipeline builder side panel, in order
	//
	"properties": [
		{
			"name": "model",
			"type": "string",
			"title": "Model",
			"description": "LLM model",
			"default": "grok-3",
			"enum": {
				"grok-4-1-fast-reasoning": {
					"title": "Grok 4.1 Fast",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 2000000 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 4096 }
					]
				},
				"grok-4-1-fast-non-reasoning": {
					"title": "Grok 4.1 Fast Non-Reasoning",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 2000000 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 4096 }
					]
				},
				"grok-code-fast-1": {
					"title": "Grok Code Fast 1",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 256000 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 10000 }
					]
				},
				"grok-4-fast-reasoning": {
					"title": "Grok 4 Fast",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 2000000 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 4096 }
					]
				},
				"grok-4-fast-non-reasoning": {
					"title": "Grok 4 Fast Non-Reasoning",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 2000000 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 4096 }
					]
				},
				"grok-4-0709": {
					"title": "Grok 4",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 256000 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 256000 }
					]
				},
				"grok-3-mini": {
					"title": "Grok 3 Mini",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 131072 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 131072 }
					]
				},
				"grok-3": {
					"title": "Grok 3",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 131072 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 131072 }
					]
				},
				"grok-3-beta": {
					"title": "xAI: Grok 3 Beta (deprecated)",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 131072 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 131072 }
					]
				},
				"grok-3-mini-beta": {
					"title": "xAI: Grok 3 Mini Beta (deprecated)",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 131072 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 131072 }
					]
				},
				"grok-4.1-fast": {
					"title": "xAI: Grok 4.1 Fast (deprecated)",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 2000000 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 30000 }
					]
				},
				"grok-4.20": {
					"title": "xAI: Grok 4.20",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 2000000 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 1800000 },
						{ "name": "reasoning", "type": "constant", "default": true }
					]
				},
				"grok-4.20-multi-agent": {
					"title": "xAI: Grok 4.20 Multi-Agent",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 2000000 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 1800000 },
						{ "name": "reasoning", "type": "constant", "default": true }
					]
				},
				"grok-4-fast": {
					"title": "xAI: Grok 4 Fast (deprecated)",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 2000000 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 30000 }
					]
				},
				"grok-4.3": {
					"title": "xAI: Grok 4.3",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 1000000 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 900000 },
						{ "name": "reasoning", "type": "constant", "default": true }
					]
				},
				"grok-4.5": {
					"title": "xAI: Grok 4.5",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 500000 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 450000 },
						{ "name": "reasoning", "type": "constant", "default": true }
					]
				},
				"grok-build-0.1": {
					"title": "xAI: Grok Build 0.1",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 256000 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 230400 },
						{ "name": "reasoning", "type": "constant", "default": true }
					]
				},
				"grok-latest": {
					"title": "xAI: Grok Latest",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 500000 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 450000 },
						{ "name": "reasoning", "type": "constant", "default": true }
					]
				},
				"grok-4.3:batch": {
					"title": "SpaceXAI: Grok 4.3 (batch) (deprecated)",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 1000000 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 900000 },
						{ "name": "reasoning", "type": "constant", "default": true }
					]
				},
				"grok-4.6": {
					"title": "SpaceXAI: Grok 4.6",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 500000 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 450000 },
						{ "name": "reasoning", "type": "constant", "default": true }
					]
				},
				"custom": {
					"title": "Custom model",
					"properties": ["llm_xai.customModel", "llm_xai.custom.modelTotalTokens", "llm_xai.custom.modelOutputTokens"]
				}
			}
		},
		"llm_xai.apikey"
	],
	//
	// Optional:
	//		Test configuration for automated node testing. "profiles" lists
	//		values of the "model" selector; the framework writes the selected one
	//		at "model" and the mock credentials at their paths.
	//
	"test": {
		"profiles": ["grok-4-1-fast-reasoning"],
		"outputs": ["answers"],
		"cases": [
			{
				"name": "LLM returns mock response",
				"text": "What is 2+2?",
				"expect": {
					"answers": { "contains": "Mock LLM response" }
				}
			}
		]
	}
}
