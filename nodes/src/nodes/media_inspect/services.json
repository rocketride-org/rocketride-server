{
	"title": "Media Toolkit: Inspect",
	"protocol": "media_inspect://",
	"classType": ["video"],
	"capabilities": [],
	"node": "python",
	"path": "nodes.media_inspect",
	"prefix": "media_inspect",
	"register": "filter",
	"description": [
		"Measure streamed media and extract selected images.",
		" Outputs are returned through lanes; persistence belongs to downstream nodes."
	],
	"icon": "media_inspect.svg",
	"documentation": "https://docs.rocketride.org/nodes/media_inspect",
	"lanes": {
		"video": ["text", "answers", "image"],
		"audio": ["text", "answers", "image"]
	},
	//
	// Optional:
	//		Local property definitions. Every leaf is shared and stored flat; the
	//		bounds the node used to clamp by hand are declared here instead.
	//
	"propertyDefinitions": {
		"media_inspect.request": {
			"type": "string",
			"title": "Operation request (JSON)",
			"format": "textarea",
			"default": "{}",
			"description": "JSON request: probe, levels (range, ranges, scan, scan_scenes) or stills (stills array). Sources arrive as media streams."
		},
		"media_inspect.event_type": {
			"type": "string",
			"title": "Name of the progress event this pipeline emits",
			"default": "media_inspect",
			"minLength": 1
		},
		"media_inspect.chunk_kb": { "type": "integer", "title": "Stream chunk size (KB)", "default": 1024, "minimum": 64, "maximum": 8192 },
		"media_inspect.max_input_mb": {
			"type": "integer",
			"title": "Maximum cumulative input per object (MiB)",
			"default": 16384,
			"minimum": 1,
			"maximum": 1048576,
			"description": "Total incoming media bytes, including all assets; enforced even when stream size is undeclared."
		},
		"media_inspect.silence_db": { "type": "number", "title": "Silence threshold (dB)", "default": -40, "maximum": 0 },
		"media_inspect.silence_ms": { "type": "integer", "title": "Shortest silence worth reporting (ms)", "default": 700, "minimum": 1 },
		"media_inspect.peak_ms": { "type": "integer", "title": "Length of one loudness bucket (ms)", "default": 100, "minimum": 10 },
		"media_inspect.scene_threshold": {
			"type": "number",
			"title": "Scene score a shot change has to cross",
			"default": 0.35,
			"minimum": 0,
			"maximum": 1
		}
	},
	//
	// Required:
	//		Defines the properties shown in the pipeline builder side panel, in order
	//
	"properties": [
		"media_inspect.request",
		"media_inspect.event_type",
		"media_inspect.chunk_kb",
		"media_inspect.max_input_mb",
		"media_inspect.silence_db",
		"media_inspect.silence_ms",
		"media_inspect.peak_ms",
		"media_inspect.scene_threshold"
	],
	//
	// Optional:
	//		Test configuration for automated node testing. "profiles" lists values
	//		of the root selector; the framework writes the selected one at its path.
	//
	"test": {
		"profiles": ["default"],
		"outputs": ["text"],
		"cases": [
			{
				"name": "Streamed media smoke",
				"video": "video/Number Song _ No Music _ Vocal.mp4",
				"expect": {
					"text": { "contains": "media_" }
				}
			}
		]
	}
}
