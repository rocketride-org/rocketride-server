{
	//
	// Required:
	//		The displayable name of this node
	//
	"title": "Reducto",

	//
	// Required:
	//		The protocol is the endpoint protocol
	//
	"protocol": "reducto://",
	//
	// Required:
	//		Class type of the node - what it does
	//
	"classType": ["data"],
	//
	// Required:
	//		Capabilities are flags that change the behavior of the underlying
	//		engine. Not needed for cloud-based processing.
	//
	"capabilities": [],
	//
	// Optional:
	//		Register is either filter, endpoint or ignored if not specified. If the
	//		type is specified, a factory is registered of that given type
	//
	"register": "filter",
	//
	// Optional:
	//		The node is the actual physical node to instantiate - if
	//		not specified, the protocol will be used
	//
	"node": "python",
	//
	// Optional:
	//		The path is the executable/script code - it is node dependent
	// 		and is optional for most node
	//
	"path": "nodes.reducto",
	//
	// Required:
	//		The prefix map when added/removed when convertting URLs <=> paths
	//
	"prefix": "reducto",
	//
	// Optional:
	//	Description to of this driver
	//
	"description": ["A parsing component that uses Reducto to extract text and structured data ", "from various document formats including PDFs, images, and other document types. ", "It provides high-quality text extraction with support for tables, layout preservation, ", "and multiple output formats."],
	//
	// Optional:
	//	  The icon is the icon to display in the UI for this node
	//
	"icon": "reducto.svg",
	"documentation": "https://docs.rocketride.org/nodes/reducto",

	//
	// Required:
	//		Defines the input and output data types for the node
	//
	"lanes": {
		"tags": ["text", "table"]
	},
	//
	// Optional:
	//		Local property definitions. One Reducto account, stored flat; the key
	//		is required because the node cannot run without it, and arrives
	//		through the node config (a ${ROCKETRIDE_REDUCTO_APIKEY} reference
	//		resolved per call). Advanced mode reads the three option dictionaries
	//		and ignores the simple-mode switches.
	//
	"propertyDefinitions": {
		"reducto.api_key": {
			"type": "string",
			"title": "API Key",
			"description": "Your Reducto API key",
			"secret": true,
			"env": "ROCKETRIDE_REDUCTO_APIKEY",
			"required": true
		},
		"reducto.parse_mode": {
			"type": "boolean",
			"title": "Advanced Mode",
			"description": "Toggle to use the advanced parse mode, and have access to the full set of options from the Reducto API. In advanced mode the simple-mode switches are ignored.",
			"default": false
		},
		"reducto.Contains_Handwritten_Text": {
			"type": "boolean",
			"title": "Contains Handwritten Text",
			"description": "Simple mode: enables Agentic OCR mode for better handwriting recognition and small text/table cell corrections.",
			"default": false
		},
		"reducto.Contains_Non_English_Text": {
			"type": "boolean",
			"title": "Contains Non-English Text",
			"description": "Simple mode: enables the Multilingual OCR system which can parse non-Germanic languages and unicode symbols.",
			"default": false
		},
		"reducto.Summarize_Text": {
			"type": "boolean",
			"title": "AI Summarize Figures/Images",
			"description": "Simple mode: generate AI summaries for figures, diagrams, and images using vision-language models.",
			"default": false
		},
		"reducto.options": {
			"type": "string",
			"title": "Options",
			"description": "Advanced mode: options for the Reducto API as a Python dictionary, e.g. {'key': 'value', 'flag': True}. Empty keeps the API defaults. See https://docs.reducto.ai/parsing/default-configurations for the available options and examples.",
			"format": "textarea",
			"default": ""
		},
		"reducto.advanced_options": {
			"type": "string",
			"title": "Advanced Options",
			"description": "Advanced mode: advanced options for the Reducto API as a Python dictionary. Empty keeps the API defaults.",
			"format": "textarea",
			"default": ""
		},
		"reducto.experimental_options": {
			"type": "string",
			"title": "Experimental Options",
			"description": "Advanced mode: experimental options for the Reducto API as a Python dictionary. Empty keeps the API defaults.",
			"format": "textarea",
			"default": ""
		}
	},
	//
	// Required:
	//		Defines the properties shown in the pipeline builder side panel, in order
	//
	"properties": [
		"reducto.api_key",
		"reducto.parse_mode",
		"reducto.Contains_Handwritten_Text",
		"reducto.Contains_Non_English_Text",
		"reducto.Summarize_Text",
		"reducto.options",
		"reducto.advanced_options",
		"reducto.experimental_options"
	]
}
