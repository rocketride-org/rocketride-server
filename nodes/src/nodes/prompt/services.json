{
	//
	// Required:
	//		The displayable name of this node
	//
	"title": "Prompt",
	//
	// Required:
	//		The protocol is the endpoint protocol
	//
	"protocol": "prompt://",
	//
	// Required:
	//		Class type of the node - what it does
	//
	"classType": ["text"],
	//
	// Required:
	//		Capabilities are flags that change the behavior of the underlying
	//		engine
	//
	"capabilities": ["gpu"],
	//
	// Optional:
	//		Register is either filter, endpoint or ignored if not specified. If the
	//		type is specified, a factory is registered of that given type
	//
	"register": "filter",
	//
	// Optional:
	//		The node is the actual physical node to instantiate - if
	//		not specified, the protocol will be used
	//
	"node": "python",
	//
	// Optional:
	//		The path is the executable/script code - it is node dependent
	// 		and is optional for most node
	//
	"path": "nodes.prompt",
	//
	// Required:
	//		The prefix map when added/removed when convertting URLs <=> paths
	//
	"prefix": "prompt",
	//
	// Optional:
	//		Description to of this driver
	//
	"description": ["A transformation component that takes multiple inputs and merges them ", "into a single question with a configurable prompt. This component is ", "designed to work with chat, retrieval, or document systems, taking ", "questions, documents, text, and tables as input and combining them ", "with contextual prompts to improve LLM responses."],
	//
	// Optional:
	//	  The icon is the icon to display in the UI for this node
	//
	"icon": "prompt.svg",
	"documentation": "https://docs.rocketride.org/nodes/prompt",
	//
	//
	// Optional:
	//	 The tile is the displayable name of this node
	//
	"tile": [],
	//
	//	Optional:
	//		As a pipe component, define what this pipe component takes
	//		and what it produces
	//
	"lanes": {
		"documents": [],
		"text": [],
		"table": [],
		"questions": ["questions"]
	},
	//
	// Optional:
	//		Local property definitions. One list of instructions, stored flat.
	//
	"propertyDefinitions": {
		"prompt.instructions": {
			"type": "array",
			"title": "Instructions",
			"description": "Multiple instructions to add to questions before sending to LLM",
			"default": ["Please provide a detailed and helpful response to the following question:"],
			"item": { "name": "instruction", "type": "string", "format": "textarea" }
		}
	},
	//
	// Required:
	//		Defines the properties shown in the pipeline builder side panel, in order
	//
	"properties": ["prompt.instructions"],
	//
	//	Test configuration for automated node testing
	//
	"test": {
		"profiles": ["default"],
		"requiresHardware": false,
		"cases": [
			{
				"questions": {
					"questions": [{ "text": "What is 2+2?" }]
				},
				"expect": {
					"questions": {
						"contains": "What is 2+2?",
						"property": {
							"path": "[0].instructions[0].instructions",
							"contains": "Please provide a detailed and helpful response"
						},
						"notEmpty": true,
						"minLength": 1,
						"maxLength": 1
					}
				}
			},
			{
				"questions": {
					"questions": [{ "text": "What is the capital of France?" }]
				},
				"expect": {
					"questions": {
						"contains": "capital of France",
						"property": {
							"path": "[0].instructions[0].instructions",
							"contains": "Please provide a detailed and helpful response"
						},
						"notEmpty": true,
						"minLength": 1,
						"maxLength": 1
					}
				}
			}
		]
	}
}
