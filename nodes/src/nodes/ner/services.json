{
	"title": "Named Entity Recognition",
	"protocol": "ner://",
	"classType": ["text"],
	"capabilities": ["gpu"],
	"register": "filter",
	"node": "python",
	"path": "nodes.ner",
	"prefix": "ner",
	"description": [
		"A text processing component that identifies and extracts named entities from text using ",
		"state-of-the-art transformer models. It can detect and classify entities such as persons, ",
		"organizations, locations, dates, and more. The extracted entities are added to document ",
		"metadata for enhanced search, filtering, and analysis capabilities.</br>",
		"</br>",
		"The component supports multiple pre-trained models optimized for different languages and ",
		"use cases, from general-purpose entity recognition to specialized domains."
	],
	"icon": "util-text.svg",
	"documentation": "https://docs.rocketride.org/nodes/ner",
	"lanes": {
		"text": ["text"],
		"documents": ["documents"]
	},
	//
	// Optional:
	//		Local property definitions. The profile is the selector: each named
	//		profile pins its HuggingFace model as a constant and the custom profile
	//		takes any model id. The biomedical profile aliases the confidence
	//		threshold with its own default; the other settings are shared.
	//
	"propertyDefinitions": {
		"ner.model": {
			"type": "string",
			"title": "Model name",
			"minLength": 2,
			"maxLength": 128,
			"description": "HuggingFace model to use for NER",
			"required": true
		},
		"ner.aggregation_strategy": {
			"type": "string",
			"title": "Entity aggregation strategy",
			"description": "How to combine word pieces into entities",
			"default": "simple",
			"enum": ["none", "simple", "first", "average", "max"]
		},
		"ner.min_confidence": {
			"type": "number",
			"title": "Minimum confidence threshold",
			"description": "Minimum confidence score (0.0-1.0) for entity detection",
			"default": 0.9,
			"minimum": 0.0,
			"maximum": 1.0
		},
		"ner.biomedical.min_confidence": { "base": "ner.min_confidence", "default": 0.85 },
		"ner.store_in_metadata": {
			"type": "boolean",
			"title": "Store entities in document metadata",
			"description": "Add extracted entities to document metadata fields",
			"default": true
		}
	},
	//
	// Required:
	//		Defines the properties shown in the pipeline builder side panel, in order
	//
	"properties": [
		{
			"name": "profile",
			"type": "string",
			"title": "Model",
			"description": "NER model configuration",
			"default": "bertLarge",
			"enum": {
				"bertLarge": {
					"title": "BERT Large (English) - High accuracy for English text",
					"properties": [
						{ "name": "model", "type": "constant", "default": "dbmdz/bert-large-cased-finetuned-conll03-english" },
						"ner.min_confidence",
						"ner.aggregation_strategy",
						"ner.store_in_metadata"
					]
				},
				"bertBase": {
					"title": "BERT Base (English) - Balanced performance",
					"properties": [
						{ "name": "model", "type": "constant", "default": "dslim/bert-base-NER" },
						"ner.min_confidence",
						"ner.aggregation_strategy",
						"ner.store_in_metadata"
					]
				},
				"distilbert": {
					"title": "DistilBERT (English) - Fast and lightweight",
					"properties": [
						{ "name": "model", "type": "constant", "default": "Davlan/distilbert-base-multilingual-cased-ner-hrl" },
						"ner.min_confidence",
						"ner.aggregation_strategy",
						"ner.store_in_metadata"
					]
				},
				"xlmRoberta": {
					"title": "XLM-RoBERTa (Multilingual) - Supports 100+ languages",
					"properties": [
						{ "name": "model", "type": "constant", "default": "Davlan/xlm-roberta-base-ner-hrl" },
						"ner.min_confidence",
						"ner.aggregation_strategy",
						"ner.store_in_metadata"
					]
				},
				"deberta": {
					"title": "DeBERTa v3 (English) - State-of-the-art accuracy",
					"properties": [
						{ "name": "model", "type": "constant", "default": "dslim/distilbert-NER" },
						"ner.min_confidence",
						"ner.aggregation_strategy",
						"ner.store_in_metadata"
					]
				},
				"biomedical": {
					"title": "BioBERT (Biomedical) - Medical/scientific entities",
					"properties": [
						{ "name": "model", "type": "constant", "default": "dmis-lab/biobert-base-cased-v1.1" },
						"ner.biomedical.min_confidence",
						"ner.aggregation_strategy",
						"ner.store_in_metadata"
					]
				},
				"custom": {
					"title": "Custom model",
					"properties": ["ner.model", "ner.min_confidence", "ner.aggregation_strategy", "ner.store_in_metadata"]
				}
			}
		}
	],
	//
	// Optional:
	//		Test configuration for automated node testing. "profiles" lists values
	//		of the root selector; the framework writes the selected one at its path.
	//
	"test": {
		"profiles": ["distilbert"],
		"requiresHardware": {
			"cuda": { "vramGb": 2 },
			"mps": { "ramGb": 4 },
			"cpu": { "ramGb": 4 }
		},
		"cases": [
			{
				"text": "Barack Obama was the 44th President of the United States.",
				"expect": {
					"text": { "notEmpty": true, "contains": "Obama" }
				}
			}
		]
	},
	"fulltest": [
		{
			"profiles": ["bertLarge", "bertBase", "distilbert", "xlmRoberta", "deberta", "biomedical"],
			"requiresHardware": {
				"cuda": { "vramGb": 3 },
				"mps": { "ramGb": 6 },
				"cpu": { "ramGb": 6 }
			},
			"cases": [
				{
					"text": "Barack Obama was the 44th President of the United States.",
					"expect": {
						"text": { "notEmpty": true, "contains": "Obama" }
					}
				}
			]
		}
	]
}
