{
	//
	// Required:
	//		The displayable name of this node
	//
	"title": "GLM (Z.ai)",
	//
	// Required:
	//		The protocol is the endpoint protocol
	//
	"protocol": "llm_glm://",
	//
	// Required:
	//		Class type of the node - what it does
	//
	"classType": ["llm"],
	//
	// Required:
	//		Capabilities are flags that change the behavior of the underlying
	//		engine
	//
	"capabilities": ["invoke"],
	//
	// Optional:
	//		Register is either filter, endpoint or ignored if not specified. If the
	//		type is specified, a factory is registered of that given type
	//
	"register": "filter",
	//
	// Optional:
	//		The node is the actual physical node to instantiate - if
	//		not specified, the protocol will be used
	//
	"node": "python",
	//
	// Optional:
	//		The path is the executable/script code - it is node dependent
	//		and is optional for most node
	//
	"path": "nodes.llm_glm",
	//
	// Required:
	//		The prefix map when added/removed when converting URLs <=> paths
	//
	"prefix": "llm",
	//
	// Optional:
	//		Description of this driver
	//
	"description": [
		"A component that connects to Zhipu AI's GLM large language models for ",
		"advanced natural language processing. The GLM-5 generation are hybrid-reasoning ",
		"MoE models with configurable thinking modes, strong agentic and coding ",
		"performance, and up to a 1M-token context window: GLM-5.2 for frontier ",
		"long-context reasoning, GLM-5 Turbo for a fast cost-effective tier, and the ",
		"open-weight GLM-4.5 Air for efficient self-hosted workloads. Models are served ",
		"through the OpenAI-compatible Z.ai cloud API (api.z.ai); self-hosted vLLM or ",
		"SGLang deployments connect through the Custom Model profile."
	],
	//
	// Optional:
	//		The icon is the icon to display in the UI for this node
	//
	"icon": "glm.svg",
	"documentation": "https://docs.rocketride.org",
	//
	// Optional:
	//		Rendering hints to the UI which indicate which fields of
	//		the configuration should be used to display information
	//
	"tile": ["Model: ${parameters.llm_glm.model}"],
	//
	// Optional:
	//		As a pipe component, define what this pipe component takes
	//		and what it produces
	//
	"lanes": {
		"questions": ["answers"]
	},
	//
	// Optional:
	//		Local property definitions. The model is the selector (one branch per
	//		model, the branch value is the model id); each branch pins its context
	//		window and capabilities as constants, and the leaves every model shares
	//		(credentials, generation settings) sit at the root and are stored flat.
	//		The "custom" branch takes a model id the catalog does not list.
	//
	"propertyDefinitions": {
		"llm_glm.apikey": {
			"base": "llm.cloud.apikey",
			"description": "Z.ai API key (a self-hosted endpoint needs none)",
			"env": "ROCKETRIDE_LLM_GLM_APIKEY",
			"required": false
		},
		"llm_glm.serverbase": {
			"base": "llm.local.serverbase",
			"default": "https://api.z.ai/api/paas/v4",
			"title": "Server base URL",
			"description": "OpenAI-compatible base URL for the GLM endpoint (e.g. https://api.z.ai/api/paas/v4 for the Z.ai cloud API, http://localhost:8000/v1 for a self-hosted vLLM / SGLang server)."
		},
		"llm_glm.customModel": {
			"type": "string",
			"title": "Model id",
			"description": "Model id exactly as the provider names it",
			"required": true
		},
		"llm_glm.custom.modelTotalTokens": { "type": "number", "title": "Tokens", "description": "Total Tokens", "minimum": 1, "default": 131072 },
		"llm_glm.custom.modelOutputTokens": {
			"type": "integer",
			"title": "Output Tokens",
			"description": "Most tokens the model may write in one reply (at least 1,024). Leave it empty to keep the node's default. Reasoning models count their thinking against this limit: set it well above the reply you expect, or they can spend it all thinking and return nothing. It cannot exceed Tokens; a larger value is lowered to it.",
			"minimum": 1024,
			"default": 32768
		}
	},
	//
	// Required:
	//		Defines the properties shown in the pipeline builder side panel, in order
	//
	"properties": [
		{
			"name": "model",
			"type": "string",
			"title": "Model",
			"description": "Zhipu AI GLM LLM model",
			"default": "glm-5.2",
			"enum": {
				"glm-5.2": {
					"title": "GLM-5.2",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 1000000 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 32768 },
						{ "name": "reasoning", "type": "constant", "default": true }
					]
				},
				"glm-5.1": {
					"title": "GLM-5.1",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 204800 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 32768 },
						{ "name": "reasoning", "type": "constant", "default": true }
					]
				},
				"glm-5": {
					"title": "GLM-5",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 204800 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 32768 },
						{ "name": "reasoning", "type": "constant", "default": true }
					]
				},
				"glm-5-turbo": {
					"title": "GLM-5 Turbo",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 204800 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 32768 },
						{ "name": "reasoning", "type": "constant", "default": true }
					]
				},
				"glm-4.7": {
					"title": "GLM-4.7",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 204800 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 32768 },
						{ "name": "reasoning", "type": "constant", "default": true }
					]
				},
				"glm-4.6": {
					"title": "GLM-4.6",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 204800 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 32768 },
						{ "name": "reasoning", "type": "constant", "default": true }
					]
				},
				"glm-4.5": {
					"title": "GLM-4.5",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 131072 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 32768 },
						{ "name": "reasoning", "type": "constant", "default": true }
					]
				},
				"glm-4.5-air": {
					"title": "GLM-4.5 Air",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 131072 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 32768 },
						{ "name": "reasoning", "type": "constant", "default": true }
					]
				},
				"custom": {
					"title": "Custom model",
					"properties": ["llm_glm.customModel", "llm_glm.custom.modelTotalTokens", "llm_glm.custom.modelOutputTokens"]
				}
			}
		},
		"llm_glm.apikey",
		"llm_glm.serverbase"
	],
	//
	// Optional:
	//		Test configuration for automated node testing. "profiles" lists
	//		values of the "model" selector; the framework writes the selected one
	//		at "model" and the mock credentials at their paths.
	//
	"test": {
		"profiles": ["glm-5.2"],
		"outputs": ["answers"],
		"cases": [
			{
				"name": "LLM returns mock response",
				"text": "What is 2+2?",
				"expect": {
					"answers": { "contains": "Mock LLM response" }
				}
			}
		]
	}
}
