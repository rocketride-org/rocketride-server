	//		not specified, the protocol will be used
	//
	"node": "python",
	//
	// Optional:
	//		The path is the executable/script code - it is node dependent
	// 		and is optional for most node
	//
	"path": "nodes.llm_glm",
	//
	// Required:
	//		The prefix map when added/removed when convertting URLs <=> paths
	//
	"prefix": "llm",
	//
	// Optional:
	//		Description to of this driver
	//
	"description": ["A component that connects to Zhipu AI's GLM large language models for ", "advanced natural language processing. The GLM-5 generation are hybrid-reasoning ", "MoE models with configurable thinking modes, strong agentic and coding ", "performance, and up to a 1M-token context window: GLM-5.2 for frontier ", "long-context reasoning, GLM-5 Turbo for a fast cost-effective tier, and the ", "open-weight GLM-4.5 Air for efficient self-hosted workloads. Models are served ", "through the OpenAI-compatible Z.ai cloud API (api.z.ai); self-hosted vLLM or ", "SGLang deployments connect through the Custom Model profile."],
	//
	// Optional:
	//	  The icon is the icon to display in the UI for this node
	//
	"icon": "glm.svg",
	"documentation": "https://docs.rocketride.org",
	//
	//
	//  Optional:
	//      Rendering hints to the UI which indicate which fields of
	//      the configuration should be used to display information
	//
	"tile": ["Model: ${parameters.llm_glm.profile}"],
	//
	//	Optional:
	//		As a pipe component, define what this pipe component takes
	//		and what it produces
	//
	"lanes": {
		"questions": ["answers"]
	},
