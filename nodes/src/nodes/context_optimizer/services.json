{
	//
	// Required:
	//		The displayable name of this node
	//
	"title": "Context Optimizer",
	//
	// Required:
	//		The protocol is the endpoint protocol
	//
	"protocol": "context_optimizer://",
	//
	// Required:
	//		Class type of the node - what it does
	//
	"classType": ["text"],
	//
	// Required:
	//		Capabilities are flags that change the behavior of the underlying
	//		engine
	//
	"capabilities": ["experimental"],
	//
	// Optional:
	//		Register is either filter, endpoint or ignored if not specified. If the
	//		type is specified, a factory is registered of that given type
	//
	"register": "filter",
	//
	// Optional:
	//		The node is the actual physical node to instantiate - if
	//		not specified, the protocol will be used
	//
	"node": "python",
	//
	// Optional:
	//		The path is the executable/script code - it is node dependent
	//		and is optional for most nodes
	//
	"path": "nodes.context_optimizer",
	//
	// Required:
	//		The prefix map when added/removed when converting URLs <=> paths
	//
	"prefix": "context_optimizer",
	//
	// Optional:
	//		Description of this driver
	//
	"description": ["A transformation component that manages LLM context window budgets. ", "It counts tokens, allocates budgets across system prompt, query, documents, ", "and conversation history, then truncates or summarizes content to fit within ", "model-specific token limits.</br>", "</br>", "Supports GPT, Claude, and Gemini model families with configurable budget ", "percentages and priority-based allocation."],
	//
	// Optional:
	//	  The icon is the icon to display in the UI for this node
	//
	"icon": "util-text.svg",
	//
	//	Optional:
	//		As a pipe component, define what this pipe component takes
	//		and what it produces
	//
	"lanes": {
		"questions": ["questions"]
	},
	"input": [
		{
			"lane": "questions",
			"description": "Questions with context to optimize",
			"min": 1,
			"output": [
				{
					"lane": "questions",
					"description": "Questions with optimized context fitting within model token limits"
				}
			]
		}
	],
	//
	//	Test configuration for automated node testing. "profiles" lists values
	//	of the "mode" selector; a group's "config" is the node config in its
	//	stored shape (a manual-mode value lives under "manual").
	//
	//	NOTE: these cases exercise tiktoken, which downloads its BPE vocabulary
	//	from openaipublic.blob.core.windows.net the first time an encoding is
	//	requested (`o200k_base` for the `auto` profile, `cl100k_base` for the
	//	tiny manual budget) and then caches it on disk. The dynamic test run
	//	therefore needs outbound network access unless TIKTOKEN_CACHE_DIR points
	//	at a pre-seeded cache -- see "Offline use" in this node's README.md.
	//
	"test": [
		{
			"profiles": ["auto"],
			"cases": [
				{
					"questions": {
						"questions": [{ "text": "What is the capital of France?" }]
					},
					"expect": {
						"questions": {
							"notEmpty": true
						}
					}
				}
			]
		},
		{
			// A 112-token budget forces every optimization path: small enough
			// that every case stays over budget once the section markup
			// IInstance measures is counted, and large enough for the history
			// summary placeholder to fit.
			"profiles": ["manual"],
			"config": {
				"manual": { "max_context_tokens": 112 },
				"system_prompt_budget_pct": 10,
				"query_budget_pct": 20,
				"document_budget_pct": 35,
				"history_budget_pct": 35
			},
			"cases": [
				{
					"name": "truncates over-budget question",
					"questions": {
						"questions": [{ "text": "alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha alpha." }]
					},
					"expect": {
						"questions": {
							"property": [
								{
									"path": "[0].questions[0].text",
									"beginsWith": "alpha"
								},
								{
									"path": "[0].questions[0].text",
									"maxLength": 160
								}
							],
							"notEmpty": true
						}
					}
				},
				{
					"name": "selects documents within budget",
					"questions": {
						"questions": [{ "text": "Which source should answer the alpha question?" }],
						"documents": [
							{
								"page_content": "Priority alpha source.",
								"score": 0.95,
								"metadata": { "objectId": "doc-priority", "chunkId": 0 }
							},
							{
								"page_content": "oversized beta source beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta beta.",
								"score": 0.9,
								"metadata": { "objectId": "doc-oversized", "chunkId": 1 }
							},
							{
								"page_content": "Followup alpha source.",
								"score": 0.8,
								"metadata": { "objectId": "doc-followup", "chunkId": 2 }
							}
						]
					},
					"expect": {
						"questions": {
							"property": [
								{
									"path": "[0].documents",
									"maxLength": 2
								},
								{
									"path": "[0].documents[0].metadata.objectId",
									"equals": "doc-priority"
								},
								{
									"path": "[0].documents[1].metadata.objectId",
									"equals": "doc-followup"
								}
							],
							"notEmpty": true
						}
					}
				},
				{
					"name": "compresses over-budget history",
					"questions": {
						"questions": [{ "text": "Summarize the recent decision." }],
						"history": [
							{ "role": "user", "content": "Start of the conversation." },
							{ "role": "assistant", "content": "middle detail one one one one one one one one one one one one one one one one one one one one one one one one one one one one one one." },
							{ "role": "user", "content": "middle detail two two two two two two two two two two two two two two two two two two two two two two two two two two two two two two." },
							{ "role": "assistant", "content": "The recent decision is ready." }
						]
					},
					"expect": {
						"questions": {
							"property": [
								{
									"path": "[0].history",
									"maxLength": 3
								},
								{
									"path": "[0].history[1].content",
									"contains": "Earlier conversation summarized"
								}
							],
							"notEmpty": true
						}
					}
				}
			]
		}
	],
	//
	// Optional:
	//		Local property definitions. The mode is the selector: "auto" looks
	//		the window up by model id, "manual" states it (and so aliases the
	//		model name with the "custom" default). The budget percentages are
	//		shared by both modes and stored flat.
	//
	"propertyDefinitions": {
		"context_optimizer.model_name": {
			"type": "string",
			"title": "Model name",
			"description": "Model identifier for context-window lookup. Use an id published by an llm_* node (e.g. gpt-5.4, claude-sonnet-4-6, models/gemini-3.1-pro-preview); a short family alias such as claude-sonnet also resolves.",
			"default": "gpt-5"
		},
		"context_optimizer.manual.model_name": {
			"base": "context_optimizer.model_name",
			"description": "Model identifier recorded with the optimized questions; the window comes from Max context tokens.",
			"default": "custom"
		},
		"context_optimizer.max_context_tokens": {
			"type": "integer",
			"title": "Max context tokens",
			"description": "The model's context window in tokens (0 = use the model default)",
			"minimum": 0,
			"default": 128000
		},
		"context_optimizer.system_prompt_budget_pct": {
			"type": "number",
			"title": "System prompt budget (%)",
			"description": "Percentage of context window for system prompt",
			"minimum": 0,
			"maximum": 100,
			"default": 10
		},
		"context_optimizer.query_budget_pct": {
			"type": "number",
			"title": "Query budget (%)",
			"description": "Percentage of context window for the query/question",
			"minimum": 0,
			"maximum": 100,
			"default": 15
		},
		"context_optimizer.document_budget_pct": {
			"type": "number",
			"title": "Document budget (%)",
			"description": "Percentage of context window for retrieved documents",
			"minimum": 0,
			"maximum": 100,
			"default": 50
		},
		"context_optimizer.history_budget_pct": {
			"type": "number",
			"title": "History budget (%)",
			"description": "Percentage of context window for conversation history",
			"minimum": 0,
			"maximum": 100,
			"default": 25
		}
	},
	//
	// Required:
	//		Defines the properties shown in the pipeline builder side panel, in order
	//
	"properties": [
		{
			"name": "mode",
			"type": "string",
			"title": "Mode",
			"description": "Context optimization mode",
			"default": "auto",
			"enum": {
				"auto": {
					"title": "Auto - Use default model limits",
					"properties": ["context_optimizer.model_name"]
				},
				"manual": {
					"title": "Manual - Specify token limits",
					"properties": ["context_optimizer.manual.model_name", "context_optimizer.max_context_tokens"]
				}
			}
		},
		"context_optimizer.system_prompt_budget_pct",
		"context_optimizer.query_budget_pct",
		"context_optimizer.document_budget_pct",
		"context_optimizer.history_budget_pct"
	]
}
