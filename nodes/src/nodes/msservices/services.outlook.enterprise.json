{
	//
	// TEST ONLY: minimal definition so a task can reach the Outlook Enterprise endpoint.
	// The shipped definitions were removed from OSS in 3cf3cf32.
	//
	"title": "Outlook Enterprise",
	"protocol": "outlook-enterprise://",
	"node": "cpp",
	//
	// Required (for "node": "cpp"):
	//		Base name of the node's shared library. All three services of this
	//		node name it, so the library is loaded once.
	//
	"path": "msservices",
	"classType": [],
	"capabilities": [
		"internal",
		"network"
	],
	"prefix": "Outlook Enterprise",
	"description": ["Outlook Enterprise source endpoint."],
	"icon": "outlook.svg",
	"lanes": {
		"_source": [
			"tags"
		]
	},
	"input": [
		{
			"lane": "_source",
			"output": [
				{
					"lane": "tags",
					"description": "Outputs documents to be processed."
				}
			]
		}
	],
	//
	// Optional:
	//		Local property definitions. The app registration lives in the
	//		"parameters" group, which is where the C++ node reads it; the
	//		client secret is a secret the account variable supplies.
	//
	"propertyDefinitions": {
		"ms.tenant": {
			"type": "string",
			"title": "Tenant",
			"description": "Directory (tenant) id."
		},
		"ms.clientId": {
			"type": "string",
			"title": "Client id",
			"description": "Application (client) id.",
			"required": true
		},
		"ms.clientSecret": {
			"type": "string",
			"title": "Client secret",
			"description": "Application client secret.",
			"secret": true,
			"env": "ROCKETRIDE_OUTLOOK_ENTERPRISE_CLIENT_SECRET",
			"required": true
		}
	},
	//
	// Required:
	//		Defines the properties shown in the pipeline builder side panel, in order
	//
	"properties": [
		"type",
		"source.mode",
		{
			"name": "parameters",
			"properties": [
				"ms.tenant",
				"ms.clientId",
				"ms.clientSecret"
			]
		},
		{
			"name": "include",
			"type": "array",
			"description": "Example path: mailbox/folder/*",
			"item": "Pipe.include.path"
		},
		{
			"name": "exclude",
			"type": "array",
			"description": "Example path: mailbox/folder/*",
			"item": "Pipe.exclude.path"
		}
	]
}
