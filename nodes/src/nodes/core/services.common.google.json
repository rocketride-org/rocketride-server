//
// Common property definitions for google cloud - these will be merged into the
// service definition as required by the service
//
{
	"propertyDefinitions": {
		"google.authType": {
			"type": "string",
			"title": "Authentication Type",
			"default": "service",
			"readonly": true,
			"enum": {
				"service": {
					"title": "Service",
					"properties": ["google.customerId", "google.adminEmail", "google.serviceKey"]
				},
				"user": {
					"title": "User",
					"properties": ["google.userAuth"]
				}
			}
		},
		"google.userAuth": {
			"title": "Login with Google",
			"type": "oauth2"
		},
		"google.customerId": {
			"type": "string",
			"title": "Customer ID",
			"description": [
				"Enter your Google Workspace Customer ID.\n\n",
				"This unique identifier is assigned to your organization by Google. ",
				"It is used to specify the particular Google ",
				"Workspace domain you want to manage."
			]
		},
		"google.adminEmail": {
			"type": "string",
			"title": "Administrator E-mail",
			"description": [
				"Enter the email address of a Google Workspace administrator.\n\n",
				"This email should belong to a user with administrative privileges ",
				"in your Google Workspace domain."
			]
		},
		"google.serviceKey": {
			"type": "upload",
			"title": "Service Account Key File",
			"description": [
				"Upload the JSON key file for your Google Workspace service account.\n\n",
				"This file contains the credentials necessary to authenticate API requests."
			],
			"options": {
				"accept": ".json"
			}
		}
	}
}
