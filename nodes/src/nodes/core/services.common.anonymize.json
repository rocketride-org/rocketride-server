//
// Common property definitions for anonymization - these will be merged into
// the service definition as required by the service
//
{
	"propertyDefinitions": {
		"anonymizeChar": {
			"type": "string",
			"title": "Anonymization Character",
			"description": "Specify a character that will mask any sensitive data in the text.\n\nFor example, if you specify the characher \"*\", then the text \"SSN: 064 70 6733\" will become \"SSN: ***********\". If you specify the character \"?\" the text will become \"SSN: ???????????\".",
			"minLength": 1,
			"maxLength": 1,
			"default": "█"
		},
		"anonymizeAll": {
			"type": "boolean",
			"title": "Anonymize All Data",
			"description": "Enable it if you want to collapse to the fixed length any sensitive data in the text.\n\nFor example, if you enable it, then the text \"SSN: 064 70 6733\" will become \"SSN: ***\". If you disable it, the text will remain \"SSN: ***********\".",
			"default": false
		},
		"anonymize": {
			"type": "boolean",
			"title": "Anonymize Classified Information",
			"description": "Enable it if you want to mask any sensitive data in the text. If you leave it disabled, the text will be output as it is.\n\nFor example, if you enable it, then the text \"SSN: 064 70 6733\" will become \"SSN: ***********\". If you disable it, the text will remain \"SSN: 064 70 6733\".",
			"default": false,
			"hidden": true
		}
	}
}
