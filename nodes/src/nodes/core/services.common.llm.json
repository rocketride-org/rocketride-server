//
// Common property definitions for LLM services - these will be merged into the
// service definition as required by the service
//
{
	"propertyDefinitions": {
		"llm.local.serverbase": {
			"type": "string",
			"title": "LLM URL",
			"description": "Base url the model is hosted under.",
			"default": "http://localhost:11434/v1"
		},
		"llm.cloud.apikey": {
			"type": "string",
			"title": "API key (Token)",
			"description": "Enter your API key or token",
			"secret": true
		},
		"llm.cloud.project": {
			"type": "string",
			"title": "Project (Organization)",
			"description": "LLM project or organization name"
		},
		"llm.cloud.location": {
			"type": "string",
			"title": "Location",
			"description": "LLM server location"
		},
		"llm.cloud.modelSource": {
			"type": "string",
			"title": "Model source",
			"hidden": true
		}
	}
}
