//
// Common field definitions for Microsoft 365 - these will be merged into the
// service definition as required by the service
//
{
	"fields": {
		"microsoft.authType": {
			"type": "string",
			"title": "Authentication Type",
			"default": "service",
			"readonly": true,
			"enum": ["service", "user"],
			"enumNames": ["App (client credentials)", "User"],
			"conditional": [
				{
					"value": "service",
					"properties": ["microsoft.tenantId", "microsoft.clientId", "microsoft.clientSecret", "microsoft.userPrincipalName"]
				},
				{
					"value": "user",
					"properties": ["microsoft.oAuthButton", "microsoft.userToken"]
				}
			]
		},
		"microsoft.oAuthButton": {
			"title": "Login with Microsoft",
			"type": "string",
			"ui:widget": "MicrosoftButtonWidget",
			"optional": true
		},
		"microsoft.tenantId": {
			"type": "string",
			"title": "Tenant ID",
			"description": "Enter your Microsoft Entra ID tenant (directory) ID.\n\nFound in the Azure portal under Microsoft Entra ID > Overview."
		},
		"microsoft.clientId": {
			"type": "string",
			"title": "Client ID",
			"description": "Application (client) ID of your Entra app registration."
		},
		"microsoft.clientSecret": {
			"type": "string",
			"title": "Client Secret",
			"description": "Client secret of your Entra app registration. The app needs Microsoft Graph application permissions for this service, with admin consent granted.",
			"ui:widget": "password"
		},
		"microsoft.userPrincipalName": {
			"type": "string",
			"title": "Acting User (UPN)",
			"description": "User principal name (e-mail) the app acts as. App-only Graph calls target /users/{upn}; this is required for App authentication."
		},
		"microsoft.userToken": {
			"type": "string",
			"title": "Access Token",
			"description": "It is a long term token that allows you to get new access tokens to access the Microsoft Graph API.",
			"ui:widget": "password",
			"ui:disabled": true
		}
	}
}
