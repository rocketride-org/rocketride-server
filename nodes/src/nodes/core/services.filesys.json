{
	//
	// Required:
	//		The displayable name of this node
	//
	"title": "Local File System",
	//
	// Required:
	//		The protocol is the endpoint protocol
	//
	"protocol": "filesys://",
	//
	// Required:
	//		Class type of the node - what it does
	//
	"classType": ["source"],
	//
	// Required:
	//		Capabilities are flags that change the behavior of the underlying
	//		engine
	//
	"capabilities": ["filesystem", "noremote", "security", "nosaas"],
	//
	// Optional:
	//		Supported actions - if not specified, no actions are supported
	//		engine
	//
	"actions": ["export", "delete", "download"],
	//
	// Required:
	//		The prefix map when added/removed when convertting URLs <=> paths
	"prefix": "File System",
	//
	// Optional:
	//		Description to of this driver
	//
	"description": [
		"A source component that reads data from the local file system. It ",
		"enables ingestion of files and documents stored in directories for ",
		"further processing within the pipeline. Configurable with path settings ",
		"and file filters, the component supports flexible access to unstructured ",
		"data across various formats."
	],
	//
	// Optional:
	//	  The icon is the icon to display in the UI for this node
	//
	"icon": "file-system.svg",
	"documentation": "https://docs.rocketride.org",
	//
	//
	//	Optional:
	//		As a pipe component, define what this pipe component takes
	//		and what it produces
	//
	"lanes": {
		"_source": ["tags"]
	},
	//
	// Optional:
	//		Local property definitions - these define fields only for the
	//		current service. You may also reference global propertyDefinitions
	//		(see services.common.json) from "properties" via "use".
	//
	"propertyDefinitions": {
		"excludeExternalDrives": {
			"type": "boolean",
			"title": "Exclude external drives",
			"default": true
		},
		"excludeEnableGlobal": {
			"type": "boolean",
			"title": "Exclude typical OS files and directories",
			"default": true
		},
		"excludeSymlinks": {
			"type": "boolean",
			"title": "Exclude symlinks",
			"default": true
		}
	},
	//
	// Required:
	//		Defines the fields shown in the node's config panel, in order
	//
	"properties": [
		"type",
		"actions",
		"source.mode",
		{
			"name": "parameters",
			"properties": [
				"excludeExternalDrives",
				"excludeEnableGlobal",
				"excludeSymlinks"
			]
		},
		{
			"name": "include",
			"type": "array",
			"description": "Example Path: /Users/usr/Documents/product-images/*",
			"item": "Pipe.include.path"
		},
		{
			"name": "exclude",
			"type": "array",
			"description": "Example Path: /Users/usr/Documents/product-images/*",
			"item": "Pipe.exclude.path"
		}
	]
}
