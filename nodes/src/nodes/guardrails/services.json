{
	//
	// Required:
	//		The displayable name of this node
	//
	"title": "Guardrails",
	//
	// Required:
	//		The protocol is the endpoint protocol
	//
	"protocol": "guardrails://",
	//
	// Required:
	//		Class type of the node - what it does
	//
	"classType": [
		"guard"
	],
	//
	// Required:
	//		Capabilities are flags that change the behavior of the underlying
	//		engine
	//
	"capabilities": [
		"experimental"
	],
	//
	// Optional:
	//		Register is either filter, endpoint or ignored if not specified. If the
	//		type is specified, a factory is registered of that given type
	//
	"register": "filter",
	//
	// Optional:
	//		The node is the actual pyhsical node to instantiate - if
	//		not specified, the protocol will be used
	//
	"node": "python",
	//
	// Optional:
	//		The path is the executable/script code - it is node dependent
	// 		and is optional for most node
	//
	"path": "nodes.guardrails",
	//
	// Required:
	//		The prefix map when added/removed when convertting URLs <=> paths
	//
	"prefix": "guardrails",
	//
	// Optional:
	//		Description to of this driver
	//
	"description": [
		"A comprehensive input/output guardrails filter for AI safety. ",
		"Checks questions before they reach the LLM (prompt injection, topic restriction, ",
		"input length) and checks answers after the LLM responds (hallucination detection, ",
		"content safety, PII leak detection, format compliance).</br>",
		"</br>",
		"<b>Policy modes</b>: block (reject violations), warn (log and continue), log (silent logging)."
	],
	//
	// Optional:
	//	  The icon is the icon to display in the UI for this node
	//
	"icon": "util-guard.svg",
	"documentation": "https://docs.rocketride.org/nodes/guardrails",
	//
	// Optional:
	//	 The tile is the displayable name of this node
	//
	"tile": [],
	//
	//	Optional:
	//		As a pipe component, define what this pipe component takes
	//		and what it produces
	//
	"lanes": {
		"questions": [
			"questions"
		],
		"answers": [
			"answers"
		],
		"documents": [
			"documents"
		]
	},
	//
	//	Test configuration for automated node testing
	//
	"test": {
		"profiles": [
			"basic"
		],
		"cases": [
			{
				"questions": {
					"questions": [
						{
							"text": "What is the weather today?"
						}
					]
				},
				"expect": {
					"questions": {
						"notEmpty": true
					}
				}
			}
		]
	},
	//
	// Optional:
	//		Local property definitions. The profile is the selector. Basic
	//		and Strict pin most checks as constants and expose only the
	//		knobs that made sense to change; Strict aliases the shared
	//		definitions with its own defaults. Custom exposes every check.
	//
	"propertyDefinitions": {
		"guardrails.policy_mode": {
			"type": "string",
			"title": "Policy mode",
			"description": "How to handle violations: block (reject), warn (log + continue), log (silent)",
			"default": "warn",
			"enum": [
				["block", "Block: Reject on violation"],
				["warn", "Warn: Log and continue"],
				["log", "Log: Silent logging only"]
			]
		},
		"guardrails.strict.policy_mode": {
			"base": "guardrails.policy_mode",
			"default": "block"
		},
		"guardrails.enable_prompt_injection": {
			"type": "boolean",
			"title": "Enable prompt injection detection",
			"description": "Detect and flag prompt injection attempts in input",
			"default": true
		},
		"guardrails.enable_content_safety": {
			"type": "boolean",
			"title": "Enable content safety check",
			"description": "Detect harmful or unsafe content in output",
			"default": true
		},
		"guardrails.enable_pii_detection": {
			"type": "boolean",
			"title": "Enable PII detection",
			"description": "Detect personal identifiable information (emails, phones, SSNs, credit cards) in output",
			"default": true
		},
		"guardrails.enable_hallucination_check": {
			"type": "boolean",
			"title": "Enable hallucination check",
			"description": "Verify that output claims are grounded in source documents",
			"default": true
		},
		"guardrails.max_input_length": {
			"type": "integer",
			"title": "Max input length (chars)",
			"description": "Maximum character count for input text (0 = no limit)",
			"default": 0,
			"minimum": 0
		},
		"guardrails.max_tokens_estimate": {
			"type": "integer",
			"title": "Max tokens (estimate)",
			"description": "Maximum estimated token count for input text (0 = no limit)",
			"default": 0,
			"minimum": 0
		},
		"guardrails.strict.max_tokens_estimate": {
			"base": "guardrails.max_tokens_estimate",
			"default": 4096
		},
		"guardrails.expected_format": {
			"type": "string",
			"title": "Expected output format",
			"description": "Validate that output matches this format (empty = no check)",
			"default": "",
			"enum": [
				["", "None: No format check"],
				["json", "JSON"],
				["markdown", "Markdown"],
				["bullet_list", "Bullet list"],
				["numbered_list", "Numbered list"]
			]
		},
		"guardrails.blocked_topics": {
			"type": "array",
			"title": "Blocked topics",
			"description": "Keywords for topics that should be rejected",
			"item": { "name": "topic", "type": "string" },
			"default": []
		},
		"guardrails.allowed_topics": {
			"type": "array",
			"title": "Allowed topics",
			"description": "If set, input must contain at least one of these keywords",
			"item": { "name": "topic", "type": "string" },
			"default": []
		}
	},
	//
	// Required:
	//		Defines the properties shown in the pipeline builder side panel, in order
	//
	"properties": [
		{
			"name": "profile",
			"type": "string",
			"title": "Profile",
			"description": "Guardrails profile",
			"default": "basic",
			"enum": {
				"basic": {
					"title": "Basic: Prompt injection + PII detection",
					"properties": [
						"guardrails.policy_mode",
						{ "name": "enable_prompt_injection", "type": "constant", "default": true },
						{ "name": "enable_content_safety", "type": "constant", "default": false },
						{ "name": "enable_pii_detection", "type": "constant", "default": true },
						{ "name": "enable_hallucination_check", "type": "constant", "default": false },
						{ "name": "max_input_length", "type": "constant", "default": 0 },
						{ "name": "max_tokens_estimate", "type": "constant", "default": 0 },
						{ "name": "expected_format", "type": "constant", "default": "" },
						{ "name": "blocked_topics", "type": "constant", "default": [] },
						{ "name": "allowed_topics", "type": "constant", "default": [] }
					]
				},
				"strict": {
					"title": "Strict: All checks enabled, block on violation",
					"properties": [
						"guardrails.strict.policy_mode",
						{ "name": "enable_prompt_injection", "type": "constant", "default": true },
						{ "name": "enable_content_safety", "type": "constant", "default": true },
						{ "name": "enable_pii_detection", "type": "constant", "default": true },
						{ "name": "enable_hallucination_check", "type": "constant", "default": true },
						{ "name": "max_input_length", "type": "constant", "default": 50000 },
						"guardrails.strict.max_tokens_estimate",
						"guardrails.expected_format",
						{ "name": "blocked_topics", "type": "constant", "default": [] },
						{ "name": "allowed_topics", "type": "constant", "default": [] }
					]
				},
				"custom": {
					"title": "Custom: Configure checks individually",
					"properties": [
						"guardrails.policy_mode",
						"guardrails.enable_prompt_injection",
						"guardrails.enable_content_safety",
						"guardrails.enable_pii_detection",
						"guardrails.enable_hallucination_check",
						"guardrails.max_input_length",
						"guardrails.max_tokens_estimate",
						"guardrails.expected_format",
						"guardrails.blocked_topics",
						"guardrails.allowed_topics"
					]
				}
			}
		}
	]
}
