{
	//
	// Required:
	//		The displayable name of this node
	//
	"title": "Ollama",
	//
	// Required:
	//		The protocol is the endpoint protocol
	//
	"protocol": "llm_ollama://",
	//
	// Required:
	//		Class type of the node - what it does
	//
	"classType": ["llm"],
	//
	// Required:
	//		Capabilities are flags that change the behavior of the underlying
	//		engine
	//
	"capabilities": ["invoke"],
	//
	// Optional:
	//		Register is either filter, endpoint or ignored if not specified. If the
	//		type is specified, a factory is registered of that given type
	//
	"register": "filter",
	//
	// Optional:
	//		The node is the actual physical node to instantiate - if
	//		not specified, the protocol will be used
	//
	"node": "python",
	//
	// Optional:
	//		The path is the executable/script code - it is node dependent
	//		and is optional for most node
	//
	"path": "nodes.llm_ollama",
	//
	// Required:
	//		The prefix map when added/removed when converting URLs <=> paths
	//
	"prefix": "llm",
	//
	// Optional:
	//		Description of this driver
	//
	"description": [
		"A component that integrates with locally-hosted language models through Ollama. ",
		"It enables on-premise text generation, summarization, and question answering ",
		"without relying on external APIs. Ideal for privacy-sensitive applications, the ",
		"component offers low-latency inference and supports various open-source models. It ",
		"allows organizations to leverage LLM capabilities while maintaining full control ",
		"over data and infrastructure."
	],
	//
	// Optional:
	//		The icon is the icon to display in the UI for this node
	//
	"icon": "ollama.svg",
	"documentation": "https://docs.rocketride.org/nodes/llm_ollama",
	//
	// Optional:
	//		Rendering hints to the UI which indicate which fields of
	//		the configuration should be used to display information
	//
	"tile": ["Model: ${parameters.llm_ollama.model}"],
	//
	// Optional:
	//		As a pipe component, define what this pipe component takes
	//		and what it produces
	//
	"lanes": {
		"questions": ["answers"]
	},
	//
	// Optional:
	//		Local property definitions. The model is the selector (one branch per
	//		model, the branch value is the model id); each branch pins its context
	//		window and capabilities as constants, and the leaves every model shares
	//		(credentials, generation settings) sit at the root and are stored flat.
	//		The "custom" branch takes a model id the catalog does not list.
	//
	"propertyDefinitions": {
		"llm_ollama.serverbase": { "base": "llm.local.serverbase", "default": "http://localhost:11434/v1" },
		"llm_ollama.temperature": {
			"type": "number",
			"title": "Temperature",
			"description": "Sampling temperature. Left unset by default so ollama.py can choose: 0 for standard models, and 1.0 for reasoning models (gpt-oss, deepseek-r1, qwen3, qwq, ...) so they emit a final answer instead of looping on empty output. Set an explicit value here to override the auto behavior."
		},
		"llm_ollama.reasoning_effort": {
			"type": "string",
			"title": "Reasoning Effort",
			"description": "Optional reasoning budget for reasoning models: low, medium, or high. Leave unset to let reasoning models auto-use 'low'; a value set here always wins. Ignored by non-reasoning models.",
			"enum": ["low", "medium", "high"]
		},
		"llm_ollama.customModel": {
			"type": "string",
			"title": "Model id",
			"description": "Model id exactly as the provider names it",
			"required": true
		},
		"llm_ollama.custom.modelTotalTokens": { "type": "number", "title": "Tokens", "description": "Total Tokens", "minimum": 1, "default": 16385 },
		"llm_ollama.custom.modelOutputTokens": {
			"type": "integer",
			"title": "Output Tokens",
			"description": "Most tokens the model may write in one reply (at least 1,024). Leave it empty to keep the node's default. Reasoning models count their thinking against this limit: set it well above the reply you expect, or they can spend it all thinking and return nothing. It cannot exceed Tokens; a larger value is lowered to it.",
			"minimum": 1024
		}
	},
	//
	// Required:
	//		Defines the properties shown in the pipeline builder side panel, in order
	//
	"properties": [
		{
			"name": "model",
			"type": "string",
			"title": "Model",
			"description": "LLM model",
			"default": "llama3.3:latest",
			"enum": {
				"llama3.3:latest": {
					"title": "Llama 3.3",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 }
					]
				},
				"llama3.1:8b": {
					"title": "Llama 3.1 8B",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 }
					]
				},
				"llama3.1:70b": {
					"title": "Llama 3.1 70B",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 }
					]
				},
				"llama3.1:405b": {
					"title": "Llama 3.1 405B",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 }
					]
				},
				"phi4": {
					"title": "Phi 4 14B",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 16000 }
					]
				},
				"llama3.2": {
					"title": "Llama 3.2 3B",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 }
					]
				},
				"llama3.2:1b": {
					"title": "Llama 3.2 1B",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 }
					]
				},
				"llama4:latest": {
					"title": "Llama 4 Latest",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 10000000 }
					]
				},
				"mistral": {
					"title": "Mistral 7B",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 32000 }
					]
				},
				"qwen2.5": {
					"title": "Qwen 2.5 7B",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 }
					]
				},
				"qwen2.5:0.5b": {
					"title": "Qwen 2.5 0.5B",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 }
					]
				},
				"qwen2.5:1.5b": {
					"title": "Qwen 2.5 1.5B",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 }
					]
				},
				"qwen2.5:3b": {
					"title": "Qwen 2.5 3B",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 }
					]
				},
				"qwen2.5:14b": {
					"title": "Qwen 2.5 14B",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 }
					]
				},
				"qwen2.5:32b": {
					"title": "Qwen 2.5 32B",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 }
					]
				},
				"qwen2.5:72b": {
					"title": "Qwen 2.5 72B",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 }
					]
				},
				"qwen3:latest": {
					"title": "Qwen 3 Latest",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 }
					]
				},
				"deepseek-r1:1.5b": {
					"title": "DeepSeek R1 1.5B",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 }
					]
				},
				"deepseek-r1:7b": {
					"title": "DeepSeek R1 7B",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 }
					]
				},
				"deepseek-r1:14b": {
					"title": "DeepSeek R1 14B",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 }
					]
				},
				"deepseek-r1:32b": {
					"title": "DeepSeek R1 32B",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 }
					]
				},
				"deepseek-r1:671b": {
					"title": "DeepSeek R1 671B",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 }
					]
				},
				"custom": {
					"title": "Custom model",
					"properties": ["llm_ollama.customModel", "llm_ollama.custom.modelTotalTokens", "llm_ollama.custom.modelOutputTokens"]
				}
			}
		},
		"llm_ollama.serverbase",
		"llm_ollama.temperature",
		"llm_ollama.reasoning_effort"
	],
	//
	// Optional:
	//		Test configuration for automated node testing. "profiles" lists
	//		values of the "model" selector; the framework writes the selected one
	//		at "model" and the mock credentials at their paths.
	//
	"test": [
		{
			"profiles": ["llama4:latest"],
			"outputs": ["answers"],
			"cases": [
				{
					"name": "LLM returns mock response",
					"text": "What is 2+2?",
					"expect": {
						"answers": { "contains": "Mock LLM response" }
					}
				}
			]
		},
		{
			"requires": ["ROCKETRIDE_OLLAMA_SERVERBASE", "ROCKETRIDE_OLLAMA_MODEL_QWEN2_5_0_5B"],
			"avoidMocks": true,
			"profiles": ["qwen2.5:0.5b"],
			"outputs": ["answers"],
			"cases": [
				{
					"name": "LLM returns real response",
					"text": "What is 4*9?",
					"expect": {
						"answers": { "contains": "36" }
					}
				}
			]
		}
	]
}
