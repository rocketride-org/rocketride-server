{
	//
	// Required:
	//		The displayable name of this node
	//
	"title": "Amazon Bedrock",
	//
	// Required:
	//		The protocol is the endpoint protocol
	//
	"protocol": "llm_bedrock://",
	//
	// Required:
	//		Class type of the node - what it does
	//
	"classType": ["llm"],
	//
	// Required:
	//		Capabilities are flags that change the behavior of the underlying
	//		engine
	//
	"capabilities": ["invoke"],
	//
	// Optional:
	//		Register is either filter, endpoint or ignored if not specified. If the
	//		type is specified, a factory is registered of that given type
	//
	"register": "filter",
	//
	// Optional:
	//		The node is the actual physical node to instantiate - if
	//		not specified, the protocol will be used
	//
	"node": "python",
	//
	// Optional:
	//		The path is the executable/script code - it is node dependent
	//		and is optional for most node
	//
	"path": "nodes.llm_bedrock",
	//
	// Required:
	//		The prefix map when added/removed when converting URLs <=> paths
	//
	"prefix": "llm",
	//
	// Optional:
	//		Description of this driver
	//
	"description": [
		"A component that connects to Amazon Bedrock, providing access to a range ",
		"of foundation models from leading AI providers through a unified AWS interface. ",
		"It supports text generation, summarization, classification, and other natural language ",
		"processing tasks. With flexible model selection and secure, serverless deployment, the ",
		"component integrates seamlessly into AWS-powered pipelines, offering scalable, ",
		"enterprise-ready AI capabilities without managing infrastructure."
	],
	//
	// Optional:
	//		The icon is the icon to display in the UI for this node
	//
	"icon": "bedrock.svg",
	"documentation": "https://docs.rocketride.org/nodes/llm_bedrock",
	//
	// Optional:
	//		Rendering hints to the UI which indicate which fields of
	//		the configuration should be used to display information
	//
	"tile": ["Model: ${parameters.llm_bedrock.model}"],
	//
	// Optional:
	//		As a pipe component, define what this pipe component takes
	//		and what it produces
	//
	"lanes": {
		"questions": ["answers"]
	},
	//
	// Optional:
	//		Local property definitions. The model is the selector (one branch per
	//		model, the branch value is the model id); each branch pins its context
	//		window and capabilities as constants, and the leaves every model shares
	//		(credentials, generation settings) sit at the root and are stored flat.
	//		The "custom" branch takes a model id the catalog does not list.
	//
	"propertyDefinitions": {
		"llm_bedrock.accessKey": { "base": "aws.accessKey", "env": "ROCKETRIDE_LLM_BEDROCK_ACCESS_KEY", "required": true },
		"llm_bedrock.secretKey": { "base": "aws.secretKey", "env": "ROCKETRIDE_LLM_BEDROCK_SECRET_KEY", "required": true },
		"llm_bedrock.region": { "base": "aws.region", "default": "us-east-1", "required": true },
		"llm_bedrock.customModel": {
			"type": "string",
			"title": "Model id",
			"description": "Model id exactly as the provider names it",
			"required": true
		},
		"llm_bedrock.custom.modelTotalTokens": { "type": "number", "title": "Tokens", "description": "Total Tokens", "minimum": 1, "default": 256000 },
		"llm_bedrock.custom.modelOutputTokens": {
			"type": "integer",
			"title": "Output Tokens",
			"description": "Most tokens the model may write in one reply (at least 1,024). Leave it empty to keep the node's default. Reasoning models count their thinking against this limit: set it well above the reply you expect, or they can spend it all thinking and return nothing. It cannot exceed Tokens; a larger value is lowered to it.",
			"minimum": 1024
		}
	},
	//
	// Required:
	//		Defines the properties shown in the pipeline builder side panel, in order
	//
	"properties": [
		{
			"name": "model",
			"type": "string",
			"title": "Model",
			"description": "LLM model",
			"default": "meta.llama3-3-70b-instruct-v1:0",
			"enum": {
				"ai21.jamba-1-5-large-v1:0": {
					"title": "Jamba 1.5 Large",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 256000 }
					]
				},
				"ai21.jamba-1-5-mini-v1:0": {
					"title": "Jamba 1.5 Mini",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 256000 }
					]
				},
				"amazon.titan-text-express-v1": {
					"title": "Titan Text Express",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 8192 }
					]
				},
				"amazon.nova-2-lite-v1:0": {
					"title": "Nova 2 Lite",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 1000000 }
					]
				},
				"anthropic.claude-3-7-sonnet-20250219-v1:0": {
					"title": "Claude Sonnet 3.7",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 200000 }
					]
				},
				"anthropic.claude-sonnet-4-5-20250929-v1:0": {
					"title": "Claude Sonnet 4.5",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 200000 }
					]
				},
				"anthropic.claude-3-5-haiku-20241022-v1:0": {
					"title": "Claude Haiku 3.5",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 200000 }
					]
				},
				"anthropic.claude-haiku-4-5-20251001-v1:0": {
					"title": "Claude Haiku 4.5",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 200000 }
					]
				},
				"anthropic.claude-opus-4-20250514-v1:0": {
					"title": "Claude Opus 4",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 200000 }
					]
				},
				"anthropic.claude-opus-4-5-20251101-v1:0": {
					"title": "Claude Opus 4.5",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 200000 }
					]
				},
				"cohere.command-r-plus-v1:0": {
					"title": "Command R+",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 }
					]
				},
				"cohere.command-r-v1:0": {
					"title": "Command R",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 }
					]
				},
				"meta.llama3-1-8b-instruct-v1:0": {
					"title": "Llama 3.1 8B Instruct",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 }
					]
				},
				"meta.llama3-1-70b-instruct-v1:0": {
					"title": "Llama 3.1 70B Instruct",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 }
					]
				},
				"meta.llama3-3-70b-instruct-v1:0": {
					"title": "Llama 3.3 70B Instruct",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 }
					]
				},
				"meta.llama3-2-1b-instruct-v1:0": {
					"title": "Llama 3.2 1B Instruct",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 }
					]
				},
				"meta.llama3-2-3b-instruct-v1:0": {
					"title": "Llama 3.2 3B Instruct",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 }
					]
				},
				"meta.llama3-2-11b-instruct-v1:0": {
					"title": "Llama 3.2 11B Vision Instruct",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 }
					]
				},
				"meta.llama3-2-90b-instruct-v1:0": {
					"title": "Llama 3.2 90B Vision Instruct",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 }
					]
				},
				"meta.llama4-scout-17b-instruct-v1:0": {
					"title": "Llama 4 Scout 17B Instruct",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 3500000 }
					]
				},
				"meta.llama4-maverick-17b-instruct-v1:0": {
					"title": "Llama 4 Maverick 17B Instruct",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 1000000 }
					]
				},
				"custom": {
					"title": "Custom model",
					"properties": ["llm_bedrock.customModel", "llm_bedrock.custom.modelTotalTokens", "llm_bedrock.custom.modelOutputTokens"]
				}
			}
		},
		"llm_bedrock.accessKey",
		"llm_bedrock.secretKey",
		"llm_bedrock.region"
	],
	//
	// Optional:
	//		Test configuration for automated node testing. "profiles" lists
	//		values of the "model" selector; the framework writes the selected one
	//		at "model" and the mock credentials at their paths.
	//
	"test": {
		"profiles": ["meta.llama4-maverick-17b-instruct-v1:0"],
		"outputs": ["answers"],
		"cases": [
			{
				"name": "LLM returns mock response",
				"text": "What is 2+2?",
				"expect": {
					"answers": { "contains": "Mock LLM response" }
				}
			}
		]
	}
}
