{
	"title": "Video Composer",
	"protocol": "video_composer://",
	"classType": ["video"],
	"capabilities": [],
	"register": "filter",
	"node": "python",
	"path": "nodes.video_composer",
	"prefix": "video_composer",
	"description": ["Stitches a sequence of image frames into an MP4 video using FFmpeg. ", "Place after any image-producing filter to re-encode matched frames into ", "a playable video clip."],
	"icon": "video_composer.svg",
	"documentation": "https://docs.rocketride.org/nodes/video_composer",
	"lanes": {
		"image": ["video"]
	},
	"input": [
		{
			"lane": "image",
			"description": "Image frames to stitch into a video.",
			"output": [
				{
					"lane": "video",
					"description": "Encoded MP4 video from the input frames."
				}
			]
		}
	],
	//
	// Optional:
	//		Local property definitions. The quality preset is the selector; the frame
	//		rate and codec are shared by every preset and hoist beside it, the CRF
	//		keeps its own default per preset through a {base, default} alias.
	//
	"propertyDefinitions": {
		"composer.fps": {
			"type": "number",
			"title": "Output frame rate (fps)",
			"description": "Playback speed of the output video. Should match the upstream frame rate.",
			"default": 1.0,
			"minimum": 0.01
		},
		"composer.codec": {
			"type": "constant",
			"default": "libx264"
		},
		"composer.crf": {
			"type": "number",
			"title": "Quality (CRF)",
			"description": "Constant Rate Factor for H.264. Lower = better quality, larger file. Range 0-51.",
			"default": 23,
			"minimum": 0,
			"maximum": 51
		},
		"composer.high.crf": {
			"base": "composer.crf",
			"default": 18
		}
	},
	"properties": [
		"type",
		{
			"name": "profile",
			"title": "Output quality",
			"description": "Video encoding quality preset",
			"type": "string",
			"default": "standard",
			"enum": {
				"standard": {
					"title": "Standard quality (H.264, CRF 23)",
					"properties": ["composer.fps", "composer.codec", "composer.crf"]
				},
				"high": {
					"title": "High quality (H.264, CRF 18)",
					"properties": ["composer.fps", "composer.codec", "composer.high.crf"]
				}
			}
		}
	]
}
