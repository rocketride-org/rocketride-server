						{ "name": "serverbase", "type": "constant", "default": "https://api.gmi-serving.com/v1" }
					]
				},
				"custom": {
					"title": "Custom model",
					"properties": [
						"llm_gmi_cloud.customModel",
						"llm_gmi_cloud.custom.modelTotalTokens",
						"llm_gmi_cloud.custom.modelOutputTokens",
						"llm_gmi_cloud.custom.serverbase"
					]
				}
			}
		},
		"llm_gmi_cloud.apikey"
	],
	//
	// Optional:
	//		Test configuration for automated node testing. "profiles" lists
	//		values of the "model" selector; the framework writes the selected one
	//		at "model" and the mock credentials at their paths.
	//
	"test": {
		"profiles": ["deepseek-ai/DeepSeek-V3-0324"],
		"outputs": ["answers"],
		"cases": [
			{
				"name": "LLM returns mock response",
				"text": "What is 2+2?",
				"expect": {
					"answers": { "contains": "Mock LLM response" }
				}
			}
		]
	}
}
