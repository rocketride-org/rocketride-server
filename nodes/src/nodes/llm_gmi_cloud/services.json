{
	//
	// Required:
	//		The displayable name of this node
	//
	"title": "GMI Cloud",
	//
	// Required:
	//		The protocol is the endpoint protocol
	//
	"protocol": "llm_gmi_cloud://",
	//
	// Required:
	//		Class type of the node - what it does
	//
	"classType": ["llm"],
	//
	// Required:
	//		Capabilities are flags that change the behavior of the underlying
	//		engine
	//
	"capabilities": ["invoke"],
	//
	// Optional:
	//		Register is either filter, endpoint or ignored if not specified. If the
	//		type is specified, a factory is registered of that given type
	//
	"register": "filter",
	//
	// Optional:
	//		The node is the actual physical node to instantiate - if
	//		not specified, the protocol will be used
	//
	"node": "python",
	//
	// Optional:
	//		The path is the executable/script code - it is node dependent
	//		and is optional for most node
	//
	"path": "nodes.llm_gmi_cloud",
	//
	// Required:
	//		The prefix map when added/removed when converting URLs <=> paths
	//
	"prefix": "llm",
	//
	// Optional:
	//		Description of this driver
	//
	"description": [
		"A component that connects to GMI Cloud's large language models for advanced ",
		"natural language processing. GMI Cloud hosts 100+ OpenAI-compatible models ",
		"including Llama 4, Qwen3, DeepSeek, GPT, Claude, and Gemini on owned H100/H200 ",
		"GPU infrastructure. It enables capabilities like text generation, summarization, ",
		"reasoning, and code understanding across a wide range of open-weight and ",
		"proprietary models through a unified OpenAI-compatible API."
	],
	//
	// Optional:
	//		The icon is the icon to display in the UI for this node
	//
	"icon": "gmi_cloud.svg",
	"documentation": "https://docs.rocketride.org/nodes/llm_gmi_cloud",
	//
	// Optional:
	//		Rendering hints to the UI which indicate which fields of
	//		the configuration should be used to display information
	//
	"tile": ["Model: ${parameters.llm_gmi_cloud.model}"],
	//
	// Optional:
	//		As a pipe component, define what this pipe component takes
	//		and what it produces
	//
	"lanes": {
		"questions": ["answers"]
	},
	//
	// Optional:
	//		Local property definitions. The model is the selector (one branch per
	//		model, the branch value is the model id); each branch pins its context
	//		window and capabilities as constants, and the leaves every model shares
	//		(credentials, generation settings) sit at the root and are stored flat.
	//		The "custom" branch takes a model id the catalog does not list.
	//
	"propertyDefinitions": {
		"llm_gmi_cloud.apikey": {
			"base": "llm.cloud.apikey",
			"description": "GMI Cloud API key",
			"env": "ROCKETRIDE_LLM_GMI_CLOUD_APIKEY",
			"required": true
		},
		"llm_gmi_cloud.serverbase": {
			"type": "string",
			"title": "Endpoint URL",
			"description": "Deploy the model in the GMI Cloud console and paste its endpoint URL here.",
			"required": true
		},
		"llm_gmi_cloud.customModel": {
			"type": "string",
			"title": "Model id",
			"description": "Model id exactly as the provider names it",
			"required": true
		},
		"llm_gmi_cloud.custom.modelTotalTokens": { "type": "number", "title": "Tokens", "description": "Total Tokens", "minimum": 1, "default": 16384 },
		"llm_gmi_cloud.custom.modelOutputTokens": {
			"type": "integer",
			"title": "Output Tokens",
			"description": "Most tokens the model may write in one reply (at least 1,024). Leave it empty to keep the node's default. Reasoning models count their thinking against this limit: set it well above the reply you expect, or they can spend it all thinking and return nothing. It cannot exceed Tokens; a larger value is lowered to it.",
			"minimum": 1024
		},
		"llm_gmi_cloud.custom.serverbase": {
			"type": "string",
			"title": "Server URL",
			"description": "Base URL of the OpenAI-compatible endpoint serving the model",
			"default": "https://api.gmi-serving.com/v1"
		}
	},
	//
	// Required:
	//		Defines the properties shown in the pipeline builder side panel, in order
	//
	"properties": [
		{
			"name": "model",
			"type": "string",
			"title": "Model",
			"description": "GMI Cloud LLM model",
			"default": "deepseek-ai/DeepSeek-V3-0324",
			"enum": {
				"meta-llama/Llama-4-Scout-17B-16E-Instruct": {
					"title": "Llama 4 Scout",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 1048576 },
						"llm_gmi_cloud.serverbase"
					]
				},
				"meta-llama/Llama-4-Maverick-17B-128E-Instruct-FP8": {
					"title": "Llama 4 Maverick",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 1048576 },
						"llm_gmi_cloud.serverbase"
					]
				},
				"Qwen/Qwen3-235B-A22B-FP8": {
					"title": "Qwen3 235B",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 131072 },
						"llm_gmi_cloud.serverbase"
					]
				},
				"Qwen/Qwen3-32B-FP8": {
					"title": "Qwen3 32B",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 131072 },
						"llm_gmi_cloud.serverbase"
					]
				},
				"Qwen/Qwen3-30B-A3B": {
					"title": "Qwen3 30B",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 131072 },
						"llm_gmi_cloud.serverbase"
					]
				},
				"Qwen/Qwen3-Coder-480B-A35B-Instruct-FP8": {
					"title": "Qwen3 Coder 480B",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 131072 },
						"llm_gmi_cloud.serverbase"
					]
				},
				"deepseek-ai/DeepSeek-V3.2": {
					"title": "DeepSeek V3.2",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 163840 },
						{ "name": "serverbase", "type": "constant", "default": "https://api.gmi-serving.com/v1" }
					]
				},
				"deepseek-ai/DeepSeek-V3-0324": {
					"title": "DeepSeek V3",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 163840 },
						{ "name": "serverbase", "type": "constant", "default": "https://api.gmi-serving.com/v1" }
					]
				},
				"deepseek-ai/DeepSeek-R1": {
					"title": "DeepSeek R1",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 131072 },
						{ "name": "serverbase", "type": "constant", "default": "https://api.gmi-serving.com/v1" }
					]
				},
				"deepseek-ai/DeepSeek-R1-Distill-Qwen-32B": {
					"title": "DeepSeek R1 Distill 32B",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 131072 },
						"llm_gmi_cloud.serverbase"
					]
				},
				"deepseek-ai/DeepSeek-R1-Distill-Qwen-1.5B": {
					"title": "DeepSeek R1 Distill 1.5B",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 131072 },
						"llm_gmi_cloud.serverbase"
					]
				},
				"deepseek-ai/DeepSeek-Prover-V2-671B": {
					"title": "DeepSeek Prover V2",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 131072 },
						{ "name": "serverbase", "type": "constant", "default": "https://api.gmi-serving.com/v1" }
					]
				},
				"openai/gpt-5.2": {
					"title": "GPT-5.2",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 },
						{ "name": "serverbase", "type": "constant", "default": "https://api.gmi-serving.com/v1" }
					]
				},
				"openai/gpt-5.1": {
					"title": "GPT-5.1",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 },
						{ "name": "serverbase", "type": "constant", "default": "https://api.gmi-serving.com/v1" }
					]
				},
				"openai/gpt-5": {
					"title": "GPT-5",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 },
						{ "name": "serverbase", "type": "constant", "default": "https://api.gmi-serving.com/v1" }
					]
				},
				"openai/gpt-4o": {
					"title": "GPT-4o",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 },
						{ "name": "serverbase", "type": "constant", "default": "https://api.gmi-serving.com/v1" }
					]
				},
				"anthropic/claude-opus-4.5": {
					"title": "Claude Opus 4.5",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 200000 },
						{ "name": "serverbase", "type": "constant", "default": "https://api.gmi-serving.com/v1" }
					]
				},
				"anthropic/claude-sonnet-4.5": {
					"title": "Claude Sonnet 4.5",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 200000 },
						{ "name": "serverbase", "type": "constant", "default": "https://api.gmi-serving.com/v1" }
					]
				},
				"google/gemini-3.1-pro-preview": {
					"title": "Gemini 3.1 Pro",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 },
						{ "name": "serverbase", "type": "constant", "default": "https://api.gmi-serving.com/v1" }
					]
				},
				"google/gemini-3-flash-preview": {
					"title": "Gemini 3 Flash",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 },
						{ "name": "serverbase", "type": "constant", "default": "https://api.gmi-serving.com/v1" }
					]
				},
				"google/gemini-3.1-flash-lite-preview": {
					"title": "Gemini 3.1 Flash Lite",
					"properties": [
