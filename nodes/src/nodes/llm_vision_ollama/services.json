{
	//
	// Required:
	//		The displayable name of this node
	//
	"title": "Ollama Vision",
	//
	// Required:
	//		The protocol is the endpoint protocol
	//
	"protocol": "image_vision_ollama://",
	//
	// Required:
	//		Class type of the node - what it does
	//
	"classType": ["image"],
	//
	// Required:
	//		Capabilities are flags that change the behavior of the underlying
	//		engine
	//
	"capabilities": ["invoke"],
	//
	// Optional:
	//		Register is either filter, endpoint or ignored if not specified. If the
	//		type is specified, a factory is registered of that given type
	//
	"register": "filter",
	//
	// Optional:
	//		The node is the actual physical node to instantiate - if
	//		not specified, the protocol will be used
	//
	"node": "python",
	//
	// Optional:
	//		The path is the executable/script code - it is node dependent
	//		and is optional for most node
	//
	"path": "nodes.llm_vision_ollama",
	//
	// Required:
	//		The prefix map when added/removed when converting URLs <=> paths
	//
	"prefix": "image_vision_ollama",
	//
	// Optional:
	//		Description of this driver
	//
	"description": [
		"A component that connects to locally-hosted open-source vision models through Ollama ",
		"for image analysis, description, and visual understanding tasks. Supports Llama 3.2 Vision, ",
		"LLaVA, Moondream, MiniCPM-V, and other multimodal models. Runs entirely on-premise with no ",
		"external API keys required, ideal for privacy-sensitive applications."
	],
	//
	// Optional:
	//		The icon is the icon to display in the UI for this node
	//
	"icon": "ollama.svg",
	"documentation": "https://docs.rocketride.org/nodes/llm_vision_ollama",
	//
	// Optional:
	//		Rendering hints to the UI which indicate which fields of
	//		the configuration should be used to display information
	//
	"tile": ["Model: ${parameters.llm_vision_ollama.model}"],
	//
	// Optional:
	//		As a pipe component, define what this pipe component takes
	//		and what it produces
	//
	"lanes": {
		"image": ["text"],
		"documents": ["documents"]
	},
	//
	// Optional:
	//		Local property definitions. The model is the selector (one branch per
	//		model, the branch value is the model id); each branch pins its context
	//		window and capabilities as constants, and the leaves every model shares
	//		(credentials, generation settings) sit at the root and are stored flat.
	//		The "custom" branch takes a model id the catalog does not list.
	//
	"propertyDefinitions": {
		"llm_vision_ollama.serverbase": { "base": "llm.local.serverbase", "default": "http://localhost:11434/v1" },
		"llm_vision_ollama.systemPrompt": {
			"type": "string",
			"format": "textarea",
			"title": "System prompt",
			"description": "Instructions that frame how the model describes images.",
			"default": ""
		},
		"llm_vision_ollama.prompt": {
			"type": "string",
			"format": "textarea",
			"title": "Prompt",
			"description": "The question asked about every image.",
			"default": "Describe this image in detail."
		},
		"llm_vision_ollama.customModel": {
			"type": "string",
			"title": "Model id",
			"description": "Model id exactly as the provider names it",
			"required": true
		},
		"llm_vision_ollama.custom.modelTotalTokens": { "type": "number", "title": "Tokens", "description": "Total Tokens", "minimum": 1, "default": 16385 },
		"llm_vision_ollama.custom.modelOutputTokens": {
			"type": "integer",
			"title": "Output Tokens",
			"description": "Most tokens the model may write in one reply (at least 1,024). Leave it empty to keep the node's default. Reasoning models count their thinking against this limit: set it well above the reply you expect, or they can spend it all thinking and return nothing. It cannot exceed Tokens; a larger value is lowered to it.",
			"minimum": 1024
		}
	},
	//
	// Required:
	//		Defines the properties shown in the pipeline builder side panel, in order
	//
	"properties": [
		{
			"name": "model",
			"type": "string",
			"title": "Model",
			"description": "Select the Ollama vision model to use",
			"default": "llama3.2-vision:11b",
			"enum": {
				"llama3.2-vision:11b": {
					"title": "Llama 3.2 Vision 11B",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 }
					]
				},
				"llama3.2-vision:90b": {
					"title": "Llama 3.2 Vision 90B",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 }
					]
				},
				"llava:7b": {
					"title": "LLaVA 7B",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 32768 }
					]
				},
				"llava:13b": {
					"title": "LLaVA 13B",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 4096 }
					]
				},
				"llava:34b": {
					"title": "LLaVA 34B",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 4096 }
					]
				},
				"moondream": {
					"title": "Moondream 2",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 2048 }
					]
				},
				"minicpm-v": {
					"title": "MiniCPM-V",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 8192 }
					]
				},
				"qwen2.5vl:3b": {
					"title": "Qwen 2.5 VL 3B",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 }
					]
				},
				"qwen2.5vl:7b": {
					"title": "Qwen 2.5 VL 7B",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 }
					]
				},
				"custom": {
					"title": "Custom model",
					"properties": [
						"llm_vision_ollama.customModel",
						"llm_vision_ollama.custom.modelTotalTokens",
						"llm_vision_ollama.custom.modelOutputTokens"
					]
				}
			}
		},
		"llm_vision_ollama.serverbase",
		"llm_vision_ollama.systemPrompt",
		"llm_vision_ollama.prompt"
	],
	//
	// Optional:
	//		Test configuration for automated node testing. "profiles" lists
	//		values of the "model" selector; the framework writes the selected one
	//		at "model" and the mock credentials at their paths.
	//
	"test": {
		"profiles": ["llama3.2-vision:11b"],
		"outputs": ["text"],
		"timeout": 30,
		"cases": [
			{
				"name": "Vision node returns mock response for image input",
				"image": "images/ocr_test_text.png",
				"expect": {
					"text": { "contains": "Mock LLM response" }
				}
			}
		]
	}
}
