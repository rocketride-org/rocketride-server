{
	"title": "Depth Estimation",
	"protocol": "depth_estimate://",
	"classType": ["image"],
	"capabilities": ["gpu", "experimental"],
	"register": "filter",
	"node": "python",
	"path": "nodes.depth_estimate",
	"prefix": "depth_estimate",
	"description": ["Monocular depth estimation using Depth Anything V2 Small (Apache-2.0). ", "Outputs a colorized depth map (red = near, blue = far); depth statistics (min, max, mean) are emitted as JSON on the text lane.", "Pair with the Object Detection node to get rough distance to detected objects. ", "Runs on CPU, Apple Silicon (MPS), and CUDA."],
	"icon": "depth-estimate.svg",
	"documentation": "https://docs.rocketride.org/nodes/depth_estimate",
	"tile": ["Model: ${parameters.depth_estimate.profile}"],
	"lanes": {
		"image": ["text", "image"]
	},
	"input": [
		{
			"lane": "image",
			"description": "AVI image stream to estimate depth from.",
			"output": [
				{
					"lane": "image",
					"description": "Colorized depth map as raw stream — red is near, blue is far."
				},
				{
					"lane": "text",
					"description": "JSON depth statistics: {min, max, mean}."
				}
			]
		}
	],
	//
	// Optional:
	//		Local property definitions. The model is the selector; the one
	//		profile pins its Hugging Face model and revision as constants.
	//		maxEdge is shared by every model, so it sits beside the selector.
	//
	"propertyDefinitions": {
		"depth_estimate.maxEdge": {
			"type": "integer",
			"title": "Max input edge (px)",
			"description": "Downscale input so the long edge <= this value before inference; dense output is upsampled back to original. Lower = faster + less VRAM, higher = sharper depth.",
			"default": 1024,
			"minimum": 256,
			"maximum": 4096
		}
	},
	//
	// Required:
	//		Defines the properties shown in the pipeline builder side panel, in order
	//
	"properties": [
		{
			"name": "profile",
			"type": "string",
			"title": "Model",
			"default": "v2-small",
			"enum": {
				"v2-small": {
					"title": "Depth Anything V2 Small",
					"properties": [
						{ "name": "model", "type": "constant", "default": "depth-anything/Depth-Anything-V2-Small-hf" },
						{ "name": "revision", "type": "constant", "default": "5426e4f0f36572d16453bbda7a8389317b1bef99" }
					]
				}
			}
		},
		"depth_estimate.maxEdge"
	],
	//
	//	Test configuration for automated node testing. "profiles" lists
	//	values of the "profile" selector.
	//
	"test": {
		"profiles": ["v2-small"],
		"requiresHardware": { "cuda": { "vramGb": 2 }, "mps": { "ramGb": 4 }, "cpu": { "ramGb": 4 } },
		"outputs": ["text"],
		"timeout": 120,
		"cases": [
			{
				"name": "Estimate depth and emit stats",
				"image": "images/einstein.jpg",
				"expect": {
					"text": { "notEmpty": true, "contains": "mean" }
				}
			}
		]
	},
	"fulltest": {
		"profiles": ["v2-small"],
		"requiresHardware": { "cuda": { "vramGb": 2 }, "mps": { "ramGb": 4 }, "cpu": { "ramGb": 4 } },
		"outputs": ["text"],
		"timeout": 120,
		"cases": [
			{
				"name": "Estimate depth and emit stats",
				"image": "images/einstein.jpg",
				"expect": {
					"text": { "notEmpty": true, "contains": "mean" }
				}
			}
		]
	}
}
