{
	//
	// Required:
	//		The displayable name of this node
	//
	"title": "Kimi (Moonshot)",
	//
	// Required:
	//		The protocol is the endpoint protocol
	//
	"protocol": "llm_kimi://",
	//
	// Required:
	//		Class type of the node - what it does
	//
	"classType": ["llm"],
	//
	// Required:
	//		Capabilities are flags that change the behavior of the underlying
	//		engine
	//
	"capabilities": ["invoke"],
	//
	// Optional:
	//		Register is either filter, endpoint or ignored if not specified. If the
	//		type is specified, a factory is registered of that given type
	//
	"register": "filter",
	//
	// Optional:
	//		The node is the actual physical node to instantiate - if
	//		not specified, the protocol will be used
	//
	"node": "python",
	//
	// Optional:
	//		The path is the executable/script code - it is node dependent
	//		and is optional for most node
	//
	"path": "nodes.llm_kimi",
	//
	// Required:
	//		The prefix map when added/removed when converting URLs <=> paths
	//
	"prefix": "llm",
	//
	// Optional:
	//		Description of this driver
	//
	"description": [
		"A component that connects to Moonshot AI's Kimi large language models for ",
		"advanced natural language processing. It enables text generation, long-context ",
		"reasoning, summarization, and tool use. The Kimi K2 family offers a 256K context ",
		"window with thinking and non-thinking modes and strong agentic performance, while ",
		"the classic Moonshot v1 models provide cost-effective options across 8K, 32K, and ",
		"128K context sizes. The component is suitable for integrating intelligent ",
		"reasoning and content generation into pipelines where long context and accuracy ",
		"are key."
	],
	//
	// Optional:
	//		The icon is the icon to display in the UI for this node
	//
	"icon": "kimi.svg",
	"documentation": "https://docs.rocketride.org/nodes/llm_kimi",
	//
	// Optional:
	//		Rendering hints to the UI which indicate which fields of
	//		the configuration should be used to display information
	//
	"tile": ["Model: ${parameters.llm_kimi.model}"],
	//
	// Optional:
	//		As a pipe component, define what this pipe component takes
	//		and what it produces
	//
	"lanes": {
		"questions": ["answers"]
	},
	//
	// Optional:
	//		Local property definitions. The model is the selector (one branch per
	//		model, the branch value is the model id); each branch pins its context
	//		window and capabilities as constants, and the leaves every model shares
	//		(credentials, generation settings) sit at the root and are stored flat.
	//		The "custom" branch takes a model id the catalog does not list.
	//
	"propertyDefinitions": {
		"llm_kimi.apikey": {
			"base": "llm.cloud.apikey",
			"description": "Moonshot AI API key (a self-hosted endpoint needs none)",
			"env": "ROCKETRIDE_LLM_KIMI_APIKEY",
			"required": false
		},
		"llm_kimi.serverbase": {
			"base": "llm.local.serverbase",
			"default": "https://api.moonshot.ai/v1",
			"title": "Server URL",
			"description": "Base URL of the OpenAI-compatible endpoint"
		},
		"llm_kimi.customModel": {
			"type": "string",
			"title": "Model id",
			"description": "Model id exactly as the provider names it",
			"required": true
		},
		"llm_kimi.custom.modelTotalTokens": {
			"type": "number",
			"title": "Tokens",
			"description": "Total context length of the model in tokens",
			"minimum": 1,
			"default": 262144
		},
		"llm_kimi.custom.modelOutputTokens": {
			"type": "integer",
			"title": "Output Tokens",
			"description": "Most tokens the model may write in one reply (at least 1,024). Leave it empty to keep the node's default. Reasoning models count their thinking against this limit: set it well above the reply you expect, or they can spend it all thinking and return nothing. It cannot exceed Tokens; a larger value is lowered to it.",
			"minimum": 1024,
			"default": 16384
		}
	},
	//
	// Required:
	//		Defines the properties shown in the pipeline builder side panel, in order
	//
	"properties": [
		{
			"name": "model",
			"type": "string",
			"title": "Model",
			"description": "Kimi (Moonshot) LLM model",
			"default": "kimi-k2.6",
			"enum": {
				"kimi-k2.6": {
					"title": "Kimi K2.6",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 262144 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 16384 },
						{ "name": "reasoning", "type": "constant", "default": true }
					]
				},
				"kimi-k2.5": {
					"title": "Kimi K2.5",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 262144 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 16384 },
						{ "name": "reasoning", "type": "constant", "default": true }
					]
				},
				"moonshot-v1-8k": {
					"title": "Moonshot v1 8K",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 8192 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 4096 }
					]
				},
				"moonshot-v1-32k": {
					"title": "Moonshot v1 32K",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 32768 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 4096 }
					]
				},
				"moonshot-v1-128k": {
					"title": "Moonshot v1 128K",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 131072 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 4096 }
					]
				},
				"kimi-k2": {
					"title": "MoonshotAI: Kimi K2 0711",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 131072 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 100352 }
					]
				},
				"kimi-k2-0905": {
					"title": "MoonshotAI: Kimi K2 0905",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 262144 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 100352 }
					]
				},
				"kimi-k2.7-code": {
					"title": "MoonshotAI: Kimi K2.7 Code",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 262144 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 235929 },
						{ "name": "reasoning", "type": "constant", "default": true }
					]
				},
				"kimi-k2-thinking": {
					"title": "MoonshotAI: Kimi K2 Thinking",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 262144 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 100352 },
						{ "name": "reasoning", "type": "constant", "default": true }
					]
				},
				"kimi-latest": {
					"title": "MoonshotAI Kimi Latest",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 1048576 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 943718 },
						{ "name": "reasoning", "type": "constant", "default": true }
					]
				},
				"kimi-k3": {
					"title": "MoonshotAI: Kimi K3",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 1048576 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 943718 },
						{ "name": "reasoning", "type": "constant", "default": true }
					]
				},
				"custom": {
					"title": "Custom model",
					"properties": ["llm_kimi.customModel", "llm_kimi.custom.modelTotalTokens", "llm_kimi.custom.modelOutputTokens"]
				}
			}
		},
		"llm_kimi.apikey",
		"llm_kimi.serverbase"
	],
	//
	// Optional:
	//		Test configuration for automated node testing. "profiles" lists
	//		values of the "model" selector; the framework writes the selected one
	//		at "model" and the mock credentials at their paths.
	//
	"test": {
		"profiles": ["kimi-k2.6"],
		"outputs": ["answers"],
		"cases": [
			{
				"name": "LLM returns mock response",
				"text": "What is 2+2?",
				"expect": {
					"answers": { "contains": "Mock LLM response" }
				}
			}
		]
	}
}
