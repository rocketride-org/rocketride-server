{
	"title": "Crustdata",
	"protocol": "tool_crustdata://",
	"classType": ["tool"],
	"capabilities": ["invoke", "experimental"],
	"register": "filter",
	"node": "python",
	"path": "nodes.tool_crustdata",
	"prefix": "crustdata",
	"icon": "crustdata.svg",
	"documentation": "https://docs.rocketride.org/nodes/tool_crustdata",
	"description": ["Exposes Crustdata's B2B company and people search as agent tools.", "Searches Crustdata's indexed company and people data by filter criteria (industry, headcount, funding, current company, title, and more) and returns structured records."],
	"tile": [],
	"lanes": {},
	//
	// Optional:
	//		Local property definitions. The API key is a required secret the account
	//		variable supplies.
	//
	"propertyDefinitions": {
		"tool_crustdata.apikey": {
			"type": "string",
			"title": "API Key",
			"description": "Crustdata API key (from https://crustdata.com)",
			"secret": true,
			"env": "ROCKETRIDE_CRUSTDATA_APIKEY",
			"required": true
		},
		"tool_crustdata.defaultLimit": {
			"type": "integer",
			"title": "Default Result Limit",
			"description": "Default maximum number of results per search (1-1000)",
			"default": 10,
			"minimum": 1,
			"maximum": 1000
		}
	},
	"properties": ["type", "tool_crustdata.apikey", "tool_crustdata.defaultLimit"],
	"test": {
		"profiles": ["default"],
		"outputs": [],
		"cases": [
			{
				"name": "Config validation with placeholder key",
				"text": "test query"
			}
		]
	}
}
