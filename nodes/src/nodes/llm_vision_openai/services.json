{
	//
	// Required:
	//		The displayable name of this node
	//
	"title": "OpenAI Vision",
	//
	// Required:
	//		The protocol is the endpoint protocol
	//
	"protocol": "image_vision_openai://",
	//
	// Required:
	//		Class type of the node - what it does
	//
	"classType": ["image"],
	//
	// Required:
	//		Capabilities are flags that change the behavior of the underlying
	//		engine
	//
	"capabilities": ["invoke"],
	//
	// Optional:
	//		Register is either filter, endpoint or ignored if not specified. If the
	//		type is specified, a factory is registered of that given type
	//
	"register": "filter",
	//
	// Optional:
	//		The node is the actual physical node to instantiate - if
	//		not specified, the protocol will be used
	//
	"node": "python",
	//
	// Optional:
	//		The path is the executable/script code - it is node dependent
	//		and is optional for most node
	//
	"path": "nodes.llm_vision_openai",
	//
	// Required:
	//		The prefix map when added/removed when converting URLs <=> paths
	//
	"prefix": "image_vision_openai",
	//
	// Optional:
	//		Description of this driver
	//
	"description": [
		"A component that connects to OpenAI's vision-capable models for image analysis, ",
		"OCR, visual understanding, and scene description. Supports GPT-4.1 and GPT-4o model families ",
		"with multimodal capabilities. Features robust error handling, automatic image processing, ",
		"and flexible prompt configuration for a wide range of vision use cases."
	],
	//
	// Optional:
	//		The icon is the icon to display in the UI for this node
	//
	"icon": "openai.svg",
	"documentation": "https://docs.rocketride.org/nodes/llm_vision_openai",
	//
	// Optional:
	//		Rendering hints to the UI which indicate which fields of
	//		the configuration should be used to display information
	//
	"tile": ["Model: ${parameters.llm_vision_openai.model}"],
	//
	// Optional:
	//		As a pipe component, define what this pipe component takes
	//		and what it produces
	//
	"lanes": {
		"image": ["text"],
		"documents": ["documents"]
	},
	//
	// Optional:
	//		Local property definitions. The model is the selector (one branch per
	//		model, the branch value is the model id); each branch pins its context
	//		window and capabilities as constants, and the leaves every model shares
	//		(credentials, generation settings) sit at the root and are stored flat.
	//		The "custom" branch takes a model id the catalog does not list.
	//
	"propertyDefinitions": {
		"llm_vision_openai.apikey": {
			"base": "llm.cloud.apikey",
			"description": "OpenAI API key",
			"env": "ROCKETRIDE_LLM_VISION_OPENAI_APIKEY",
			"required": true
		},
		"llm_vision_openai.systemPrompt": {
			"type": "string",
			"format": "textarea",
			"title": "System prompt",
			"description": "Instructions that frame how the model describes images.",
			"default": ""
		},
		"llm_vision_openai.prompt": {
			"type": "string",
			"format": "textarea",
			"title": "Prompt",
			"description": "The question asked about every image.",
			"default": "Describe this image in detail."
		}
	},
	//
	// Required:
	//		Defines the properties shown in the pipeline builder side panel, in order
	//
	"properties": [
		{
			"name": "model",
			"type": "string",
			"title": "Model",
			"description": "Select the OpenAI vision model to use",
			"default": "gpt-4.1",
			"enum": {
				"gpt-4.1": {
					"title": "GPT-4.1",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 1047576 }
					]
				},
				"gpt-4.1-mini": {
					"title": "GPT-4.1-mini",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 1047576 }
					]
				},
				"gpt-4.1-nano": {
					"title": "GPT-4.1-nano",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 1047576 }
					]
				},
				"gpt-4o": {
					"title": "GPT-4o",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 }
					]
				},
				"gpt-4o-mini": {
					"title": "GPT-4o-mini",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 128000 }
					]
				}
			}
		},
		"llm_vision_openai.apikey",
		"llm_vision_openai.systemPrompt",
		"llm_vision_openai.prompt"
	]
}
