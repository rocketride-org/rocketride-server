{
	//
	// Required:
	//		The displayable name of this node
	//
	"title": "Webhook",
	//
	// Required:
	//		The protocol is the endpoint protocol
	//
	"protocol": "webhook://",
	//
	// Required:
	//		Class type of the node - what it does
	//
	"classType": ["source", "webhook"],
	//
	// Required for a source:
	//		How work reaches this source: "request" (every unit of work
	//		arrives as a caller's request), "listener" (it listens on an
	//		outside channel for as long as it runs) or "scan" (it reads a
	//		store on its own). A source that declares none is a "scan".
	//
	"sourceKind": "request",
	//
	// Required:
	//		Capabilities are flags that change the behavior of the underlying
	//		engine
	//
	"capabilities": ["noinclude"],
	//
	// Optional:
	//		Register is either filter, endpoint or ignored if not specified. If the
	//		type is specified, a factory is registered of that given type
	//
	"register": "endpoint",
	//
	// Optional:
	//		The node is the actual physical node to instantiate - if
	//		not specified, the protocol will be used
	//
	"node": "python",
	//
	// Optional:
	//		The path is the executable/script code - it is node dependent
	// 		and is optional for most node
	//
	"path": "nodes.webhook",
	//
	// Required:
	//		The prefix map when added/removed when converting URLs <=> paths
	//
	"prefix": "WebHook",
	//
	// Optional:
	//		Description to of this driver
	//
	"description": [
		"A source component that listens for incoming HTTP requests and accepts ",
		"uploaded documents or data from external systems or processes. It enables ",
		"seamless integration for document ingestion, allowing external systems to ",
		"trigger the component and send files for further processing. Configurable ",
		"with endpoint and authentication settings, it ensures secure and reliable ",
		"document transfer for pipeline processing. Ideal for receiving documents, ",
		"images, or other files from external platforms via HTTP-based communication."
	],
	//
	// Optional:
	//	  The icon is the icon to display in the UI for this node
	//
	"icon": "webhook.svg",
	"documentation": "https://docs.rocketride.ai/nodes/webhook/webhook",
	//
	//	Optional:
	//		As a pipe component, define what this pipe component takes
	//		and what it produces
	//
	"lanes": {
		"_source": ["tags", "text", "json", "audio", "video", "image", "questions"]
	},
	//
	// Required:
	//		Defines the fields shown in the node's config panel, in order
	//
	"properties": [
		"hideForm",
		"type",
		"source.mode"
	],
	"legacy": {
		"selector": "profile",
		"default": "default",
		"profiles": {
			"default": {}
		},
		"dropped": []
	}
}
