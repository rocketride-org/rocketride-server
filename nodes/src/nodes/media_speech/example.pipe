{
  "project_id": "ebe32843-5724-4d88-9721-030b41982f75",
  "version": 1,
  "components": [
    {
      "id": "source",
      "provider": "webhook",
      "config": {
        "mode": "Source",
        "type": "webhook"
      }
    },
    {
      "id": "parse",
      "provider": "parse",
      "config": {},
      "input": [
        {
          "from": "source",
          "lane": "tags"
        }
      ]
    },
    {
      "id": "media",
      "provider": "media_speech",
      "config": {
        "profile": "default",
        "default": {
          "request": "{\"mode\": \"pieces\"}"
        }
      },
      "input": [
        {
          "from": "parse",
          "lane": "video"
        },
        {
          "from": "parse",
          "lane": "audio"
        }
      ]
    },
    {
      "id": "response",
      "provider": "response_answers",
      "config": {
        "laneName": "answers"
      },
      "input": [
        {
          "from": "media",
          "lane": "answers"
        }
      ]
    },
    {
      "id": "save_audio",
      "provider": "filestore",
      "config": {
        "profile": "default",
        "default": {
          "targetDir": "media-results/audio",
          "onConflict": "unique"
        }
      },
      "input": [
        {
          "from": "media",
          "lane": "audio"
        }
      ]
    }
  ],
  "viewport": {
    "x": 0,
    "y": 0,
    "zoom": 1
  }
}