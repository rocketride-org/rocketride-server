{
	//
	// Required:
	//		The displayable name of this node
	//
	"title": "RocketRide Graph",
	//
	// Required:
	//		The protocol is the endpoint protocol
	//
	"protocol": "rocketride_graph://",
	//
	// Required:
	//		Class type of the node - what it does
	//
	"classType": ["graph", "tool"],
	//
	// Required:
	//		Capabilities are flags that change the behavior of the underlying
	//		engine
	//
	"capabilities": ["noremote", "invoke"],
	//
	// Optional:
	//		Register is either filter, endpoint or ignored if not specified. If the
	//		type is specified, a factory is registered of that given type
	//
	"register": "filter",
	//
	// Optional:
	//		The node is the actual physical node to instantiate - if
	//		not specified, the protocol will be used
	//
	"node": "python",
	//
	// Optional:
	//		The path is the executable/script code - it is node dependent
	// 		and is optional for most node
	//
	"path": "nodes.rocketride_graph",
	//
	// Required:
	//		The prefix map when added/removed when converting URLs <=> paths
	//
	"prefix": "rocketridegraph",
	//
	// Optional:
	//		Description of this driver
	//
	"description": ["A RocketRide-managed graph database backed by PostgreSQL + Apache AGE. ", "Answers natural-language questions over your own provisioned RocketRide cloud ", "graph with zero setup — no host, user, or password to enter; the connection is ", "resolved automatically from your signed-in RocketRide identity. Cypher queries ", "are translated to AGE with a resource firewall, and safe reads run in read-only ", "transactions server-side."],
	//
	// Optional:
	//	  The icon is the icon to display in the UI for this node
	//
	"icon": "rocketride_graph.svg",
	"documentation": "https://docs.rocketride.org",
	//
	// Optional:
	//		Defines the invoke connections that may/must be connected
	// 		which are utilized by this driver
	//
	"invoke": {
		"llm": {
			"description": "LLM to use to craft Cypher queries from question",
			"min": 1
		}
	},
	//
	//	Optional:
	//		As a pipe component, define what this pipe component takes
	//		and what it produces
	//
	"lanes": {
		"questions": ["table", "text", "answers"]
	},
	//
	//	Optional:
	//		Profile section are configuration options used by the driver
	//		itself
	//
	"preconfig": {
		// Define the values that will be merged into any profile configuration
		// specified, unless the profile is 'absolute'
		"default": "default",
		// Defines profiles used with the "profile": key
		"profiles": {
			"default": {
				"graph": "rocketride"
			}
		}
	},
	//
	// Optional:
	//		Local fields definitions - these define fields only for the
	//		current service. You may specify them here, or directly
	//		in the shape
	//
	"fields": {
		"rocketridegraph.graph": {
			"type": "string",
			"title": "Graph name",
			"default": "rocketride",
			"description": "Name of the AGE graph to query in your RocketRide cloud database"
		},
		"rocketridegraph.db_description": {
			"type": "string",
			"title": "Graph description",
			"default": "",
			"description": "What is this graph used for? Describe its content and purpose, this helps the LLM generate more accurate queries.",
			"ui": {
				"ui:widget": "textarea"
			}
		},
		"rocketridegraph.max_attempts": {
			"type": "integer",
			"title": "Max validation attempts",
			"default": 5,
			"minimum": 1,
			"maximum": 20,
			"description": "Maximum number of times to re-ask the LLM if validation rejects the generated Cypher"
		},
		"rocketridegraph.max_rows": {
			"type": "integer",
			"title": "Max read rows",
			"default": 1000,
			"minimum": 1,
			"maximum": 25000,
			"description": "Row ceiling for read queries on the questions lane and get_data tool"
		},
		"rocketridegraph.query_timeout_ms": {
			"type": "integer",
			"title": "Query timeout (ms)",
			"default": 30000,
			"minimum": 100,
			"maximum": 600000,
			"description": "Per-query statement timeout applied inside each query's transaction"
		},
		"rocketridegraph.allow_execute": {
			"type": "boolean",
			"title": "Allow direct query execution",
			"default": false,
			"description": "Permit QuestionType.EXECUTE callers to run raw Cypher without LLM translation or read-only safety checks. Resource limits still apply. Leave OFF unless a trusted application explicitly needs to issue Cypher directly."
		},
		"rocketridegraph.default": {
			"object": "default",
			"properties": ["rocketridegraph.db_description", "rocketridegraph.graph", "rocketridegraph.max_attempts", "rocketridegraph.max_rows", "rocketridegraph.query_timeout_ms", "rocketridegraph.allow_execute"]
		},
		"rocketridegraph.profile": {
			"hidden": true,
			"type": "string",
			"default": "default",
			"enum": [["default", "Default"]],
			"conditional": [
				{
					"value": "default",
					"properties": ["rocketridegraph.default"]
				}
			]
		}
	},
	//
	// Required:
	//		Defines the fields (shape) of the service. Either source or target
	//		may be specified, or both, but at least one is required
	//
	"shape": [
		{
			"section": "Pipe",
			"title": "RocketRide Graph",
			"properties": ["rocketridegraph.profile"]
		}
	]
}
