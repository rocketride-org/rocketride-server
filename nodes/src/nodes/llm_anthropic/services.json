{
	//
	// Required:
	//		The displayable name of this node
	//
	"title": "Anthropic",
	//
	// Required:
	//		The protocol is the endpoint protocol
	//
	"protocol": "llm_anthropic://",
	//
	// Required:
	//		Class type of the node - what it does
	//
	"classType": ["llm"],
	//
	// Required:
	//		Capabilities are flags that change the behavior of the underlying
	//		engine
	//
	"capabilities": ["invoke"],
	//
	// Optional:
	//		Register is either filter, endpoint or ignored if not specified. If the
	//		type is specified, a factory is registered of that given type
	//
	"register": "filter",
	//
	// Optional:
	//		The node is the actual physical node to instantiate - if
	//		not specified, the protocol will be used
	//
	"node": "python",
	//
	// Optional:
	//		The path is the executable/script code - it is node dependent
	//		and is optional for most node
	//
	"path": "nodes.llm_anthropic",
	//
	// Required:
	//		The prefix map when added/removed when converting URLs <=> paths
	//
	"prefix": "llm",
	//
	// Optional:
	//		Description of this driver
	//
	"description": [
		"A component that integrates with Anthropic's Claude models for natural ",
		"language understanding and generation. It enables tasks such as ",
		"summarization, question answering, content generation, and conversational ",
		"AI. Configurable with model selection and prompt settings, the component ",
		"provides access to Claude's advanced language capabilities with a strong focus ",
		"on safety, alignment, and reliability. Ideal for enterprise-grade workflows requiring ",
		"trustworthy AI outputs."
	],
	//
	// Optional:
	//		The icon is the icon to display in the UI for this node
	//
	"icon": "anthropic.svg",
	"documentation": "https://docs.rocketride.org/nodes/llm_anthropic",
	//
	// Optional:
	//		Rendering hints to the UI which indicate which fields of
	//		the configuration should be used to display information
	//
	"tile": ["Model: ${parameters.llm_anthropic.model}"],
	//
	// Optional:
	//		As a pipe component, define what this pipe component takes
	//		and what it produces
	//
	"lanes": {
		"questions": ["answers"]
	},
	//
	// Optional:
	//		Local property definitions. The model is the selector (one branch per
	//		model, the branch value is the model id); each branch pins its context
	//		window and capabilities as constants, and the leaves every model shares
	//		(credentials, generation settings) sit at the root and are stored flat.
	//		The "custom" branch takes a model id the catalog does not list.
	//
	"propertyDefinitions": {
		"llm_anthropic.apikey": {
			"base": "llm.cloud.apikey",
			"description": "Anthropic API key",
			"env": "ROCKETRIDE_LLM_ANTHROPIC_APIKEY",
			"required": true
		},
		"llm_anthropic.extendedThinking": {
			"type": "boolean",
			"title": "Extended thinking",
			"description": "Enable Anthropic extended thinking (reasoning) for this node. Off by default. Applies to reasoning-capable models on the interactive chat path.",
			"default": false
		},
		"llm_anthropic.customModel": {
			"type": "string",
			"title": "Model id",
			"description": "Model id exactly as the provider names it",
			"required": true
		},
		"llm_anthropic.custom.modelTotalTokens": { "type": "number", "title": "Tokens", "description": "Total Tokens", "minimum": 1, "default": 200000 },
		"llm_anthropic.custom.modelOutputTokens": {
			"type": "integer",
			"title": "Output Tokens",
			"description": "Most tokens the model may write in one reply (at least 1,024). Leave it empty to keep the node's default. Reasoning models count their thinking against this limit: set it well above the reply you expect, or they can spend it all thinking and return nothing. It cannot exceed Tokens; a larger value is lowered to it.",
			"minimum": 1024,
			"default": 128000
		}
	},
	//
	// Required:
	//		Defines the properties shown in the pipeline builder side panel, in order
	//
	"properties": [
		{
			"name": "model",
			"type": "string",
			"title": "Model",
			"description": "LLM model",
			"default": "claude-sonnet-4-6",
			"enum": {
				"claude-sonnet-4-6": {
					"title": "Claude Sonnet 4.6",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 1000000 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 128000 },
						{ "name": "reasoning", "type": "constant", "default": true }
					]
				},
				"claude-opus-4-6": {
					"title": "Claude Opus 4.6",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 1000000 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 128000 },
						{ "name": "reasoning", "type": "constant", "default": true }
					]
				},
				"claude-haiku-4-5": {
					"title": "Claude Haiku 4.5",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 200000 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 64000 },
						{ "name": "reasoning", "type": "constant", "default": true }
					]
				},
				"claude-sonnet-4-5": {
					"title": "Claude Sonnet 4.5",
					"properties": [
						{ "name": "modelTotalTokens", "type": "constant", "default": 1000000 },
						{ "name": "modelOutputTokens", "type": "constant", "default": 64000 },
