{
	//
	// Required:
	//		The displayable name of this node
	//
	"title": "AWS S3",
	//
	// Required:
	//		The protocol is the endpoint protocol
	//
	"protocol": "aws://",
	//
	// Required:
	//		The physical type - "cpp" makes this a C++ node. The engine loads
	//		the shared library named by "path" and calls its initializeNode
	//		entry point, which registers the factories this protocol resolves
	//		to.
	//
	"node": "cpp",
	//
	// Required (for "node": "cpp"):
	//		Base name of the node's shared library, without the platform
	//		prefix or extension. Must match the target name passed to
	//		rocketride_add_node in CMakeLists.txt. Shared with the other
	//		service of this node, so the library is loaded once.
	//
	"path": "objstore",
	//
	// Required:
	//		Class type of the node - what it does
	//
	"classType": [
		"source"
	],
	//
	// Required:
	//		Capabilities are flags that change the behavior of the underlying
	//		engine
	//
	"capabilities": [
		"internal",
		"network"
	],
	//
	// Optional:
	//		Supported actions - if not specified, no actions are supported
	//		engine
	//
	"actions": [
		"export",
		"delete",
		"download"
	],
	//
	// Required:
	//		The prefix map when added/removed when convertting URLs <=> paths
	//
	"prefix": "Amazon Web Services",
	//
	// Optional:
	//		Description to of this driver
	//
	"description": [
		"A source component that reads data from Amazon S3 buckets. It enables ",
		"ingestion of files and documents stored in S3 for further processing within ",
		"the pipeline. Configurable with AWS credentials and bucket settings, the ",
		"component supports secure and scalable access to cloud-hosted data across ",
		"various formats."
	],
	//
	// Optional:
	//	  The icon is the icon to display in the UI for this node
	//
	"icon": "amazon-s3.svg",
	//
	// Optional:
	//	  Documentation link for this driver
	//
	"documentation": "https://bit.ly/48SC3ov",
	//
	//	Optional:
	//		As a pipe component, define what this pipe component takes
	//		and what it produces
	//
	"lanes": {
		"_source": [
			"tags"
		]
	},
	"input": [
		{
			"lane": "_source",
			"output": [
				{
					"lane": "tags",
					"description": "Outputs documents to be processed."
				}
			]
		}
	],
	//
	// Optional:
	//		Local property definitions. The account credentials live in the
	//		"parameters" group, which is where the C++ node reads them; the
	//		keys are secrets the account variables supply.
	//
	"propertyDefinitions": {
		"objstore.aws.accessKey": {
			"base": "aws.accessKey",
			"env": "ROCKETRIDE_AWS_ACCESS_KEY",
			"required": true
		},
		"objstore.aws.secretKey": {
			"base": "aws.secretKey",
			"env": "ROCKETRIDE_AWS_SECRET_KEY",
			"required": true
		}
	},
	//
	// Required:
	//		Defines the properties shown in the pipeline builder side panel, in order
	//
	"properties": [
		"type",
		"actions",
		"source.mode",
		{
			"name": "parameters",
			"properties": [
				"objstore.aws.accessKey",
				"objstore.aws.secretKey",
				"aws.region"
			]
		},
		{
			"name": "include",
			"type": "array",
			"description": "Example path: [bucket_name]/[folder_name]/* or [bucket_name]/*",
			"item": "Pipe.include.path"
		},
		{
			"name": "exclude",
			"type": "array",
			"description": "Example path: [bucket_name]/[folder_name]/* or [bucket_name]/*",
			"item": "Pipe.exclude.path"
		}
	]
}
