{
	"title": "Notion",
	"protocol": "tool_notion://",
	"classType": ["tool"],
	"capabilities": ["invoke", "experimental"],
	"register": "filter",
	"node": "python",
	"path": "nodes.tool_notion",
	"prefix": "notion",
	"icon": "notion.svg",
	"documentation": "https://docs.rocketride.org/nodes/tool_notion",
	"description": ["Exposes a Notion workspace (search, pages, databases) as agent tools.", "Search, read, and write Notion pages and databases using an internal integration secret: search by title, query database rows, read a page's body as plain text, and create/update/append pages."],
	"tile": [],
	"lanes": {},
	//
	// Optional:
	//		Local property definitions. The integration secret is a required secret the
	//		account variable supplies.
	//
	"propertyDefinitions": {
		"tool_notion.apikey": {
			"type": "string",
			"title": "API Key",
			"description": "Notion internal integration secret (from https://www.notion.so/my-integrations)",
			"secret": true,
			"env": "ROCKETRIDE_NOTION_APIKEY",
			"required": true
		}
	},
	"properties": ["type", "tool_notion.apikey"],
	"test": {
		"profiles": ["default"],
		"outputs": [],
		"cases": [
			{
				"name": "Config validation with placeholder key",
				"text": "test query"
			}
		]
	}
}
