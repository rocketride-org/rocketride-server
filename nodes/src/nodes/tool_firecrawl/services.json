{
	"title": "Firecrawl",
	"protocol": "tool_firecrawl://",
	"classType": ["tool"],
	"capabilities": ["invoke"],
	"register": "filter",
	"node": "python",
	"path": "nodes.tool_firecrawl",
	"prefix": "firecrawl",
	"icon": "firecrawl.svg",
	"documentation": "https://docs.rocketride.org/nodes/tool_firecrawl",
	"description": ["Exposes Firecrawl web search and scraping operations as agent tools.", "Provides search_web (web search), scrape_url (single page), and map_url (site structure discovery)."],
	"tile": [],
	"lanes": {},
	"preconfig": {
		"default": "default",
		"profiles": {
			"default": {
				"title": "Firecrawl",
				"apikey": "",
				"maxResults": 5
			}
		}
	},
	"fields": {
		"tool_firecrawl.apikey": {
			"type": "string",
			"title": "API Key",
			"description": "Firecrawl API key",
			"default": "",
			"secure": true,
			"ui": {
				"ui:widget": "ApiKeyWidget"
			}
		},
		"tool_firecrawl.maxResults": {
			"type": "integer",
			"title": "Max Results",
			"description": "Maximum number of search results to return (1-20)",
			"default": 5,
			"minimum": 1,
			"maximum": 20
		}
	},
	"shape": [
		{
			"section": "Pipe",
			"title": "Firecrawl",
			"properties": ["type", "tool_firecrawl.apikey", "tool_firecrawl.maxResults"]
		}
	]
}
