{
	"title": "Firecrawl",
	"protocol": "tool_firecrawl://",
	"classType": ["tool"],
	"capabilities": ["invoke"],
	"register": "filter",
	"node": "python",
	"path": "nodes.tool_firecrawl",
	"prefix": "firecrawl",
	"icon": "firecrawl.svg",
	"documentation": "https://docs.rocketride.org/nodes/tool_firecrawl",
	"description": ["Exposes Firecrawl web-scraping operations as agent tools.", "Provides scrape_url (single page) and map_url (site structure discovery)."],
	"tile": [],
	"lanes": {},
	//
	// Optional:
	//		Local property definitions. The API key is a required secret the account
	//		variable supplies.
	//
	"propertyDefinitions": {
		"tool_firecrawl.apikey": {
			"type": "string",
			"title": "API Key",
			"description": "Firecrawl API key",
			"secret": true,
			"env": "ROCKETRIDE_FIRECRAWL_APIKEY",
			"required": true
		}
	},
	"properties": ["type", "tool_firecrawl.apikey"]
}
