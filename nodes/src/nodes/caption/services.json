{
	"title": "Caption",
	"protocol": "caption://",
	"classType": ["image"],
	"capabilities": ["gpu", "experimental", "debug"],
	"register": "filter",
	"node": "python",
	"path": "nodes.caption",
	"prefix": "caption",
	"description": ["Generates a natural-language caption for an image using Florence-2 Base (MIT). ", "Three caption granularities are exposed: short, detailed, and more detailed. ", "Runs locally on CPU, Apple Silicon (MPS), and CUDA with no API key required. ", "For object detection use Object Detection. For text reading use OCR."],
	"icon": "caption.svg",
	"documentation": "https://docs.rocketride.org/nodes/caption",
	"tile": ["Task: ${parameters.caption.task}"],
	"lanes": {
		"image": ["text"]
	},
	"input": [
		{
			"lane": "image",
			"description": "AVI image stream to caption.",
			"output": [
				{
					"lane": "text",
					"description": "Caption string."
				}
			]
		}
	],
	//
	// Optional:
	//		Local property definitions. The model profile is the selector; the
	//		one shipped profile pins its model and revision as constants. The
	//		caption granularity is shared and stored flat.
	//
	"propertyDefinitions": {
		"caption.task": {
			"type": "string",
			"title": "Granularity",
			"description": "How detailed the caption should be.",
			"default": "caption",
			"enum": [
				["caption", "Short"],
				["detailed_caption", "Detailed"],
				["more_detailed_caption", "More detailed"]
			]
		}
	},
	//
	// Required:
	//		Defines the properties shown in the pipeline builder side panel, in order
	//
	"properties": [
		{
			"name": "profile",
			"type": "string",
			"title": "Model",
			"default": "florence-base",
			"enum": {
				"florence-base": {
					"title": "Florence-2 Base",
					"properties": [
						{ "name": "model", "type": "constant", "default": "microsoft/Florence-2-base" },
						{ "name": "revision", "type": "constant", "default": "5ca5edf5bd017b9919c05d08aebef5e4c7ac3bac" }
					]
				}
			}
		},
		"caption.task"
	],
	//
	//	Test configuration for automated node testing. "profiles" lists
	//	values of the "profile" selector.
	//
	"test": {
		"profiles": ["florence-base"],
		"requiresHardware": { "cuda": { "vramGb": 3 }, "mps": { "ramGb": 6 }, "cpu": { "ramGb": 6 } },
		"outputs": ["text"],
		"timeout": 120,
		"cases": [
			{
				"name": "Caption image",
				"image": "images/einstein.jpg",
				"expect": {
					"text": { "notEmpty": true }
				}
			}
		]
	},
	"fulltest": {
		"profiles": ["florence-base"],
		"requiresHardware": { "cuda": { "vramGb": 3 }, "mps": { "ramGb": 6 }, "cpu": { "ramGb": 6 } },
		"outputs": ["text"],
		"timeout": 120,
		"cases": [
			{
				"name": "Caption image",
				"image": "images/einstein.jpg",
				"expect": {
					"text": { "notEmpty": true }
				}
			}
		]
	}
}
