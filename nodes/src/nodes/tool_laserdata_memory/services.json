{
	//
	// Required:
	//		The displayable name of this node
	//
	"title": "LaserData Memory",
	//
	// Required:
	//		The protocol is the endpoint protocol
	//
	"protocol": "tool_laserdata_memory://",
	//
	// Required:
	//		Class type of the node - what it does
	//
	"classType": ["tool"],
	//
	// Required:
	//		Capabilities are flags that change the behavior of the underlying engine
	//
	"capabilities": ["invoke"],
	//
	// Optional:
	//		Register is either filter, endpoint or ignored if not specified
	//
	"register": "filter",
	//
	// Optional:
	//		The node is the actual physical node to instantiate
	//
	"node": "python",
	//
	// Optional:
	//		The path is the executable/script code
	//
	"path": "nodes.tool_laserdata_memory",
	//
	// Required:
	//		The prefix map when converting URLs <=> paths (tools surface as <prefix>.<tool>)
	//
	"prefix": "laserdata",
	//
	// Optional:
	//		The icon to display in the UI for this node
	//
	"icon": "laserdata.svg",
	"documentation": "https://docs.laserdata.com",
	//
	// Optional:
	//		Description of this node shown in the pipeline builder
	//
	"description": ["Durable, shared agent memory exposed as tools, backed by LaserData (Apache Iggy) via the Laser SDK.", "Exposes four agent tools: 'remember' stores a statement, 'recall' returns the most relevant items, 'improve' reinforces a memory with feedback, and 'forget' deletes one. Set the connection string and a namespace and it works; point several agents at the same namespace to share one durable memory."],
	//
	// Optional:
	//		Rendering hints for the UI: which config fields to surface on the node tile
	//
	"tile": ["Namespace: ${parameters.laserdata.namespace}"],
	//
	// Optional:
	//		As a pipe component, define what this component takes and produces.
	//		This is a control-plane tool node (no data lanes).
	//
	"lanes": {},
	//
	// Optional:
	//		Profile section - configuration options used by the driver itself.
	//		The default profile is applied when the node is first added to a pipeline.
	//
	"preconfig": {
		"default": "default",
		"profiles": {
			"default": {
				"title": "LaserData Memory",
				"connection_string": "",
				"token": "",
				"namespace": "",
				"show_advanced": false,
				"allow_namespace_override": true,
				"folded": true,
				"recall_limit": 10,
				"op_timeout": 30
			}
		}
	},
	//
	// Optional:
	//		Local field definitions. These define the config fields exposed in the UI.
	//		Only connection_string is required; the rest are optional and revealed by
	//		the "Advanced settings" toggle. "secure: true" fields are encrypted at
	//		rest and masked in the UI.
	//
	"fields": {
		"laserdata.connection_string": {
			"type": "string",
			"title": "Connection string",
			"description": "LaserData / Apache Iggy connection string in the form <code>user:password@host:port</code>, e.g. <code>iggy:laser@localhost:8090</code>. Falls back to the LASER_CONNECTION_STRING environment variable when blank.",
			"default": "",
			"secure": true,
			"ui": {
				"ui:widget": "ApiKeyWidget"
			}
		},
		"laserdata.token": {
			"type": "string",
			"optional": true,
			"title": "Token",
			"description": "Optional LaserData Cloud token. Falls back to the LASER_TOKEN environment variable when blank; not needed for a plain self-hosted Apache Iggy server.",
			"default": "",
			"secure": true,
			"ui": {
				"ui:widget": "ApiKeyWidget"
			}
		},
		"laserdata.namespace": {
			"type": "string",
			"optional": true,
			"title": "Namespace",
			"description": "Memory scope every call reads and writes, e.g. <code>customer:42</code>. Can be passed by the agent per call; a namespace is required on the call or here.",
			"default": ""
		},
		// Toggle: when on, reveals the advanced fields listed in `conditional`.
		"laserdata.show_advanced": {
			"type": "boolean",
			"optional": true,
			"title": "Advanced settings",
			"description": "Show advanced options. The defaults work for most cases, leave off for a simple setup.",
			"default": false,
			"enum": [
				[true, "Yes"],
				[false, "No"]
			],
			"conditional": [
				{
					"value": true,
					"properties": ["laserdata.allow_namespace_override", "laserdata.folded", "laserdata.recall_limit", "laserdata.op_timeout"]
				}
			]
		},
		// --- Advanced fields (hidden unless "Advanced settings" is on) ---
		"laserdata.allow_namespace_override": {
			"type": "boolean",
			"optional": true,
			"title": "Allow namespace override",
			"description": "When on (default), the agent may pass a different namespace per call. Turn off to lock every call to the configured namespace.",
			"default": true,
			"enum": [
				[true, "Yes"],
				[false, "No"]
			]
		},
		"laserdata.folded": {
			"type": "boolean",
			"optional": true,
			"title": "Folded recall",
			"description": "When on (default), 'recall' folds the durable memory topic in-process, which works against a plain Apache Iggy server. Turn off to read the managed KV view on a LaserData Cloud deployment.",
			"default": true,
			"enum": [
				[true, "Yes"],
				[false, "No"]
			]
		},
		"laserdata.recall_limit": {
			"type": "integer",
			"optional": true,
			"title": "Recall limit",
			"description": "Maximum number of memory items to retrieve per recall.",
			"default": 10,
			"minimum": 1,
			"maximum": 200
		},
		"laserdata.op_timeout": {
			"type": "integer",
			"optional": true,
			"title": "Operation timeout (s)",
			"description": "Max seconds any single memory operation (including the first connect) may take before it fails.",
			"default": 30,
			"minimum": 5,
			"maximum": 600
		}
	},
	//
	// Optional:
	//		Test configuration for automated node testing. beginGlobal requires a
	//		connection string, so the case only runs when LASER_CONNECTION_STRING
	//		points at a live LaserData / Apache Iggy deployment; otherwise the
	//		framework skips it (same credential class as tool_mem0 / tool_xtrace_memory).
	//
	"test": {
		"requires": ["LASER_CONNECTION_STRING"],
		"profiles": ["default"],
		"outputs": [],
		"cases": [
			{
				"name": "Config validation with placeholder credentials",
				"text": "test"
			}
		]
	},
	//
	// Required:
	//		Defines the fields (shape) shown in the pipeline builder side panel.
	//
	"shape": [
		{
			"section": "Pipe",
			"title": "LaserData Memory",
			"properties": ["type", "laserdata.connection_string", "laserdata.token", "laserdata.namespace", "laserdata.show_advanced"]
		}
	]
}
