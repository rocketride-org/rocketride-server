{
	//
	// Required:
	//		The displayable name of this node
	//
	"title": "RocketRide Vector",
	//
	// Required:
	//     The protocol is the endpoint protocol
	//
	"protocol": "rocketride_vector://",
	//
	// Required:
	//		Class type of the node - what it does
	//
	"classType": ["store", "tool"],
	//
	// Required:
	//     Capabilities are flags that change the behavior of the underlying
	//     engine
	//
	"capabilities": ["invoke"],
	//
	// Optional:
	//		Register is either filter, endpoint or ignored if not specified. If the
	//		type is specified, a factory is registered of that given type
	//
	"register": "filter",
	//
	// Optional:
	//     The node is the actual physical node to instantiate - if
	//     not specified, the protocol will be used
	//
	"node": "python",
	//
	// Optional:
	//     The path is the executable/script code - it is node dependent
	//     and is optional for most node
	//
	"path": "nodes.rocketride_vector",
	//
	// Required:
	//     The prefix map when added/removed when converting URLs <=> paths
	//
	"prefix": "RocketRide Vector Store",
	//
	// Optional:
	//		Description to of this driver
	//
	"description": ["A RocketRide-managed vector store backed by PostgreSQL + pgvector. Stores ", "and semantically searches high-dimensional embeddings in your own provisioned ", "RocketRide cloud database with zero setup — no host, user, or password to enter; ", "the connection is resolved automatically from your signed-in RocketRide identity. ", "An HNSW index is created on first write so semantic search is fast from the start. ", "When Expose as tools is on, agents and apps can also use the store as tools: search, objdir, get and stats, ", "plus upsert and delete when writes through tools are allowed."],
	//
	// Optional:
	//	  The icon is the icon to display in the UI for this node
	//
	"icon": "rocketride_vector.svg",
	"documentation": "https://docs.rocketride.org/nodes/rocketride_vector",
	//
	//  Optional:
	//      Rendering hints to the UI which indicate which fields of
	//      the configuration should be used to display information
	//
	"tile": ["Table: ${parameters.rocketride_vector.collection}", "Similarity: ${parameters.rocketride_vector.similarity}"],
	//
	//	Optional:
	//		As a pipe component, define what this pipe component takes
	//		and what it produces
	//
	"lanes": {
		"documents": [],
		"questions": ["documents", "answers", "questions"]
	},
	//
	// Optional:
	//     Local property definitions. The RocketRide cloud database has one
	//     connection, delivered by the task engine, so every property is
	//     stored flat: no host, user or password.
	//
	"propertyDefinitions": {
		"rrvector.collection": {
			"title": "Table",
			"description": "Name of the table to store vectors in your RocketRide cloud database.",
			"type": "string",
			"default": "rocketride"
		},
		"rrvector.score": {
			"title": "Score threshold",
			"description": "Minimum similarity score for a document to be returned by search.",
			"type": "number",
			"default": 0.5,
			"minimum": 0,
			"maximum": 1
		},
		"rrvector.similarity": {
			"title": "Similarity Metric",
			"description": "The similarity metric to use for vector search. Also selects the HNSW index operator class.",
			"type": "string",
			"default": "cosine",
			"enum": [
				["cosine", "Cosine"],
				["l2", "L2 (Euclidean)"],
				["inner_product", "Inner product"]
			]
		},
		"rrvector.hnsw_m": {
			"title": "HNSW m",
			"description": "HNSW graph degree (max connections per layer) used when the index is first created.",
			"type": "integer",
			"default": 16,
			"minimum": 2,
			"maximum": 100
		},
		"rrvector.hnsw_ef_construction": {
			"title": "HNSW ef_construction",
			"description": "HNSW build-time candidate list size used when the index is first created. Raised to twice HNSW m when set lower, as pgvector requires.",
			"type": "integer",
			"default": 64,
			"minimum": 4,
			"maximum": 1000
		},
		"rrvector.scope": {
			"type": "string",
			"title": "Database",
			"default": "org",
			"enum": [["org", "Organization"], ["team", "Team"], ["user", "Personal"]],
			"description": "Organization (default): shared by everyone in the organization. Team: the run's team (your current dev team, or the team a deploy is billed to). Personal: your own, for runs you start yourself. Each is a separate database: switching doesn't move data, and a new one starts empty."
		},
		"rrvector.target": {
			"hidden": true,
			"type": "string",
			"title": "Team or user",
			"default": "",
			"description": "Another team's or user's database (admins only). Leave empty to use your own team's or your own"
		},
		"rrvector.serverName": {
			"type": "string",
			"title": "Tool Server Name",
			"description": "Label for this store in tool-response messages (for example, a refused write names rrvector.delete). Pipeline agents address the available functions as node-id.function; apps use the function name and node ID. Changing this label does not change those addresses. See the node README for the available functions and their tool-exposure and write-permission settings.",
			"default": "rrvector",
			"minLength": 1
		},
		"rrvector.expose_tools": {
			"type": "boolean",
			"title": "Expose as tools",
			"default": false,
			"description": "Offer this table to agents and apps as tool functions: search, objdir, list_documents, get and stats, plus upsert, delete, soft_delete and restore when writes through tools are allowed. Leave OFF unless a trusted application or agent in this pipeline is meant to read the table through tools; objdir and get together return the whole table, not only the matches the questions lane returns. The documents and questions lanes are unaffected."
		},
		"rrvector.allow_write": {
			"type": "boolean",
			"title": "Allow writes through tools",
			"default": false,
			"description": "Permit the upsert, delete, soft_delete and restore tool functions to change this table in your RocketRide cloud database. Applies only while Expose as tools is on. Leave OFF unless a trusted application or agent needs to manage documents through tools; the documents lane and the read tools (search, objdir, list_documents, get, stats) are unaffected."
		}
	},
	//
	// Required:
	//     Defines the properties shown in the node's config panel, in order
	//
	"properties": [
		"rrvector.collection",
		"rrvector.score",
		"rrvector.similarity",
		"rrvector.hnsw_m",
		"rrvector.hnsw_ef_construction",
		"rrvector.scope",
		"rrvector.target",
		"rrvector.serverName",
		"rrvector.expose_tools",
		"rrvector.allow_write"
	]
}
