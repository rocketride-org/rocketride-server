{
	"components": [
		{
			"id": "chat_1",
			"provider": "chat",
			"name": "Clues in",
			"config": {
				"hideForm": true,
				"mode": "Source",
				"parameters": {},
				"type": "chat"
			},
			"ui": {
				"position": {
					"x": 20,
					"y": 1500
				},
				"nodeType": "default"
			}
		},
		{
			"id": "agent_01",
			"provider": "agent_rocketride",
			"name": "Room 1",
			"config": {
				"instructions": [
					"You are room 1. Your beat is beat 1 and no other.",
					"The message contains the clues for EVERY room. Use ONLY the entries whose \"beat\" is 1. Ignore every other room's clues - they are not yours to solve.",
					"STEP 1: db_private_01.load_data table=\"clues\" mode=\"append\" rows=<your beat's clues>. This database is yours alone; no other room can read it.",
					"STEP 2: db_private_01.execute a SQL query counting how many times each note appears in your clues. The winning note is the most frequent one. Exactly one clue is a decoy and it loses.",
					"STEP 3: do NOT write to the shared database. Publishing happens automatically when you answer.",
					"FINAL ANSWER: reply with ONLY this JSON object, no prose and no code fences: {\"room\": \"room-1\", \"beat\": 1, \"note\": \"<the winning note>\", \"confidence\": 0.9}"
				],
				"max_waves": 8,
				"parameters": {}
			},
			"input": [
				{
					"lane": "questions",
					"from": "chat_1"
				}
			],
			"ui": {
				"position": {
					"x": 320,
					"y": 0
				},
				"nodeType": "default"
			}
		},
		{
			"id": "db_private_01",
