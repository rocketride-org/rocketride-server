{
	"components": [
		{
			"id": "webhook_1",
			"provider": "chat",
			"name": "Clues in",
			"config": {
				"hideForm": true,
				"mode": "Source",
				"parameters": {},
				"type": "chat"
			},
			"ui": {
				"position": {
					"x": 20,
					"y": 220
				},
				"nodeType": "default",
				"formDataValid": true
			}
		},
		{
			"id": "agent_inv",
			"provider": "agent_rocketride",
			"name": "Investigator",
			"config": {
				"instructions": [
					"You are an investigator with your own PRIVATE Hotdata database (tools prefixed db_room_1). Your message is a JSON object with clues.",
					"1. load_data your clues into table 'clues' with mode append.",
					"2. Call get_schema once and note the database_id.",
					"3. Solve: the note for your beat is the most frequent 'note' value among your clues. Use execute with SQL to count.",
					"FINAL ANSWER: reply with ONLY this JSON, no prose, no fences: {\"database_id\": <the id from get_schema>, \"discovery\": {\"agent\": <your agent name from the message>, \"beat\": <beat from the message>, \"note\": <the winning note>, \"confidence\": 0.9}}"
				],
				"max_waves": 8,
				"parameters": {}
			},
			"input": [
				{
					"lane": "questions",
					"from": "webhook_1"
				}
			],
			"ui": {
				"position": {
					"x": 280,
					"y": 220
				},
				"nodeType": "default",
				"formDataValid": true
			}
		},
		{
			"id": "db_room_1",
			"provider": "db_hotdata",
			"name": "Private room DB",
			"config": {
				"profile": "default",
				"default": {
					"apikey": "${ROCKETRIDE_DB_HOTDATA_KEY}",
					"workspace_id": "${ROCKETRIDE_DB_HOTDATA_WORKSPACE_ID}",
					"api_url": "",
					"ttl": "1h",
					"table": "clues",
					"db_description": "One investigator's private room. clues(beat, note, source).",
					"max_attempts": 3,
					"max_execute_rows": 25000,
					"allow_execute": true,
					"allow_destructive_load": false,
					"job_timeout_secs": 180,
					"async_after_ms": 5000
				},
				"parameters": {}
			},
			"control": [
				{
					"classType": "tool",
					"from": "agent_inv"
				}
			],
			"ui": {
				"position": {
					"x": 540,
					"y": 380
				},
				"nodeType": "default",
				"formDataValid": true
			}
		},
		{
			"id": "memory_inv",
			"provider": "memory_internal",
			"config": {
				"type": "memory_internal"
			},
			"control": [
				{
					"classType": "memory",
					"from": "agent_inv"
				}
			],
			"ui": {
				"position": {
					"x": 280,
					"y": 60
				},
				"nodeType": "default",
				"formDataValid": true
			}
		},
		{
			"id": "response_answers_1",
			"provider": "response_answers",
			"name": "Discovery",
			"config": {
				"laneName": "answers"
			},
			"input": [
				{
					"lane": "answers",
					"from": "agent_inv"
				}
			],
			"ui": {
				"position": {
					"x": 540,
					"y": 100
				},
				"nodeType": "default",
				"formDataValid": true
			}
		},
		{
			"id": "llm_gemini_1",
			"provider": "llm_gemini",
			"name": "Gemini",
			"config": {
				"profile": "gemini-3_1-flash-lite-preview",
				"gemini-3_1-flash-lite-preview": {
					"apikey": "${ROCKETRIDE_GEMINI_KEY}"
				},
				"1-flash-lite-preview": {
					"apikey": "${ROCKETRIDE_GEMINI_KEY}"
				},
				"parameters": {
					"google": {}
				}
			},
			"control": [
				{
					"classType": "llm",
					"from": "agent_inv"
				},
				{
					"classType": "llm",
					"from": "db_room_1"
				}
			],
			"ui": {
				"position": {
					"x": 40,
					"y": 480
				},
				"nodeType": "default",
				"formDataValid": true
			}
		}
	],
	"project_id": "a4c55f50-c7ad-4a90-a48c-59b9b6b2b433",
	"viewport": {
		"x": 0,
		"y": 0,
		"zoom": 1
	},
	"version": 1
}
