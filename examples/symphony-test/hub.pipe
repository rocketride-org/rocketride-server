{
	"components": [
		{
			"id": "chat_1",
			"provider": "chat",
			"name": "Hub control",
			"config": {
				"hideForm": true,
				"mode": "Source",
				"parameters": {},
				"type": "chat"
			},
			"ui": {
				"position": {
					"x": 20,
					"y": 260
				},
				"nodeType": "default",
				"formDataValid": true
			}
		},
		{
			"id": "agent_a",
			"provider": "agent_rocketride",
			"name": "Critic A",
			"config": {
				"instructions": [
					"You are Critic A in a multi-agent hub. Messages are addressed by name: only act on messages that begin with 'CriticA:'. For any other message reply with exactly the word SKIP and do nothing else.",
					"You have TWO database tools. Tools prefixed db_shared_1 operate on the SHARED evidence database that other agents also use. Tools prefixed db_priv_a_1 operate on your PRIVATE scratch database that only you can reach.",
					"Follow the instruction in the message literally. When asked to report database ids, call the relevant get_schema tools and reply with ONLY the JSON requested, no prose, no fences.",
					"When asked to load rows, use load_data with mode append and reply with ONLY the JSON result summary."
				],
				"max_waves": 8,
				"parameters": {}
			},
			"input": [
				{
					"lane": "questions",
					"from": "chat_1"
				}
			],
			"ui": {
				"position": {
					"x": 280,
					"y": 140
				},
				"nodeType": "default",
				"formDataValid": true
			}
		},
		{
			"id": "agent_b",
			"provider": "agent_rocketride",
			"name": "Conductor B",
			"config": {
				"instructions": [
					"You are Conductor B in a multi-agent hub. Messages are addressed by name: only act on messages that begin with 'ConductorB:'. For any other message reply with exactly the word SKIP and do nothing else.",
					"You have TWO database tools. Tools prefixed db_shared_1 operate on the SHARED evidence database that other agents also use. Tools prefixed db_priv_b_1 operate on your PRIVATE scratch database that only you can reach.",
					"Follow the instruction in the message literally. When asked to report database ids, call the relevant get_schema tools and reply with ONLY the JSON requested, no prose, no fences.",
					"When asked to read data, prefer db_shared_1.execute with plain SQL and reply with ONLY the JSON requested."
				],
				"max_waves": 8,
				"parameters": {}
			},
			"input": [
				{
					"lane": "questions",
					"from": "chat_1"
				}
			],
			"ui": {
				"position": {
					"x": 280,
					"y": 400
				},
				"nodeType": "default",
				"formDataValid": true
			}
		},
		{
			"id": "db_shared_1",
			"provider": "db_hotdata",
			"name": "Shared evidence DB",
			"config": {
				"profile": "default",
				"default": {
					"apikey": "${ROCKETRIDE_DB_HOTDATA_KEY}",
					"workspace_id": "${ROCKETRIDE_DB_HOTDATA_WORKSPACE_ID}",
					"api_url": "",
					"ttl": "1h",
					"table": "discoveries",
					"db_description": "Shared evidence database for the symphony hub. discoveries(agent, beat, note, confidence).",
					"max_attempts": 3,
					"max_execute_rows": 25000,
					"allow_execute": true,
					"allow_destructive_load": false,
					"job_timeout_secs": 180,
					"async_after_ms": 5000
				},
				"parameters": {}
			},
			"control": [
				{
					"classType": "tool",
					"from": "agent_a"
				},
				{
					"classType": "tool",
					"from": "agent_b"
				}
			],
			"ui": {
