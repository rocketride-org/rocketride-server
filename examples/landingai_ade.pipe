{
	"name": "LandingAI ADE — document to text + tables",
	"description": "Drop a PDF or image; LandingAI ADE parses it into Markdown text and tables.",
	"components": [
		{
			"id": "dropper_1",
			"provider": "dropper",
			"config": { "hideForm": true, "mode": "Source", "parameters": {}, "type": "dropper" },
			"ui": { "position": { "x": 40, "y": 200 }, "measured": { "width": 150, "height": 66 }, "nodeType": "default", "formDataValid": true }
		},
		{
			"id": "landingai_ade_1",
			"provider": "landingai_ade",
			"config": { "model": "dpt-2-latest", "region": "production" },
			"input": [{ "lane": "tags", "from": "dropper_1" }],
			"ui": { "position": { "x": 280, "y": 200 }, "measured": { "width": 150, "height": 66 }, "nodeType": "default", "formDataValid": true }
		},
		{
			"id": "response_text_1",
			"provider": "response_text",
			"config": { "laneName": "text" },
			"input": [{ "lane": "text", "from": "landingai_ade_1" }],
			"ui": { "position": { "x": 520, "y": 120 }, "measured": { "width": 150, "height": 66 }, "nodeType": "default", "formDataValid": true }
		},
		{
			"id": "response_table_1",
			"provider": "response_table",
			"config": { "laneName": "table" },
			"input": [{ "lane": "table", "from": "landingai_ade_1" }],
			"ui": { "position": { "x": 520, "y": 280 }, "measured": { "width": 150, "height": 66 }, "nodeType": "default", "formDataValid": true }
		}
	],
	"project_id": "1a2b3c4d-5e6f-4a7b-8c9d-0e1f2a3b4c5d",
	"viewport": { "x": 0, "y": 0, "zoom": 1 },
	"version": 1
}
