		{
			"id": "prompt_1",
			"provider": "prompt",
			"config": {
				"instructions": ["Use the provided context to answer the question accurately. If the context does not contain relevant information, say so."],
				"parameters": {}
			},
			"input": [
				{ "lane": "documents", "from": "rerank_cohere_1" },
				{ "lane": "questions", "from": "embedding_transformer_2" }
