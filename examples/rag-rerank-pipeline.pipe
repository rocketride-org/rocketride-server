		{
			"id": "chroma_2",
			"provider": "chroma",
			"config": {
				"profile": "local",
				"local": {
					"host": "${ROCKETRIDE_CHROMA_HOST}",
					"port": 8000,
					"collection": "${ROCKETRIDE_COLLECTION_NAME}",
					"top_k": 20
				},
				"parameters": {}
			},
			"input": [{ "lane": "questions", "from": "embedding_transformer_2" }],
			"ui": { "position": { "x": 460, "y": 500 }, "measured": { "width": 150, "height": 175 }, "nodeType": "default", "formDataValid": true }
		},
		{
			"id": "rerank_cohere_1",
			"provider": "rerank_cohere",
			"config": {
				"profile": "rerank-english-v3.0",
				"rerank-english-v3.0": {
					"top_n": 5,
					"min_score": 0.0,
					"apikey": "${ROCKETRIDE_RERANK_COHERE_KEY}"
