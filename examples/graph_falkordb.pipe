{
	"components": [
		{
			"id": "chat_1",
			"provider": "chat",
			"name": "Ask a question",
			"config": { "hideForm": true, "mode": "Source", "parameters": {}, "type": "chat" },
			"ui": { "position": { "x": 20, "y": 220 }, "nodeType": "default", "formDataValid": true }
		},
		{
			"id": "graph_falkordb_1",
			"provider": "graph_falkordb",
			"name": "FalkorDB",
			"config": {
				"profile": "default",
				"default": {
					"host": "${ROCKETRIDE_FALKORDB_HOST}",
					"port": 6379,
					"username": "${ROCKETRIDE_FALKORDB_USER}",
					"password": "${ROCKETRIDE_FALKORDB_PASSWORD}",
					"tls": false,
					"graph": "smoke",
					"db_description": "Social graph: Person nodes connected by KNOWS relationships, and Person-[:LIVES_IN]->City.",
					"allow_writes": false,
					"allow_execute": false,
					"max_attempts": 5,
					"max_rows": 250,
					"max_execute_rows": 25000,
					"query_timeout_ms": 30000
				},
				"parameters": {}
			},
			"input": [{ "lane": "questions", "from": "chat_1" }],
			"ui": { "position": { "x": 260, "y": 220 }, "nodeType": "default", "formDataValid": true }
		},
		{
			"id": "llm_anthropic_1",
			"provider": "llm_anthropic",
			"name": "Anthropic",
			"config": {
				"profile": "claude-sonnet-4-6",
				"claude-sonnet-4-6": { "apikey": "${ROCKETRIDE_ANTHROPIC_KEY}" },
				"parameters": {}
			},
			"control": [{ "classType": "llm", "from": "graph_falkordb_1" }],
			"ui": { "position": { "x": 260, "y": 400 }, "nodeType": "default", "formDataValid": true }
		},
		{
			"id": "response_answers_1",
			"provider": "response_answers",
			"name": "Return Answers",
			"config": { "laneName": "answers" },
			"input": [{ "lane": "answers", "from": "graph_falkordb_1" }],
			"ui": { "position": { "x": 500, "y": 140 }, "nodeType": "default", "formDataValid": true }
		},
		{
			"id": "response_table_1",
			"provider": "response_table",
			"name": "Return Table",
			"config": { "laneName": "table" },
			"input": [{ "lane": "table", "from": "graph_falkordb_1" }],
			"ui": { "position": { "x": 500, "y": 300 }, "nodeType": "default", "formDataValid": true }
		}
	],
	"version": 1,
	"isLocked": false
}
