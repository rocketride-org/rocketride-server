[
  {"do": "engine", "args": ["write", "apps/verify-notes/package.json", "fixtures/package.json"], "label": "seed-manifest"},
  {"do": "engine", "args": ["write", "apps/verify-notes/src/App.tsx", "fixtures/App.tsx"], "label": "seed"},
  {"do": "open"},
  {"do": "openFile", "path": "apps/verify-notes/src/App.tsx"},
  {"do": "click", "css": "div[draggable=\"true\"] > span:text-is(\"App.tsx\")", "label": "focus-tab"},
  {"do": "press", "key": "Control+Backslash", "label": "split-right"},
  {"do": "wait", "ms": 3000},
  {"do": "click", "css": ".monaco-editor .view-lines", "nth": 0},
  {"do": "press", "key": "Control+End"},
  {"do": "type", "value": "\n// RRVERIFY user edit, saved"},
  {"do": "shot", "label": "typed-in-left-split"},
  {"do": "press", "key": "Control+s"},
  {"do": "wait", "ms": 2000},
  {"do": "shot", "label": "after-ctrl-s"},
  {"do": "expectEngine", "args": ["cat", "apps/verify-notes/src/App.tsx"], "contains": "RRVERIFY user edit, saved", "label": "saved"},
  {"do": "expectNoText", "text": "changed outside this editor", "label": "no-stale-banner"},
  {"do": "expectNoText", "text": "\u25cf", "label": "both-splits-clean"},
  {"do": "newSession"},
  {"do": "send", "text": "Change the heading in apps/verify-notes/src/App.tsx to say \"Hello from the agent\". Keep everything else as it is.", "label": "turn1"},
  {"do": "waitTurn", "answer": "Keep mine", "expectDialogs": 0, "label": "turn1"},
  {"do": "expectEngine", "args": ["cat", "apps/verify-notes/src/App.tsx"], "contains": "Hello from the agent", "label": "agent-edit-landed"},
  {"do": "expectEngine", "args": ["cat", "apps/verify-notes/src/App.tsx"], "contains": "RRVERIFY user edit, saved", "label": "user-save-kept"}
]
