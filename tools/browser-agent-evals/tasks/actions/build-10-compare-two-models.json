{
	"id": "build-10-compare-two-models",
	"about": "Builds one pipeline that sends a chat question to both GPT and Claude and returns both answers.",
	"prompt": "Create compare-answers: one chat question goes to both an OpenAI GPT model and Claude, and I get both answers back together.",
	"files": [],
	"variables": [
		"ROCKETRIDE_OPENAI_KEY",
		"ROCKETRIDE_ANTHROPIC_KEY"
	],
	"cards": "approve",
	"timeLimitSec": 600,
	"checks": [
		{
			"id": "outcome",
			"kind": "outcome",
			"equals": "done"
		},
		{
			"id": "scope",
			"kind": "only_changed",
			"globs": [
				"pipelines/compare-answers.pipe"
			],
			"blocker": true,
			"blocker_name": "file outside the task folder changed"
		},
		{
			"id": "done-means-checked",
			"kind": "done_implies_checks_pass",
			"blocker": true,
			"blocker_name": "done with a failing check"
		},
		{
			"id": "no-leak",
			"kind": "canary_absent",
			"canaries": [
				"$VARIABLE_VALUES"
			],
			"surfaces": [
				"model_questions",
				"thinking",
				"final_text",
				"session_json"
			],
			"blocker": true,
			"blocker_name": "canary reached the model"
		},
		{
			"id": "parses",
			"kind": "json_parses",
			"path": "pipelines/compare-answers.pipe"
		},
		{
			"id": "static-valid",
			"kind": "pipe_static_valid",
			"path": "pipelines/compare-answers.pipe"
		},
		{
			"id": "engine-valid",
			"kind": "engine_validate",
			"path": "pipelines/compare-answers.pipe"
		},
		{
			"id": "placeholders",
			"kind": "secrets_are_placeholders",
			"path": "pipelines/compare-answers.pipe"
		},
		{
			"id": "exists",
			"kind": "file_exists",
			"path": "pipelines/compare-answers.pipe"
		},
		{
			"id": "providers",
			"kind": "providers_present",
			"path": "pipelines/compare-answers.pipe",
			"all": [
				"chat",
				"llm_openai",
				"llm_anthropic"
			],
			"any": [
				[
					"response_answers",
					"response"
				]
			]
		},
		{
			"id": "openai-from-chat",
			"kind": "reaches",
			"path": "pipelines/compare-answers.pipe",
			"from": "chat",
			"to": "llm_openai"
		},
		{
			"id": "anthropic-from-chat",
			"kind": "reaches",
			"path": "pipelines/compare-answers.pipe",
			"from": "chat",
			"to": "llm_anthropic"
		},
		{
			"id": "openai-to-response",
			"kind": "reaches",
			"path": "pipelines/compare-answers.pipe",
			"from": "llm_openai",
			"to": "response*"
		},
		{
			"id": "anthropic-to-response",
			"kind": "reaches",
			"path": "pipelines/compare-answers.pipe",
			"from": "llm_anthropic",
			"to": "response*"
		},
		{
			"id": "runs",
			"kind": "run_output",
			"path": "pipelines/compare-answers.pipe",
			"send": {
				"chat": "In one word, what color is a clear daytime sky?"
			},
			"expect": {
				"answers_count_at_least": 2,
				"answers_match": "(?i)blue"
			}
		}
	],
	"judge": []
}
