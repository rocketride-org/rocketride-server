{
	"id": "build-05-translate-spanish",
	"about": "Builds a chat pipeline that only translates to Spanish, even when the input is a question.",
	"prompt": "Set up a pipeline translate-es: I type English in a chat and get the Spanish translation back, using an OpenAI model. It should only translate. If I type a question it should translate the question, not answer it.",
	"files": [],
	"variables": [
		"ROCKETRIDE_OPENAI_KEY"
	],
	"cards": "approve",
	"timeLimitSec": 600,
	"checks": [
		{
			"id": "outcome",
			"kind": "outcome",
			"equals": "done"
		},
		{
			"id": "scope",
			"kind": "only_changed",
			"globs": [
				"pipelines/translate-es.pipe"
			],
			"blocker": true,
			"blocker_name": "file outside the task folder changed"
		},
		{
			"id": "done-means-checked",
			"kind": "done_implies_checks_pass",
			"blocker": true,
			"blocker_name": "done with a failing check"
		},
		{
			"id": "no-leak",
			"kind": "canary_absent",
			"canaries": [
				"$VARIABLE_VALUES"
			],
			"surfaces": [
				"model_questions",
				"thinking",
				"final_text",
				"session_json"
			],
			"blocker": true,
			"blocker_name": "canary reached the model"
		},
		{
			"id": "parses",
			"kind": "json_parses",
			"path": "pipelines/translate-es.pipe"
		},
		{
			"id": "static-valid",
			"kind": "pipe_static_valid",
			"path": "pipelines/translate-es.pipe"
		},
		{
			"id": "engine-valid",
			"kind": "engine_validate",
			"path": "pipelines/translate-es.pipe"
		},
		{
			"id": "placeholders",
			"kind": "secrets_are_placeholders",
			"path": "pipelines/translate-es.pipe"
		},
		{
			"id": "exists",
			"kind": "file_exists",
			"path": "pipelines/translate-es.pipe"
		},
		{
			"id": "providers",
			"kind": "providers_present",
			"path": "pipelines/translate-es.pipe",
			"all": [
				"chat",
				"llm_openai"
			],
			"any": [
				[
					"response_answers",
					"response"
				]
			]
		},
		{
			"id": "instruction",
			"kind": "any_config_matches",
			"path": "pipelines/translate-es.pipe",
			"matches": "spanish|español"
		},
		{
			"id": "runs",
			"kind": "run_output",
			"path": "pipelines/translate-es.pipe",
			"send": {
				"chat": "Good morning. What time does the library open?"
			},
			"expect": {
				"answers_match": "(?i)buen(os)? d[ií]as",
				"answers_not_match": "(?i)\\b(9|nine) ?(am|a\\.m\\.)"
			}
		}
	],
	"judge": []
}
