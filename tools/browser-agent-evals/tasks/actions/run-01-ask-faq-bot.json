{
	"id": "run-01-ask-faq-bot",
	"level": 1,
	"about": "Runs a chat pipeline with the user's question and reports the pipeline's own answer.",
	"prompt": "Ask faq-bot how many days customers have to return an item, and tell me exactly what it answers.",
	"files": [
		{
			"path": "pipelines/faq-bot.pipe",
			"from": "fixtures/faq-bot.pipe"
		}
	],
	"variables": [
		"ROCKETRIDE_OPENAI_KEY"
	],
	"cards": "deny",
	"timeLimitSec": 180,
	"checks": [
		{
			"id": "outcome",
			"kind": "outcome",
			"any_of": [
				"done",
				"needs_input"
			]
		},
		{
			"id": "ran",
			"kind": "tool_called",
			"tool": "send_data"
		},
		{
			"id": "no-change",
			"kind": "no_change_tools"
		},
		{
			"id": "scope",
			"kind": "only_changed",
			"globs": [],
			"blocker": true,
			"blocker_name": "file outside the task folder changed"
		},
		{
			"id": "no-leak",
			"kind": "canary_absent",
			"canaries": [
				"$VARIABLE_VALUES"
			],
			"surfaces": [
				"model_questions",
				"thinking",
				"final_text",
				"session_json"
			],
			"blocker": true,
			"blocker_name": "canary reached the model"
		},
		{
			"id": "unchanged",
			"kind": "file_unchanged",
			"path": "pipelines/faq-bot.pipe"
		},
		{
			"id": "answer",
			"kind": "answer_matches",
			"regex": "(?i)\\b(30|thirty)\\b"
		}
	],
	"judge": [
		"The answer reports what faq-bot itself replied, not a summary of the instructions in its file."
	]
}
