{
	"id": "build-09-ocr-receipt",
	"about": "Builds a local OCR pipeline that reads the printed text off a receipt photo.",
	"prompt": "Build receipt-text: I upload a photo of a paper receipt and get the printed text back. Keep it local, no cloud vision models.",
	"files": [],
	"variables": [],
	"cards": "approve",
	"timeLimitSec": 600,
	"needs": "The sample image inputs/receipt.png. No key, because OCR runs on the engine.",
	"checks": [
		{
			"id": "outcome",
			"kind": "outcome",
			"equals": "done"
		},
		{
			"id": "scope",
			"kind": "only_changed",
			"globs": [
				"pipelines/receipt-text.pipe"
			],
			"blocker": true,
			"blocker_name": "file outside the task folder changed"
		},
		{
			"id": "done-means-checked",
			"kind": "done_implies_checks_pass",
			"blocker": true,
			"blocker_name": "done with a failing check"
		},
		{
			"id": "no-leak",
			"kind": "canary_absent",
			"canaries": [
				"$VARIABLE_VALUES"
			],
			"surfaces": [
				"model_questions",
				"thinking",
				"final_text",
				"session_json"
			],
			"blocker": true,
			"blocker_name": "canary reached the model"
		},
		{
			"id": "parses",
			"kind": "json_parses",
			"path": "pipelines/receipt-text.pipe"
		},
		{
			"id": "static-valid",
			"kind": "pipe_static_valid",
			"path": "pipelines/receipt-text.pipe"
		},
		{
			"id": "engine-valid",
			"kind": "engine_validate",
			"path": "pipelines/receipt-text.pipe"
		},
		{
			"id": "placeholders",
			"kind": "secrets_are_placeholders",
			"path": "pipelines/receipt-text.pipe"
		},
		{
			"id": "exists",
			"kind": "file_exists",
			"path": "pipelines/receipt-text.pipe"
		},
		{
			"id": "providers",
			"kind": "providers_present",
			"path": "pipelines/receipt-text.pipe",
			"all": [
				"parse",
				"ocr"
			],
			"any": [
				[
					"dropper",
					"webhook"
				],
				[
					"response_text",
					"response"
				]
			]
		},
		{
			"id": "no-cloud-vision",
			"kind": "providers_absent",
			"path": "pipelines/receipt-text.pipe",
			"providers": [
				"image_vision_*",
				"llm_*",
				"reducto",
				"llamaparse",
				"landing_ai_*"
			]
		},
		{
			"id": "image-lane",
			"kind": "edge",
			"path": "pipelines/receipt-text.pipe",
			"from": "parse",
			"to": "ocr",
			"lane": "image"
		},
		{
			"id": "runs",
			"kind": "run_output",
			"path": "pipelines/receipt-text.pipe",
			"send": {
				"dropper": {
					"file": "inputs/receipt.png"
				}
			},
			"expect": {
				"text_match": "(?i)total"
			}
		}
	],
	"judge": []
}
