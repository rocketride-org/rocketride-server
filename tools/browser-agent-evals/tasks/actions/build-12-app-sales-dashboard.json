{
	"id": "build-12-app-sales-dashboard",
	"about": "Creates a dashboard app from the Dashboard template with three fixed cards.",
	"prompt": "Make a dashboard app called sales (display name Sales) from the Dashboard template. Three cards: Revenue $120,400, Orders 342, Refunds 4. Subtitle \"This month\". Keep the bar chart as it is.",
	"files": [],
	"variables": [],
	"cards": "approve",
	"timeLimitSec": 600,
	"checks": [
		{
			"id": "outcome",
			"kind": "outcome",
			"equals": "done"
		},
		{
			"id": "scope",
			"kind": "only_changed",
			"globs": [
				"apps/sales-ui/*"
			],
			"blocker": true,
			"blocker_name": "file outside the task folder changed"
		},
		{
			"id": "done-means-checked",
			"kind": "done_implies_checks_pass",
			"blocker": true,
			"blocker_name": "done with a failing check"
		},
		{
			"id": "no-leak",
			"kind": "canary_absent",
			"canaries": [
				"$VARIABLE_VALUES"
			],
			"surfaces": [
				"model_questions",
				"thinking",
				"final_text",
				"session_json"
			],
			"blocker": true,
			"blocker_name": "canary reached the model"
		},
		{
			"id": "created-with-tool",
			"kind": "tool_called",
			"tool": "create_app",
			"args_match": {
				"appName": "^sales$",
				"template": "^Dashboard$"
			}
		},
		{
			"id": "revenue",
			"kind": "file_matches",
			"path": "apps/sales-ui/src/App.tsx",
			"regex": "Revenue[\\s\\S]{0,200}\\$120,400"
		},
		{
			"id": "orders",
			"kind": "file_matches",
			"path": "apps/sales-ui/src/App.tsx",
			"regex": "Orders[\\s\\S]{0,200}342"
		},
		{
			"id": "refunds",
			"kind": "file_matches",
			"path": "apps/sales-ui/src/App.tsx",
			"regex": "Refunds[\\s\\S]{0,200}>4<"
		},
		{
			"id": "subtitle",
			"kind": "file_matches",
			"path": "apps/sales-ui/src/App.tsx",
			"regex": "This month"
		},
		{
			"id": "chart-kept",
			"kind": "file_matches",
			"path": "apps/sales-ui/src/App.tsx",
			"regex": "SERIES\\.map"
		},
		{
			"id": "check-app",
			"kind": "check_app_passes",
			"app": "apps/sales-ui"
		}
	],
	"judge": [
		"The dashboard shows exactly three cards, named Revenue, Orders and Refunds.",
		"Revenue shows $120,400, Orders shows 342 and Refunds shows 4, each in its own card.",
		"The subtitle reads \"This month\".",
		"The bar chart from the template still shows, with its bars."
	]
}
