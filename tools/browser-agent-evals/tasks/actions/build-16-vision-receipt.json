{
	"id": "build-16-vision-receipt",
	"level": 3,
	"about": "Builds a pipeline that reads a receipt photo with an OpenAI vision model and returns the store and the total.",
	"prompt": "Build receipt-reader: I upload a photo of a receipt, GPT-4o looks at the image, and I get back the store's name and the total paid. My OpenAI key is in Variables.",
	"files": [],
	"variables": [
		"ROCKETRIDE_OPENAI_KEY"
	],
	"cards": "approve",
	"timeLimitSec": 600,
	"needs": "The sample image inputs/receipt.png. No key beyond OpenAI.",
	"checks": [
		{
			"id": "outcome",
			"kind": "outcome",
			"equals": "done"
		},
		{
			"id": "scope",
			"kind": "only_changed",
			"globs": [
				"pipelines/receipt-reader.pipe"
			],
			"blocker": true,
			"blocker_name": "file outside the task folder changed"
		},
		{
			"id": "done-means-checked",
			"kind": "done_implies_checks_pass",
			"blocker": true,
			"blocker_name": "done with a failing check"
		},
		{
			"id": "no-leak",
			"kind": "canary_absent",
			"canaries": [
				"$VARIABLE_VALUES"
			],
			"surfaces": [
				"model_questions",
				"thinking",
				"final_text",
				"session_json"
			],
			"blocker": true,
			"blocker_name": "canary reached the model"
		},
		{
			"id": "parses",
			"kind": "json_parses",
			"path": "pipelines/receipt-reader.pipe"
		},
		{
			"id": "static-valid",
			"kind": "pipe_static_valid",
			"path": "pipelines/receipt-reader.pipe"
		},
		{
			"id": "engine-valid",
			"kind": "engine_validate",
			"path": "pipelines/receipt-reader.pipe"
		},
		{
			"id": "placeholders",
			"kind": "secrets_are_placeholders",
			"path": "pipelines/receipt-reader.pipe"
		},
		{
			"id": "exists",
			"kind": "file_exists",
			"path": "pipelines/receipt-reader.pipe"
		},
		{
			"id": "providers",
			"kind": "providers_present",
			"path": "pipelines/receipt-reader.pipe",
			"all": [
				"dropper",
				"parse",
				"image_vision_openai"
			],
			"any": [
				[
					"response_text",
					"response"
				]
			]
		},
		{
			"id": "image-lane",
			"kind": "edge",
			"path": "pipelines/receipt-reader.pipe",
			"from": "parse",
			"to": "image_vision_openai",
			"lane": "image"
		},
		{
			"id": "model",
			"kind": "config_value",
			"path": "pipelines/receipt-reader.pipe",
			"provider": "image_vision_openai",
			"pointer": "profile",
			"equals": "openai-4o"
		},
		{
			"id": "key",
			"kind": "config_value",
			"path": "pipelines/receipt-reader.pipe",
			"provider": "image_vision_openai",
			"pointer": "{profile}/apikey",
			"equals": "${ROCKETRIDE_OPENAI_KEY}"
		},
		{
			"id": "asks-for-total",
			"kind": "any_config_matches",
			"path": "pipelines/receipt-reader.pipe",
			"provider": "image_vision_openai",
			"matches": "(?i)total"
		},
		{
			"id": "runs",
			"kind": "run_output",
			"path": "pipelines/receipt-reader.pipe",
			"send": {
				"dropper": {
					"file": "inputs/receipt.png"
				}
			},
			"expect": {
				"text_match": "(?is)(?=.*corner market)(?=.*27\\.14)"
			}
		}
	],
	"judge": []
}
