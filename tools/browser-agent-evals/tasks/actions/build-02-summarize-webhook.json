{
	"id": "build-02-summarize-webhook",
	"about": "Builds a webhook pipeline that returns a short OpenAI summary of posted text.",
	"prompt": "Make a pipeline named summarize-text. I post plain text to it over a webhook and get back a short summary, about 80 words. Use OpenAI for the model.",
	"files": [],
	"variables": [
		"ROCKETRIDE_OPENAI_KEY"
	],
	"cards": "approve",
	"timeLimitSec": 600,
	"checks": [
		{
			"id": "outcome",
			"kind": "outcome",
			"equals": "done"
		},
		{
			"id": "scope",
			"kind": "only_changed",
			"globs": [
				"pipelines/summarize-text.pipe"
			],
			"blocker": true,
			"blocker_name": "file outside the task folder changed"
		},
		{
			"id": "done-means-checked",
			"kind": "done_implies_checks_pass",
			"blocker": true,
			"blocker_name": "done with a failing check"
		},
		{
			"id": "no-leak",
			"kind": "canary_absent",
			"canaries": [
				"$VARIABLE_VALUES"
			],
			"surfaces": [
				"model_questions",
				"thinking",
				"final_text",
				"session_json"
			],
			"blocker": true,
			"blocker_name": "canary reached the model"
		},
		{
			"id": "parses",
			"kind": "json_parses",
			"path": "pipelines/summarize-text.pipe"
		},
		{
			"id": "static-valid",
			"kind": "pipe_static_valid",
			"path": "pipelines/summarize-text.pipe"
		},
		{
			"id": "engine-valid",
			"kind": "engine_validate",
			"path": "pipelines/summarize-text.pipe"
		},
		{
			"id": "placeholders",
			"kind": "secrets_are_placeholders",
			"path": "pipelines/summarize-text.pipe"
		},
		{
			"id": "exists",
			"kind": "file_exists",
			"path": "pipelines/summarize-text.pipe"
		},
		{
			"id": "source",
			"kind": "providers_present",
			"path": "pipelines/summarize-text.pipe",
			"all": [
				"webhook",
				"llm_openai"
			],
			"any": [
				[
					"response_text",
					"response_answers",
					"response"
				]
			]
		},
		{
			"id": "no-other-llm",
			"kind": "providers_absent",
			"path": "pipelines/summarize-text.pipe",
			"providers": [
				"llm_anthropic",
				"llm_gemini",
				"llm_mistral"
			]
		},
		{
			"id": "path",
			"kind": "reaches",
			"path": "pipelines/summarize-text.pipe",
			"from": "webhook",
			"to": "response*"
		},
		{
			"id": "runs",
			"kind": "run_output",
			"path": "pipelines/summarize-text.pipe",
			"send": {
				"webhook": {
					"file": "inputs/long-article.txt",
					"mimetype": "text/plain"
				}
			},
			"expect": {
				"nonempty": true,
				"shorter_than_input": true
			}
		}
	],
	"judge": []
}
