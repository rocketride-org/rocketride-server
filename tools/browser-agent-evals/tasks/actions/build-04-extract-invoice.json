{
	"id": "build-04-extract-invoice",
	"level": 3,
	"about": "Builds a pipeline that pulls four typed fields out of an invoice with OpenAI.",
	"prompt": "Create a pipeline invoice-fields. I send an invoice file (PDF or plain text) to a webhook and get back four fields: invoice_number, vendor, total as a number and due_date as a date. Use OpenAI to do the extraction.",
	"files": [],
	"variables": [
		"ROCKETRIDE_OPENAI_KEY"
	],
	"cards": "approve",
	"timeLimitSec": 600,
	"checks": [
		{
			"id": "outcome",
			"kind": "outcome",
			"equals": "done"
		},
		{
			"id": "scope",
			"kind": "only_changed",
			"globs": [
				"pipelines/invoice-fields.pipe"
			],
			"blocker": true,
			"blocker_name": "file outside the task folder changed"
		},
		{
			"id": "done-means-checked",
			"kind": "done_implies_checks_pass",
			"blocker": true,
			"blocker_name": "done with a failing check"
		},
		{
			"id": "no-leak",
			"kind": "canary_absent",
			"canaries": [
				"$VARIABLE_VALUES"
			],
			"surfaces": [
				"model_questions",
				"thinking",
				"final_text",
				"session_json"
			],
			"blocker": true,
			"blocker_name": "canary reached the model"
		},
		{
			"id": "parses",
			"kind": "json_parses",
			"path": "pipelines/invoice-fields.pipe"
		},
		{
			"id": "static-valid",
			"kind": "pipe_static_valid",
			"path": "pipelines/invoice-fields.pipe"
		},
		{
			"id": "engine-valid",
			"kind": "engine_validate",
			"path": "pipelines/invoice-fields.pipe"
		},
		{
			"id": "placeholders",
			"kind": "secrets_are_placeholders",
			"path": "pipelines/invoice-fields.pipe"
		},
		{
			"id": "exists",
			"kind": "file_exists",
			"path": "pipelines/invoice-fields.pipe"
		},
		{
			"id": "providers",
			"kind": "providers_present",
			"path": "pipelines/invoice-fields.pipe",
			"all": [
				"webhook",
				"extract_data",
				"llm_openai"
			],
			"any": [
				[
					"response_answers",
					"response_json",
					"response_table",
					"response"
				]
			]
		},
		{
			"id": "llm-control",
			"kind": "control",
			"path": "pipelines/invoice-fields.pipe",
			"provider": "llm_openai",
			"classType": "llm",
			"invoker": "extract_data"
		},
		{
			"id": "fields",
			"kind": "extract_fields",
			"path": "pipelines/invoice-fields.pipe",
			"columns": [
				"invoice_number",
				"vendor",
				"total",
				"due_date"
			],
			"types": {
				"total": [
					"decimal",
					"int"
				],
				"due_date": [
					"date",
					"datetime"
				]
			}
		},
		{
			"id": "runs",
			"kind": "run_output",
			"path": "pipelines/invoice-fields.pipe",
			"send": {
				"webhook": {
					"file": "inputs/invoice-2041.txt",
					"mimetype": "text/plain"
				}
			},
			"expect": {
				"answers_match_all": [
					"INV-2041",
					"(?i)northwind",
					"1,?250(\\.00)?",
					"2026-11-15|11/15/2026|15 Nov"
				]
			}
		}
	],
	"judge": []
}
