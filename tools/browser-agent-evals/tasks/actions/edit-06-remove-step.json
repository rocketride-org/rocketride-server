{
	"id": "edit-06-remove-step",
	"level": 2,
	"about": "Removes one step from a pipeline and rewires the rest.",
	"prompt": "Take the anonymize step out of notes-digest. Keep everything else the same.",
	"files": [
		{
			"path": "pipelines/notes-digest.pipe",
			"from": "fixtures/notes-digest.pipe"
		}
	],
	"variables": [
		"ROCKETRIDE_OPENAI_KEY"
	],
	"cards": "approve",
	"timeLimitSec": 300,
	"checks": [
		{
			"id": "outcome",
			"kind": "outcome",
			"equals": "done"
		},
		{
			"id": "scope",
			"kind": "only_changed",
			"globs": [
				"pipelines/notes-digest.pipe"
			],
			"blocker": true,
			"blocker_name": "file outside the task folder changed"
		},
		{
			"id": "done-means-checked",
			"kind": "done_implies_checks_pass",
			"blocker": true,
			"blocker_name": "done with a failing check"
		},
		{
			"id": "no-leak",
			"kind": "canary_absent",
			"canaries": [
				"$VARIABLE_VALUES"
			],
			"surfaces": [
				"model_questions",
				"thinking",
				"final_text",
				"session_json"
			],
			"blocker": true,
			"blocker_name": "canary reached the model"
		},
		{
			"id": "parses",
			"kind": "json_parses",
			"path": "pipelines/notes-digest.pipe"
		},
		{
			"id": "static-valid",
			"kind": "pipe_static_valid",
			"path": "pipelines/notes-digest.pipe"
		},
		{
			"id": "engine-valid",
			"kind": "engine_validate",
			"path": "pipelines/notes-digest.pipe"
		},
		{
			"id": "placeholders",
			"kind": "secrets_are_placeholders",
			"path": "pipelines/notes-digest.pipe"
		},
		{
			"id": "project-id",
			"kind": "project_id_unchanged",
			"path": "pipelines/notes-digest.pipe",
			"from": "pipelines/notes-digest.pipe"
		},
		{
			"id": "gone",
			"kind": "providers_absent",
			"path": "pipelines/notes-digest.pipe",
			"providers": [
				"anonymize_text"
			]
		},
		{
			"id": "rewired",
			"kind": "edge",
			"path": "pipelines/notes-digest.pipe",
			"from": "webhook",
			"to": "summarization",
			"lane": "text"
		},
		{
			"id": "llm-kept",
			"kind": "control",
			"path": "pipelines/notes-digest.pipe",
			"provider": "llm_openai",
			"classType": "llm",
			"invoker": "summarization"
		},
		{
			"id": "summary-config-kept",
			"kind": "config_value",
			"path": "pipelines/notes-digest.pipe",
			"provider": "summarization",
			"pointer": "{profile}/numberOfSummaryWords",
			"equals": 80
		}
	],
	"judge": []
}
