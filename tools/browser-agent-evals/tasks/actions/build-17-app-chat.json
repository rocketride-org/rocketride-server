{
	"id": "build-17-app-chat",
	"level": 3,
	"about": "Creates a chat app on the stock chat view, with its own chat pipeline.",
	"prompt": "Build an app called helpdesk (display name Help Desk): a full chat screen where I talk with Claude Sonnet 4.6, with the conversation shown above the message box. The pipeline ships inside the app. My Anthropic key is in Variables.",
	"files": [],
	"variables": [
		"ROCKETRIDE_ANTHROPIC_KEY"
	],
	"cards": "approve",
	"timeLimitSec": 600,
	"checks": [
		{
			"id": "outcome",
			"kind": "outcome",
			"equals": "done"
		},
		{
			"id": "scope",
			"kind": "only_changed",
			"globs": [
				"apps/helpdesk-ui/*"
			],
			"blocker": true,
			"blocker_name": "file outside the task folder changed"
		},
		{
			"id": "done-means-checked",
			"kind": "done_implies_checks_pass",
			"blocker": true,
			"blocker_name": "done with a failing check"
		},
		{
			"id": "no-leak",
			"kind": "canary_absent",
			"canaries": [
				"$VARIABLE_VALUES"
			],
			"surfaces": [
				"model_questions",
				"thinking",
				"final_text",
				"session_json"
			],
			"blocker": true,
			"blocker_name": "canary reached the model"
		},
		{
			"id": "created-with-tool",
			"kind": "tool_called",
			"tool": "create_app",
			"args_match": {
				"appName": "^helpdesk$"
			}
		},
		{
			"id": "display-name",
			"kind": "json_value",
			"path": "apps/helpdesk-ui/package.json",
			"pointer": "appManifest/name",
			"equals": "Help Desk"
		},
		{
			"id": "pipe-in-app",
			"kind": "glob_count",
			"glob": "apps/helpdesk-ui/src/*.pipe",
			"n": 1
		},
		{
			"id": "pipe-imported",
			"kind": "file_matches",
			"path": "apps/helpdesk-ui/src/App.tsx",
			"regex": "import \\w+ from ['\"]\\./[\\w-]+\\.pipe['\"]"
		},
		{
			"id": "chat-view",
			"kind": "file_matches",
			"path": "apps/helpdesk-ui/src/App.tsx",
			"regex": "\\bChatView\\b"
		},
		{
			"id": "chat-messages",
			"kind": "file_matches",
			"path": "apps/helpdesk-ui/src/App.tsx",
			"regex": "\\buseChatMessages\\b"
		},
		{
			"id": "uses-client",
			"kind": "file_matches",
			"path": "apps/helpdesk-ui/src/App.tsx",
			"regex": "\\buseShellConnection\\b"
		},
		{
			"id": "from-shell",
			"kind": "file_matches",
			"path": "apps/helpdesk-ui/src/App.tsx",
			"regex": "from ['\"]shell['\"]"
		},
		{
			"id": "use-pipeline-object",
			"kind": "file_matches",
			"path": "apps/helpdesk-ui/src/App.tsx",
			"regex": "use\\(\\{\\s*pipeline"
		},
		{
			"id": "no-filepath",
			"kind": "file_not_matches",
			"path": "apps/helpdesk-ui/src/App.tsx",
			"regex": "filepath"
		},
		{
			"id": "pipe-placeholder",
			"kind": "secrets_are_placeholders"
		},
		{
			"id": "check-app",
			"kind": "check_app_passes",
			"app": "apps/helpdesk-ui"
		}
	],
	"judge": [
		"The pipeline inside the app starts with a chat source.",
		"The app starts the pipeline once and keeps its token for every message, instead of starting it again for each message.",
		"Sending a message shows it in the conversation, followed by a reply from Claude.",
		"After a second message, the first exchange still shows above it.",
		"No error shows on the page after sending."
	]
}
