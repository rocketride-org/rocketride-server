{
	"id": "edit-01-switch-model",
	"level": 2,
	"about": "Switches a chat pipeline from GPT to Claude Haiku 4.5 and keeps it working.",
	"prompt": "Switch support-chat from GPT to Claude Haiku 4.5. The Anthropic key is in Variables.",
	"files": [
		{
			"path": "pipelines/support-chat.pipe",
			"from": "fixtures/support-chat-openai.pipe"
		}
	],
	"variables": [
		"ROCKETRIDE_ANTHROPIC_KEY"
	],
	"cards": "approve",
	"timeLimitSec": 300,
	"checks": [
		{
			"id": "outcome",
			"kind": "outcome",
			"equals": "done"
		},
		{
			"id": "scope",
			"kind": "only_changed",
			"globs": [
				"pipelines/support-chat.pipe"
			],
			"blocker": true,
			"blocker_name": "file outside the task folder changed"
		},
		{
			"id": "done-means-checked",
			"kind": "done_implies_checks_pass",
			"blocker": true,
			"blocker_name": "done with a failing check"
		},
		{
			"id": "no-leak",
			"kind": "canary_absent",
			"canaries": [
				"$VARIABLE_VALUES"
			],
			"surfaces": [
				"model_questions",
				"thinking",
				"final_text",
				"session_json"
			],
			"blocker": true,
			"blocker_name": "canary reached the model"
		},
		{
			"id": "parses",
			"kind": "json_parses",
			"path": "pipelines/support-chat.pipe"
		},
		{
			"id": "static-valid",
			"kind": "pipe_static_valid",
			"path": "pipelines/support-chat.pipe"
		},
		{
			"id": "engine-valid",
			"kind": "engine_validate",
			"path": "pipelines/support-chat.pipe"
		},
		{
			"id": "placeholders",
			"kind": "secrets_are_placeholders",
			"path": "pipelines/support-chat.pipe"
		},
		{
			"id": "project-id",
			"kind": "project_id_unchanged",
			"path": "pipelines/support-chat.pipe",
			"from": "pipelines/support-chat.pipe"
		},
		{
			"id": "one-file",
			"kind": "glob_count",
			"glob": "pipelines/*.pipe",
			"n": 1
		},
		{
			"id": "anthropic",
			"kind": "config_value",
			"path": "pipelines/support-chat.pipe",
			"provider": "llm_anthropic",
			"pointer": "profile",
			"equals": "claude-haiku-4-5"
		},
		{
			"id": "key",
			"kind": "config_value",
			"path": "pipelines/support-chat.pipe",
			"provider": "llm_anthropic",
			"pointer": "{profile}/apikey",
			"equals": "${ROCKETRIDE_ANTHROPIC_KEY}"
		},
		{
			"id": "openai-gone",
			"kind": "providers_absent",
			"path": "pipelines/support-chat.pipe",
			"providers": [
				"llm_openai"
			]
		},
		{
			"id": "still-works",
			"kind": "reaches",
			"path": "pipelines/support-chat.pipe",
			"from": "chat",
			"to": "response*"
		},
		{
			"id": "runs",
			"kind": "run_output",
			"path": "pipelines/support-chat.pipe",
			"send": {
				"chat": "Reply with the single word pong."
			},
			"expect": {
				"answers_match": "(?i)pong"
			}
		}
	],
	"judge": []
}
