{
	"id": "build-03-rag-chroma",
	"level": 3,
	"about": "Builds a document Q&A pipeline that stores chunks in Chroma and answers from them with Claude.",
	"prompt": "Build a pipeline called docs-qa for our employee handbook. I upload documents with a dropper; they get chunked, embedded with OpenAI text-embedding-3-small and stored in a Chroma collection called handbook. The Chroma host and port are in Variables as ROCKETRIDE_CHROMA_HOST and ROCKETRIDE_CHROMA_PORT. Then I ask questions in a chat and Claude answers from the stored chunks.",
	"files": [],
	"variables": [
		"ROCKETRIDE_OPENAI_KEY",
		"ROCKETRIDE_ANTHROPIC_KEY",
		"ROCKETRIDE_CHROMA_HOST",
		"ROCKETRIDE_CHROMA_PORT"
	],
	"cards": "approve",
	"timeLimitSec": 600,
	"needs": "A Chroma server the engine can reach, which the runner starts in Docker. It needs no key. Its host and port go in Variables as ROCKETRIDE_CHROMA_HOST and ROCKETRIDE_CHROMA_PORT.",
	"checks": [
		{
			"id": "outcome",
			"kind": "outcome",
			"equals": "done"
		},
		{
			"id": "scope",
			"kind": "only_changed",
			"globs": [
				"pipelines/docs-qa.pipe"
			],
			"blocker": true,
			"blocker_name": "file outside the task folder changed"
		},
		{
			"id": "done-means-checked",
			"kind": "done_implies_checks_pass",
			"blocker": true,
			"blocker_name": "done with a failing check"
		},
		{
			"id": "no-leak",
			"kind": "canary_absent",
			"canaries": [
				"$VARIABLE_VALUES"
			],
			"surfaces": [
				"model_questions",
				"thinking",
				"final_text",
				"session_json"
			],
			"blocker": true,
			"blocker_name": "canary reached the model"
		},
		{
			"id": "parses",
			"kind": "json_parses",
			"path": "pipelines/docs-qa.pipe"
		},
		{
			"id": "static-valid",
			"kind": "pipe_static_valid",
			"path": "pipelines/docs-qa.pipe"
		},
		{
			"id": "engine-valid",
			"kind": "engine_validate",
			"path": "pipelines/docs-qa.pipe"
		},
		{
			"id": "placeholders",
			"kind": "secrets_are_placeholders",
			"path": "pipelines/docs-qa.pipe"
		},
		{
			"id": "exists",
			"kind": "file_exists",
			"path": "pipelines/docs-qa.pipe"
		},
		{
			"id": "providers",
			"kind": "providers_present",
			"path": "pipelines/docs-qa.pipe",
			"all": [
				"dropper",
				"chat",
				"embedding_openai",
				"chroma",
				"llm_anthropic"
			],
			"any": [
				[
					"preprocessor_langchain",
					"chunker",
					"preprocessor_llm"
				],
				[
					"response_answers",
					"response"
				]
			]
		},
		{
			"id": "same-embedding",
			"kind": "same_config",
			"path": "pipelines/docs-qa.pipe",
			"provider": "embedding_openai",
			"pointer": "profile"
		},
		{
			"id": "embedding-model",
			"kind": "config_value",
			"path": "pipelines/docs-qa.pipe",
			"provider": "embedding_openai",
			"pointer": "profile",
			"equals": "text-embedding-3-small"
		},
		{
			"id": "collection",
			"kind": "config_value",
			"path": "pipelines/docs-qa.pipe",
			"provider": "chroma",
			"pointer": "{profile}/collection",
			"equals": "handbook"
		},
		{
			"id": "host",
			"kind": "config_value",
			"path": "pipelines/docs-qa.pipe",
			"provider": "chroma",
			"pointer": "{profile}/host",
			"equals": "${ROCKETRIDE_CHROMA_HOST}"
		},
		{
			"id": "ingest-path",
			"kind": "reaches",
			"path": "pipelines/docs-qa.pipe",
			"from": "dropper",
			"to": "chroma"
		},
		{
			"id": "query-path",
			"kind": "reaches",
			"path": "pipelines/docs-qa.pipe",
			"from": "chat",
			"to": "response*"
		},
		{
			"id": "runs",
			"kind": "run_output",
			"path": "pipelines/docs-qa.pipe",
			"needs": "a reachable Chroma server",
			"send": {
				"dropper": {
					"file": "inputs/handbook.txt"
				},
				"then_chat": "How many vacation days do new employees get?"
			},
			"expect": {
				"answers_match": "(?i)\\b(18|eighteen)\\b"
			}
		}
	],
	"judge": []
}
