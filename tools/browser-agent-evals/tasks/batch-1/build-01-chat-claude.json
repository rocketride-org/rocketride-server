{
	"id": "build-01-chat-claude",
	"type": "BUILD",
	"target": "pipeline",
	"title": "Chat pipeline on Claude",
	"prompt": "Build a pipeline called support-chat where I can chat with Claude Sonnet 4.6. My Anthropic key is already in Variables.",
	"files": [],
	"cards": "approve",
	"timeLimitSec": 3600,
	"variables": [
		"ROCKETRIDE_ANTHROPIC_KEY"
	],
	"checks": [
		{
			"id": "outcome",
			"type": "outcome",
			"expect": "done"
		},
		{
			"id": "scope",
			"type": "only_changed",
			"globs": [
				"pipelines/support-chat.pipe"
			],
			"blocker": true,
			"blocker_name": "file outside the task folder changed"
		},
		{
			"id": "done-means-checked",
			"type": "done_implies_checks_pass",
			"blocker": true,
			"blocker_name": "done with a failing check"
		},
		{
			"id": "no-leak",
			"type": "canary_absent",
			"canaries": [
				"$VARIABLE_VALUES"
			],
			"surfaces": [
				"model_questions",
				"thinking",
				"final_text",
				"session_json"
			],
			"blocker": true,
			"blocker_name": "canary reached the model"
		},
		{
			"id": "parses",
			"type": "json_parses",
			"path": "pipelines/support-chat.pipe"
		},
		{
			"id": "static-valid",
			"type": "pipe_static_valid",
			"path": "pipelines/support-chat.pipe"
		},
		{
			"id": "engine-valid",
			"type": "validates",
			"path": "pipelines/support-chat.pipe"
		},
		{
			"id": "placeholders",
			"type": "secrets_are_placeholders",
			"path": "pipelines/support-chat.pipe"
		},
		{
			"id": "file",
			"type": "glob_count",
			"glob": "pipelines/*.pipe",
			"n": 1
		},
		{
			"id": "exists",
			"type": "file_exists",
			"path": "pipelines/support-chat.pipe"
		},
		{
			"id": "providers",
			"type": "providers_present",
			"path": "pipelines/support-chat.pipe",
			"all": [
				"chat",
				"llm_anthropic"
			],
			"any": [
				[
					"response_answers",
					"response"
				]
			]
		},
		{
			"id": "model",
			"type": "config_value",
			"path": "pipelines/support-chat.pipe",
			"provider": "llm_anthropic",
			"pointer": "profile",
			"equals": "claude-sonnet-4-6"
		},
		{
			"id": "key",
			"type": "config_value",
			"path": "pipelines/support-chat.pipe",
			"provider": "llm_anthropic",
			"pointer": "{profile}/apikey",
			"equals": "${ROCKETRIDE_ANTHROPIC_KEY}"
		},
		{
			"id": "path",
			"type": "reaches",
			"path": "pipelines/support-chat.pipe",
			"from": "chat",
			"to": "response*"
		},
		{
			"id": "runs",
			"type": "output",
			"path": "pipelines/support-chat.pipe",
			"send": {
				"chat": "Reply with the single word pong."
			},
			"expect": {
				"answers_match": "(?i)pong"
			}
		}
	],
	"judge": [],
	"hard_because": "Easy on purpose. The building skill tells the model to stop at gates A and B and wait, so even this needs the gate follow-up. The skill also says to write .context/GATE_STATE.md, which the workspace refuses (only apps/, nodes/, pipelines/ exist)."
}
