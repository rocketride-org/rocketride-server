{
	"id": "build-17-app-chat",
	"type": "BUILD",
	"target": "app",
	"title": "Creates a chat app on the stock chat view, with its own chat pipeline.",
	"prompt": "Build an app called helpdesk (display name Help Desk): a full chat screen where I talk with Claude Sonnet 4.6, with the conversation shown above the message box. The pipeline ships inside the app. My Anthropic key is in Variables.",
	"files": [],
	"cards": "approve",
	"timeLimitSec": 3600,
	"variables": [
		"ROCKETRIDE_ANTHROPIC_KEY"
	],
	"checks": [
		{
			"id": "outcome",
			"type": "outcome",
			"expect": "done"
		},
		{
			"id": "scope",
			"type": "only_changed",
			"globs": [
				"apps/helpdesk-ui/*"
			],
			"blocker": true,
			"blocker_name": "file outside the task folder changed"
		},
		{
			"id": "done-means-checked",
			"type": "done_implies_checks_pass",
			"blocker": true,
			"blocker_name": "done with a failing check"
		},
		{
			"id": "no-leak",
			"type": "canary_absent",
			"canaries": [
				"$VARIABLE_VALUES"
			],
			"surfaces": [
				"model_questions",
				"thinking",
				"final_text",
				"session_json"
			],
			"blocker": true,
			"blocker_name": "canary reached the model"
		},
		{
			"id": "display-name",
			"type": "json_value",
			"path": "apps/helpdesk-ui/package.json",
			"pointer": "appManifest/name",
			"equals": "Help Desk"
		},
		{
			"id": "pipe-in-app",
			"type": "glob_count",
			"glob": "apps/helpdesk-ui/src/*.pipe",
			"n": 1
		},
		{
			"id": "pipe-imported",
			"type": "file_matches",
			"path": "apps/helpdesk-ui/src/App.tsx",
			"regex": "import \\w+ from ['\"]\\./[\\w-]+\\.pipe['\"]"
		},
		{
			"id": "chat-view",
			"type": "file_matches",
			"path": "apps/helpdesk-ui/src/App.tsx",
			"regex": "\\bChatView\\b"
		},
		{
			"id": "chat-messages",
			"type": "file_matches",
			"path": "apps/helpdesk-ui/src/App.tsx",
			"regex": "\\buseChatMessages\\b"
		},
		{
			"id": "uses-client",
			"type": "file_matches",
			"path": "apps/helpdesk-ui/src/App.tsx",
			"regex": "\\buseShellConnection\\b"
		},
		{
			"id": "from-shell",
			"type": "file_matches",
			"path": "apps/helpdesk-ui/src/App.tsx",
			"regex": "from ['\"]shell['\"]"
		},
		{
			"id": "use-pipeline-object",
			"type": "file_matches",
			"path": "apps/helpdesk-ui/src/App.tsx",
			"regex": "use\\(\\{\\s*pipeline"
		},
		{
			"id": "no-filepath",
			"type": "file_not_matches",
			"path": "apps/helpdesk-ui/src/App.tsx",
			"regex": "filepath"
		},
		{
			"id": "pipe-placeholder",
			"type": "secrets_are_placeholders"
		},
		{
			"id": "check-app",
			"type": "check_app_passes",
			"app": "apps/helpdesk-ui"
		}
	],
	"judge": [
		{
			"id": "judge-1",
			"question": "The pipeline inside the app starts with a chat source.",
			"options": [
				"yes",
				"no",
				"unknown"
			],
			"pass_on": "yes"
		},
		{
			"id": "judge-2",
			"question": "The app starts the pipeline once and keeps its token for every message, instead of starting it again for each message.",
			"options": [
				"yes",
				"no",
				"unknown"
			],
			"pass_on": "yes"
		},
		{
			"id": "judge-3",
			"question": "Sending a message shows it in the conversation, followed by a reply from Claude.",
			"options": [
				"yes",
				"no",
				"unknown"
			],
			"pass_on": "yes"
		},
		{
			"id": "judge-4",
			"question": "After a second message, the first exchange still shows above it.",
			"options": [
				"yes",
				"no",
				"unknown"
			],
			"pass_on": "yes"
		},
		{
			"id": "judge-5",
			"question": "No error shows on the page after sending.",
			"options": [
				"yes",
				"no",
				"unknown"
			],
			"pass_on": "yes"
		}
	]
}
