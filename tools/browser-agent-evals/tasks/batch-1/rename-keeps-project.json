{
	"id": "rename-keeps-project",
	"type": "EDIT",
	"target": "pipeline",
	"title": "Renames a pipeline file and keeps its project id.",
	"prompt": "Rename the notes-intake pipeline to meeting-notes.",
	"files": [
		{
			"path": "pipelines/notes-intake.pipe",
			"from": "fixtures/notes-intake/pipelines/notes-intake.pipe"
		},
		{
			"path": "pipelines/report-monthly.pipe",
			"from": "fixtures/report-monthly/pipelines/report-monthly.pipe"
		}
	],
	"cards": "approve",
	"timeLimitSec": 3600,
	"variables": [],
	"checks": [
		{
			"id": "ended",
			"type": "outcome",
			"expect": "done"
		},
		{
			"id": "only_these_files",
			"type": "only_changed",
			"globs": [
				"pipelines/meeting-notes.pipe",
				"pipelines/report-monthly.pipe",
				"pipelines/notes-intake.pipe"
			],
			"blocker": true,
			"blocker_name": "file outside the task folder changed"
		},
		{
			"id": "old_path_gone",
			"type": "file_absent",
			"path": "pipelines/notes-intake.pipe"
		},
		{
			"id": "same_project",
			"type": "project_id_unchanged",
			"path": "pipelines/meeting-notes.pipe",
			"from": "pipelines/notes-intake.pipe"
		},
		{
			"id": "other_file_untouched",
			"type": "file_unchanged",
			"path": "pipelines/report-monthly.pipe"
		},
		{
			"id": "validates",
			"type": "validates",
			"path": "pipelines/meeting-notes.pipe"
		},
		{
			"id": "still_answers",
			"type": "output",
			"path": "pipelines/meeting-notes.pipe",
			"send": {
				"webhook": {
					"text": "sentinel-4418 rename check",
					"mimetype": "text/plain"
				}
			},
			"expect": {
				"text_match": "sentinel-4418"
			}
		},
		{
			"id": "no_leak",
			"type": "canary_absent",
			"canaries": [
				"$VARIABLE_VALUES"
			],
			"surfaces": [
				"model_questions",
				"final_text",
				"session_json"
			],
			"blocker": true,
			"blocker_name": "canary reached the model"
		}
	],
	"judge": []
}
