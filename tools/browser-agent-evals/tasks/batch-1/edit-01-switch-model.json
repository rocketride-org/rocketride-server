{
	"id": "edit-01-switch-model",
	"type": "EDIT",
	"target": "pipeline",
	"title": "Switch the chat model to Claude Haiku",
	"prompt": "Switch support-chat from GPT to Claude Haiku 4.5. The Anthropic key is in Variables.",
	"files": [
		{
			"path": "pipelines/support-chat.pipe",
			"from": "fixtures/support-chat-openai/pipelines/support-chat.pipe"
		}
	],
	"cards": "approve",
	"timeLimitSec": 3600,
	"variables": [
		"ROCKETRIDE_ANTHROPIC_KEY"
	],
	"checks": [
		{
			"id": "outcome",
			"type": "outcome",
			"expect": "done"
		},
		{
			"id": "scope",
			"type": "only_changed",
			"globs": [
				"pipelines/support-chat.pipe"
			],
			"blocker": true,
			"blocker_name": "file outside the task folder changed"
		},
		{
			"id": "done-means-checked",
			"type": "done_implies_checks_pass",
			"blocker": true,
			"blocker_name": "done with a failing check"
		},
		{
			"id": "no-leak",
			"type": "canary_absent",
			"canaries": [
				"$VARIABLE_VALUES"
			],
			"surfaces": [
				"model_questions",
				"thinking",
				"final_text",
				"session_json"
			],
			"blocker": true,
			"blocker_name": "canary reached the model"
		},
		{
			"id": "parses",
			"type": "json_parses",
			"path": "pipelines/support-chat.pipe"
		},
		{
			"id": "static-valid",
			"type": "pipe_static_valid",
			"path": "pipelines/support-chat.pipe"
		},
		{
			"id": "engine-valid",
			"type": "validates",
			"path": "pipelines/support-chat.pipe"
		},
		{
			"id": "placeholders",
			"type": "secrets_are_placeholders",
			"path": "pipelines/support-chat.pipe"
		},
		{
			"id": "project-id",
			"type": "project_id_unchanged",
			"path": "pipelines/support-chat.pipe",
			"from": "pipelines/support-chat.pipe"
		},
		{
			"id": "one-file",
			"type": "glob_count",
			"glob": "pipelines/*.pipe",
			"n": 1
		},
		{
			"id": "anthropic",
			"type": "config_value",
			"path": "pipelines/support-chat.pipe",
			"provider": "llm_anthropic",
			"pointer": "profile",
			"equals": "claude-haiku-4-5"
		},
		{
			"id": "key",
			"type": "config_value",
			"path": "pipelines/support-chat.pipe",
			"provider": "llm_anthropic",
			"pointer": "{profile}/apikey",
			"equals": "${ROCKETRIDE_ANTHROPIC_KEY}"
		},
		{
			"id": "openai-gone",
			"type": "providers_absent",
			"path": "pipelines/support-chat.pipe",
			"providers": [
				"llm_openai"
			]
		},
		{
			"id": "still-works",
			"type": "reaches",
			"path": "pipelines/support-chat.pipe",
			"from": "chat",
			"to": "response*"
		},
		{
			"id": "runs",
			"type": "output",
			"path": "pipelines/support-chat.pipe",
			"send": {
				"chat": "Reply with the single word pong."
			},
			"expect": {
				"answers_match": "(?i)pong"
			}
		}
	],
	"judge": [],
	"hard_because": "The response node must be rewired to the new component id, and project_id must stay as it is. A model that writes a new file instead of editing (or renames the file) fails the file count."
}
