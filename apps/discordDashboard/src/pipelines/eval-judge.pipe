      "id": "prompt_1",
      "provider": "prompt",
      "name": "Judge Instructions",
      "config": {
        "instructions": [
          "You judge whether the support bot's REPLY adequately answers the question, given a known-good golden answer.",
          "You receive ONE JSON object: { \"question\", \"golden_answer\", \"reply\" }.",
          "Return STRICT JSON: { \"verdict\": \"pass\"|\"partial\"|\"fail\", \"notes\": string }.",
          "pass = the reply is correct and covers the golden answer's key points. partial = partially correct or missing key points. fail = wrong, missing, or off-topic.",
          "Judge on substance, not wording. Output ONLY the JSON object — no markdown fences, no commentary."
        ],
        "parameters": {},
        "name": "Judge Instructions"
      },
      "ui": {
        "position": {
          "x": 940,
          "y": 300
        },
        "nodeType": "default",
        "formDataValid": true
      },
      "input": [
        {
          "lane": "text",
          "from": "webhook_1"
        }
      ]
    },
