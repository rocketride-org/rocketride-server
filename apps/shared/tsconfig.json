{
	"compilerOptions": {
		"target": "es2022",
		"lib": [
			"dom",
			"dom.iterable",
			"esnext"
		],
		"allowJs": true,
		"skipLibCheck": true,
		"types": [],
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"paths": {
			"shell": [
				"../../.rocketride/shell/shell.d.ts"
			],
			"shared/*": [
				"./src/*"
			],
			"shell/client": [
				"../../.rocketride/shell/client.d.ts"
			]
		}
	},
	"include": [
		"**/*.ts",
		"**/*.tsx",
		"**/*.d.ts"
	],
	"exclude": [
		"node_modules",
		"**/*.test.ts",
		"**/*.test.tsx"
	]
}
