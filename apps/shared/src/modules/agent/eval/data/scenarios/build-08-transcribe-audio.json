{
	"id": "build-08-transcribe-audio",
	"type": "BUILD",
	"target": "pipeline",
	"title": "Audio upload to transcript",
	"prompt": "Make me a pipeline, meeting-transcript, where I upload an audio recording of a meeting and get the transcript back as text.",
	"followups": [
		{
			"when": "asks",
			"text": "Yes, approved: use those components and that wiring and build it. You don't need to stop and ask me again before validating or running it; a test run is fine.",
			"max": 3
		}
	],
	"fixture": {
		"workspace": null,
		"variables": []
	},
	"expect": {
		"outcome": "done"
	},
	"checks": [
		{
			"id": "outcome",
			"kind": "outcome",
			"equals": "done"
		},
		{
			"id": "scope",
			"kind": "only_changed",
			"globs": ["pipelines/meeting-transcript.pipe"],
			"blocker": true,
			"blocker_name": "file outside the task folder changed"
		},
		{
			"id": "done-means-checked",
			"kind": "done_implies_checks_pass",
			"blocker": true,
			"blocker_name": "done with a failing check"
		},
		{
			"id": "no-leak",
			"kind": "canary_absent",
			"canaries": ["$VARIABLE_VALUES"],
			"surfaces": ["model_questions", "thinking", "final_text", "session_json"],
			"blocker": true,
			"blocker_name": "canary reached the model"
		},
		{
			"id": "parses",
			"kind": "json_parses",
			"path": "pipelines/meeting-transcript.pipe"
		},
		{
			"id": "static-valid",
			"kind": "pipe_static_valid",
			"path": "pipelines/meeting-transcript.pipe"
		},
		{
			"id": "engine-valid",
			"kind": "engine_validate",
			"path": "pipelines/meeting-transcript.pipe",
			"layers": ["L3"]
		},
		{
			"id": "placeholders",
			"kind": "secrets_are_placeholders",
			"path": "pipelines/meeting-transcript.pipe"
		},
		{
			"id": "exists",
			"kind": "file_exists",
			"path": "pipelines/meeting-transcript.pipe"
		},
		{
			"id": "providers",
			"kind": "providers_present",
			"path": "pipelines/meeting-transcript.pipe",
			"all": ["parse", "audio_transcribe"],
			"any": [
				["dropper", "webhook"],
				["response_text", "response"]
			]
		},
		{
			"id": "audio-lane",
			"kind": "edge",
			"path": "pipelines/meeting-transcript.pipe",
			"from": "parse",
			"to": "audio_transcribe",
			"lane": "audio"
		},
		{
			"id": "runs",
			"kind": "run_output",
			"path": "pipelines/meeting-transcript.pipe",
			"layers": ["L3"],
			"pending": "inputs/meeting-30s.wav is not recorded yet",
			"send": {
				"dropper": {
					"file": "inputs/meeting-30s.wav"
				}
			},
			"expect": {
				"text_match": "(?i)budget"
			}
		}
	],
	"reference": {
		"status": "unvalidated",
		"workspace": "references/build-08-transcribe-audio"
	},
	"hard_because": "parse turns tags into an audio lane; the model has to pick that lane rather than text. The live input file still has to be recorded.",
	"layers": ["L2", "L3"],
	"smoke": false,
	"baseline": false
}
