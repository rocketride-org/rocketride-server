{
	"id": "build-11-app-daybook",
	"type": "BUILD",
	"target": "app",
	"title": "Journal app from the Blank template",
	"prompt": "Create an app called daybook (display name Daybook). It is a simple journal: a text box and an \"Add entry\" button, and below it the entries, newest first, each with the date and time it was added. It does not need to save entries between sessions.",
	"followups": [
		{
			"when": "asks",
			"text": "Yes, go ahead and build it.",
			"max": 2
		}
	],
	"fixture": {
		"workspace": null,
		"variables": []
	},
	"expect": {
		"outcome": "done"
	},
	"checks": [
		{
			"id": "outcome",
			"kind": "outcome",
			"equals": "done"
		},
		{
			"id": "scope",
			"kind": "only_changed",
			"globs": ["apps/daybook-ui/*"],
			"blocker": true,
			"blocker_name": "file outside the task folder changed"
		},
		{
			"id": "done-means-checked",
			"kind": "done_implies_checks_pass",
			"blocker": true,
			"blocker_name": "done with a failing check"
		},
		{
			"id": "no-leak",
			"kind": "canary_absent",
			"canaries": ["$VARIABLE_VALUES"],
			"surfaces": ["model_questions", "thinking", "final_text", "session_json"],
			"blocker": true,
			"blocker_name": "canary reached the model"
		},
		{
			"id": "created-with-tool",
			"kind": "tool_called",
			"tool": "create_app",
			"args_match": {
				"appName": "^daybook$"
			}
		},
		{
			"id": "folder",
			"kind": "file_exists",
			"path": "apps/daybook-ui/package.json"
		},
		{
			"id": "name",
			"kind": "json_value",
			"path": "apps/daybook-ui/package.json",
			"pointer": "appManifest/name",
			"equals": "Daybook"
		},
		{
			"id": "button",
			"kind": "file_matches",
			"path": "apps/daybook-ui/src/App.tsx",
			"regex": "Add entry"
		},
		{
			"id": "state",
			"kind": "file_matches",
			"path": "apps/daybook-ui/src/App.tsx",
			"regex": "useState"
		},
		{
			"id": "shell-only",
			"kind": "file_not_matches",
			"path": "apps/daybook-ui/src/App.tsx",
			"regex": "from '\\.\\./|from \"\\.\\./"
		},
		{
			"id": "check-app",
			"kind": "check_app_passes",
			"app": "apps/daybook-ui",
			"layers": ["browser"]
		}
	],
	"reference": {
		"status": "unvalidated",
		"workspace": "references/build-11-app-daybook"
	},
	"layers": ["browser"],
	"hard_because": "check_app needs Monaco markers and the Design preview, so this runs only in the browser runner (or an L2 host stub that runs tsc). The app must come from create_app, not hand-written files. The publisher prefix of the app id depends on the account, so the checks use the folder and the display name.",
	"smoke": false,
	"baseline": false
}
