{
	"id": "build-02-summarize-webhook",
	"type": "BUILD",
	"target": "pipeline",
	"title": "Webhook text summarizer on OpenAI",
	"prompt": "Make a pipeline named summarize-text. I post plain text to it over a webhook and get back a short summary, about 80 words. Use OpenAI for the model.",
	"followups": [
		{
			"when": "asks",
			"text": "Yes, approved: use those components and that wiring and build it. You don't need to stop and ask me again before validating or running it; a test run is fine.",
			"max": 3
		}
	],
	"fixture": {
		"workspace": null,
		"variables": ["ROCKETRIDE_OPENAI_KEY"]
	},
	"expect": {
		"outcome": "done"
	},
	"checks": [
		{
			"id": "outcome",
			"kind": "outcome",
			"equals": "done"
		},
		{
			"id": "scope",
			"kind": "only_changed",
			"globs": ["pipelines/summarize-text.pipe"],
			"blocker": true,
			"blocker_name": "file outside the task folder changed"
		},
		{
			"id": "done-means-checked",
			"kind": "done_implies_checks_pass",
			"blocker": true,
			"blocker_name": "done with a failing check"
		},
		{
			"id": "no-leak",
			"kind": "canary_absent",
			"canaries": ["$VARIABLE_VALUES"],
			"surfaces": ["model_questions", "thinking", "final_text", "session_json"],
			"blocker": true,
			"blocker_name": "canary reached the model"
		},
		{
			"id": "parses",
			"kind": "json_parses",
			"path": "pipelines/summarize-text.pipe"
		},
		{
			"id": "static-valid",
			"kind": "pipe_static_valid",
			"path": "pipelines/summarize-text.pipe"
		},
		{
			"id": "engine-valid",
			"kind": "engine_validate",
			"path": "pipelines/summarize-text.pipe",
			"layers": ["L3"]
		},
		{
			"id": "placeholders",
			"kind": "secrets_are_placeholders",
			"path": "pipelines/summarize-text.pipe"
		},
		{
			"id": "exists",
			"kind": "file_exists",
			"path": "pipelines/summarize-text.pipe"
		},
		{
			"id": "source",
			"kind": "providers_present",
			"path": "pipelines/summarize-text.pipe",
			"all": ["webhook", "llm_openai"],
			"any": [["response_text", "response_answers", "response"]]
		},
		{
			"id": "no-other-llm",
			"kind": "providers_absent",
			"path": "pipelines/summarize-text.pipe",
			"providers": ["llm_anthropic", "llm_gemini", "llm_mistral"]
		},
		{
			"id": "path",
			"kind": "reaches",
			"path": "pipelines/summarize-text.pipe",
			"from": "webhook",
			"to": "response*"
		},
		{
			"id": "runs",
			"kind": "run_output",
			"path": "pipelines/summarize-text.pipe",
			"layers": ["L3"],
			"send": {
				"webhook": {
					"file": "inputs/long-article.txt",
					"mimetype": "text/plain"
				}
			},
			"expect": {
				"nonempty": true,
				"shorter_than_input": true
			}
		}
	],
	"reference": {
		"status": "unvalidated",
		"workspace": "references/build-02-summarize-webhook"
	},
	"smoke": true,
	"baseline": true,
	"hard_because": "Two valid designs: summarization with an LLM on its control plane, or question/prompt into llm_openai. Checks accept both. The control-plane design puts \"control\" on the LLM pointing back at summarization, which models often get backwards.",
	"layers": ["L2", "L3"]
}
