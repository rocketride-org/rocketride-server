{
	"id": "build-13-app-ask-claude",
	"type": "BUILD",
	"target": "app",
	"title": "App with its own chat pipeline",
	"prompt": "Build an app called askclaude (display name Ask Claude): a text box and an Ask button. The question goes to Claude Sonnet 4.6 through a pipeline that ships inside the app, and the answer shows under the box. My Anthropic key is in Variables.",
	"followups": [
		{
			"when": "asks",
			"text": "Yes, go ahead.",
			"max": 2
		}
	],
	"fixture": {
		"workspace": null,
		"variables": ["ROCKETRIDE_ANTHROPIC_KEY"]
	},
	"expect": {
		"outcome": "done"
	},
	"checks": [
		{
			"id": "outcome",
			"kind": "outcome",
			"equals": "done"
		},
		{
			"id": "scope",
			"kind": "only_changed",
			"globs": ["apps/askclaude-ui/*"],
			"blocker": true,
			"blocker_name": "file outside the task folder changed"
		},
		{
			"id": "done-means-checked",
			"kind": "done_implies_checks_pass",
			"blocker": true,
			"blocker_name": "done with a failing check"
		},
		{
			"id": "no-leak",
			"kind": "canary_absent",
			"canaries": ["$VARIABLE_VALUES"],
			"surfaces": ["model_questions", "thinking", "final_text", "session_json"],
			"blocker": true,
			"blocker_name": "canary reached the model"
		},
		{
			"id": "created-with-tool",
			"kind": "tool_called",
			"tool": "create_app",
			"args_match": {
				"appName": "^askclaude$"
			}
		},
		{
			"id": "pipe-in-app",
			"kind": "glob_count",
			"glob": "apps/askclaude-ui/src/*.pipe",
			"n": 1
		},
		{
			"id": "pipe-imported",
			"kind": "file_matches",
			"path": "apps/askclaude-ui/src/App.tsx",
			"regex": "import \\w+ from '\\./[\\w-]+\\.pipe'"
		},
		{
			"id": "uses-client",
			"kind": "file_matches",
			"path": "apps/askclaude-ui/src/App.tsx",
			"regex": "useShellConnection"
		},
		{
			"id": "use-pipeline-object",
			"kind": "file_matches",
			"path": "apps/askclaude-ui/src/App.tsx",
			"regex": "use\\(\\{\\s*pipeline"
		},
		{
			"id": "no-filepath",
			"kind": "file_not_matches",
			"path": "apps/askclaude-ui/src/App.tsx",
			"regex": "filepath"
		},
		{
			"id": "chat-call",
			"kind": "file_matches",
			"path": "apps/askclaude-ui/src/App.tsx",
			"regex": "\\.chat\\("
		},
		{
			"id": "pipe-placeholder",
			"kind": "secrets_are_placeholders"
		},
		{
			"id": "check-app",
			"kind": "check_app_passes",
			"app": "apps/askclaude-ui",
			"layers": ["browser"]
		}
	],
	"reference": {
		"status": "unvalidated",
		"workspace": "references/build-13-app-ask-claude",
		"note": "template files rendered with the Python scaffold (create_app renders the same set); src/App.tsx and src/ask.pipe are the solution"
	},
	"layers": ["browser"],
	"hard_because": "Crosses both halves: the app must import the .pipe as an object and pass pipeline:, never filepath:; keep the token from use() instead of starting the pipeline per question; and build a Question for chat(). The checks are regexes over the source, so the browser run is what proves it.",
	"smoke": false,
	"baseline": false
}
