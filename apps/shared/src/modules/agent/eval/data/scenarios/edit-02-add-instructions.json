{
	"id": "edit-02-add-instructions",
	"type": "EDIT",
	"target": "pipeline",
	"title": "Add answer-style instructions",
	"prompt": "Make support-chat answer in at most two sentences, always in a friendly tone.",
	"followups": [
		{
			"when": "asks",
			"text": "Yes, go ahead.",
			"max": 2
		}
	],
	"fixture": {
		"workspace": "fixtures/support-chat-anthropic",
		"variables": ["ROCKETRIDE_ANTHROPIC_KEY"]
	},
	"expect": {
		"outcome": "done"
	},
	"checks": [
		{
			"id": "outcome",
			"kind": "outcome",
			"equals": "done"
		},
		{
			"id": "scope",
			"kind": "only_changed",
			"globs": ["pipelines/support-chat.pipe"],
			"blocker": true,
			"blocker_name": "file outside the task folder changed"
		},
		{
			"id": "done-means-checked",
			"kind": "done_implies_checks_pass",
			"blocker": true,
			"blocker_name": "done with a failing check"
		},
		{
			"id": "no-leak",
			"kind": "canary_absent",
			"canaries": ["$VARIABLE_VALUES"],
			"surfaces": ["model_questions", "thinking", "final_text", "session_json"],
			"blocker": true,
			"blocker_name": "canary reached the model"
		},
		{
			"id": "parses",
			"kind": "json_parses",
			"path": "pipelines/support-chat.pipe"
		},
		{
			"id": "static-valid",
			"kind": "pipe_static_valid",
			"path": "pipelines/support-chat.pipe"
		},
		{
			"id": "engine-valid",
			"kind": "engine_validate",
			"path": "pipelines/support-chat.pipe",
			"layers": ["L3"]
		},
		{
			"id": "placeholders",
			"kind": "secrets_are_placeholders",
			"path": "pipelines/support-chat.pipe"
		},
		{
			"id": "project-id",
			"kind": "project_id_unchanged",
			"path": "pipelines/support-chat.pipe",
			"from": "pipelines/support-chat.pipe"
		},
		{
			"id": "instruction",
			"kind": "any_config_matches",
			"path": "pipelines/support-chat.pipe",
			"matches": "two sentences|2 sentences"
		},
		{
			"id": "model-unchanged",
			"kind": "config_value",
			"path": "pipelines/support-chat.pipe",
			"provider": "llm_anthropic",
			"pointer": "profile",
			"equals": "claude-sonnet-4-6"
		},
		{
			"id": "still-works",
			"kind": "reaches",
			"path": "pipelines/support-chat.pipe",
			"from": "chat",
			"to": "response*"
		},
		{
			"id": "runs",
			"kind": "run_output",
			"path": "pipelines/support-chat.pipe",
			"layers": ["L3"],
			"send": {
				"chat": "Explain what a webhook is."
			},
			"expect": {
				"answers_max_sentences": 3
			}
		}
	],
	"reference": {
		"status": "unvalidated",
		"workspace": "references/edit-02-add-instructions"
	},
	"hard_because": "There is no system-prompt field on the LLM node; the instruction needs a new prompt node and a rewire. \"Old behavior still works\" is the chat-to-response path and the unchanged model.",
	"layers": ["L2", "L3"],
	"smoke": false,
	"baseline": false
}
