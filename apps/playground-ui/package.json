{
	"name": "@rocketride/playground-ui",
	"version": "1.0.0",
	"private": true,
	"description": "RocketRide Playground — one front end for every agent: ask it questions, drop files on it, see what comes back",
	"license": "MIT",
	"appManifest": {
		"id": "playground",
		"projectId": "55f5a517-a1df-4636-bec4-f7786717eb28",
		"name": "Playground",
		"description": "Talk to any agent: ask it questions, drop files on it, and keep every conversation",
		"icon": "./src/icon.svg",
		"readme": "./README.md",
		"categories": [
			"tools",
			"devTool"
		],
		"mode": "free",
		"authenticated": true,
		"showStatusBar": true
	},
	"scripts": {
		"build": "rsbuild build",
		"build:prod": "rsbuild build --env-mode production",
		"dev": "rsbuild dev",
		"typecheck": "tsc --noEmit"
	},
	"browserslist": [
		"chrome >= 81",
		"edge >= 83",
		"firefox >= 76",
		"safari >= 13"
	],
	"dependencies": {
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"rocketride": "workspace:*",
		"shell": "file:../../.rocketride/shell/shell.tgz"
	},
	"devDependencies": {
		"@module-federation/rsbuild-plugin": "^2.5.1",
		"@rsbuild/core": "~2.2.12",
		"@rsbuild/plugin-react": "~2.0.1",
		"@types/react": "~18.3.31",
		"@types/react-dom": "~18.3.7",
		"tsx": "~4.23.1",
		"typescript": "^5.3.0"
	}
}
