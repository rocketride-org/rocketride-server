{
	"name": "@rocketride/graph-ui",
	"version": "1.2.0",
	"private": true,
	"description": "Graph database workbench over pipeline graph tool nodes",
	"license": "MIT",
	"appManifest": {
		"id": "rocketride.graph",
		"projectId": "c9af6cbd-6b02-47fd-923c-ea7a44256a19",
		"publisher": "Aparavi Software AG",
		"name": "Graph Explorer",
		"description": "Browse and query Apache AGE, Neo4j and FalkorDB graphs through pipeline graph nodes",
		"icon": "./src/icon.svg",
		"readme": "./README.md",
		"categories": [
			"tools",
			"devTool"
		],
		"mode": "free",
		"authenticated": true,
		"showStatusBar": true,
		"include": [
			"apps/shared"
		]
	},
	"scripts": {
		"build": "rsbuild build",
		"build:prod": "rsbuild build --env-mode production",
		"dev": "rsbuild dev",
		"typecheck": "tsc --noEmit",
		"typecheck:tests": "tsc -p tsconfig.test.json --noEmit"
	},
	"browserslist": [
		"chrome >= 81",
		"edge >= 83",
		"firefox >= 76",
		"safari >= 13"
	],
	"dependencies": {
		"@module-federation/rsbuild-plugin": "^2.5.1",
		"@xyflow/react": "~12.3.4",
		"d3-force": "~3.0.0",
		"monaco-editor": "^0.55.1",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"rocketride": "workspace:*",
		"shell": "file:../../.rocketride/shell/shell.tgz"
	},
	"devDependencies": {
		"@rsbuild/core": "~2.2.12",
		"@rsbuild/plugin-react": "~2.0.1",
		"@types/d3-force": "~3.0.10",
		"@types/react": "~18.3.31",
		"@types/react-dom": "~18.3.7",
		"tsx": "~4.23.1",
		"typescript": "^5.3.0"
	}
}
