{
	"compilerOptions": {
		"target": "ES2020",
		"lib": ["ES2020"],
		"module": "CommonJS",
		"moduleResolution": "node",
		"outDir": "dist",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true
	},
	"include": ["./src/**/*", "./eval/src/**/*", "./eval/run.ts"],
	"exclude": ["node_modules", "dist", "tests"]
}
