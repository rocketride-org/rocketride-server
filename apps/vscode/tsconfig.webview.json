{
	"compilerOptions": {
		"target": "ES2022",
		"lib": [
			"ES2022",
			"DOM",
			"DOM.Iterable"
		],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"allowSyntheticDefaultImports": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"paths": {
			"shared": [
				"../shared/src/index.ts"
			],
			"shared/*": [
				"../shared/src/*"
			],
			"shell": [
				"../../.rocketride/shell/shell.d.ts"
			],
			"shell/client": [
				"../../.rocketride/shell/client.d.ts"
			],
			"shell/themes/rocketride-default.css": [
				"../../.rocketride/shell/dist/themes/rocketride-default.css"
			]
		}
	},
	"include": [
		"src/providers/views/**/*.ts",
		"src/providers/views/**/*.tsx",
		"src/providers/components/**/*.ts",
		"src/providers/components/**/*.tsx",
		"src/shared/**/*.ts",
		"src/assets/**/*.d.ts"
	]
}
