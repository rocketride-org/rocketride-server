{
	"compilerOptions": {
		"module": "Node16",
		"target": "ES2022",
		"outDir": "../../build/vscode/out",
		"lib": [
			"ES2022"
		],
		"sourceMap": true,
		"rootDir": "../..",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"moduleResolution": "Node16",
		"allowSyntheticDefaultImports": true,
		"paths": {
			"shared/*": [
				"../shared/src/*"
			],
			"shell/src/*": [
				"../../packages/shell/src/*"
			]
		}
	},
	"include": [
		"src/**/*.ts"
	],
	"exclude": [
		"src/**/*.tsx",
		"src/providers/views/**",
		"src/shared/util/mount.ts"
	]
}
