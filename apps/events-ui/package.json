{
	"name": "@rocketride/events-ui",
	"version": "1.0.0",
	"private": true,
	"description": "Real-time DAP event monitor for RocketRide",
	"license": "MIT",
	"appManifest": {
		"id": "rocketride.events",
		"projectId": "a3515d9f-c356-41dc-9862-34eb4d92ea2d",
		"publisher": "Aparavi Software AG",
		"name": "Event Monitor",
		"description": "Real-time event stream viewer with JSON inspection and export",
		"icon": "./src/icon.svg",
		"categories": [
			"tools"
		],
		"mode": "subscription",
		"authenticated": true,
		"showStatusBar": true,
		"billing": {
			"plans": [
				{
					"nickname": "Free",
					"amountCents": 0,
					"currency": "usd",
					"interval": "month"
				},
				{
					"nickname": "Builder",
					"amountCents": 15000,
					"currency": "usd",
					"interval": "month"
				}
			]
		}
	},
	"scripts": {
		"build": "rsbuild build",
		"build:prod": "rsbuild build --env-mode production",
		"dev": "rsbuild dev",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@module-federation/rsbuild-plugin": "^2.5.1",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"rocketride": "workspace:*",
		"shell": "file:../../.rocketride/shell/shell.tgz"
	},
	"devDependencies": {
		"@rsbuild/core": "~2.0.11",
		"@rsbuild/plugin-react": "~2.0.1",
		"typescript": "^5.3.0",
		"@types/react": "~18.3.31",
		"@types/react-dom": "~18.3.7",
		"@types/tabulator-tables": "~6.2.0"
	}
}
